---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const ctaCHF = 'https://buy.stripe.com/cNidR9cKu7Rt3ak2wV7bW03';
const ctaEUR = 'https://buy.stripe.com/fZu6oH4dY8VxbGQ8Vj7bW04';

const themes = [
  {
    month: 'Juillet',
    date: 'Jeudi 30 juillet',
    title: 'Les femmes et la vie professionnelle',
    subtitle: 'Choisir, construire, quitter, recommencer — avec ce que nos mères et grands-mères ont vécu ou n\'ont pas pu vivre.',
    text: 'Le travail est un terrain où se rejouent des histoires anciennes : des femmes qui n\'ont pas choisi leur métier, qui ont dû arrêter, qui n\'ont pas eu le droit d\'exister professionnellement. Comment bâtir le sien sans porter leur manque ?',
  },
  {
    month: 'Août',
    date: 'Jeudi 27 août',
    title: 'Les femmes et le corps',
    subtitle: 'S\'approprier son corps, sa santé, son plaisir, son image — malgré ce que les femmes avant nous en ont vécu.',
    text: 'Le corps des femmes a été contrôlé, jugé, utilisé, caché, abîmé. Explorer ce qui s\'est transmis autour du corps dans nos lignées pour retrouver une relation plus libre avec le sien : santé, plaisir, apparence, vieillissement, maternité ou non.',
  },
  {
    month: 'Septembre',
    date: 'Jeudi 24 septembre',
    title: 'Les femmes et l\'argent',
    subtitle: 'Gagner, recevoir, posséder — et la culpabilité de vouloir plus que les femmes d\'avant.',
    text: 'L\'argent est chargé de loyauté : réussir quand d\'autres avant nous ont manqué, ont dû dépendre, ont été privées. Travailler la permission d\'avoir, de recevoir, de posséder sans trahir.',
  },
  {
    month: 'Octobre',
    date: 'Mercredi 14 octobre',
    title: 'Le parent absent',
    subtitle: 'Porter une responsabilité plus lourde que la sienne — sans que ce soit forcément son propre parent.',
    text: 'Un parent absent dans les lignées, un vide, une histoire trop lourde qui a fait qu\'une enfant a dû prendre la place d\'un adulte. Pas forcément son parent à soi : parfois un parent du système familial qui n\'a pas pu être là, et dont l\'absence continue de peser sur les épaules de quelqu\'un.',
  },
  {
    month: 'Novembre',
    date: 'Jeudi 26 novembre',
    title: 'Les femmes et la liberté d\'expression',
    subtitle: 'Des femmes qui n\'ont pas eu le droit de s\'exprimer — et la peur de prendre la parole aujourd\'hui.',
    text: 'L\'oppression, c\'est quand une femme apprend qu\'elle doit se taire, ne pas déranger, ne pas prendre trop de place. Explorer comment cette mémoire s\'exprime encore dans la peur de dire non, de s\'affirmer, d\'exister vraiment dans ce qu\'elle pense et ce qu\'elle ressent.',
  },
  {
    month: 'Décembre',
    date: 'Jeudi 17 décembre',
    title: 'Séparation et divorce (avec des enfants)',
    subtitle: 'Trouver l\'harmonie dans une nouvelle configuration familiale.',
    text: 'Quand l\'histoire familiale se rejoue dans la séparation : les loyautés divisées, la place de chacun, les blessures des enfants, les conflits de loyauté. Comment choisir pour soi et ses enfants sans reproduire les schémas anciens.',
  },
];

const details = [
  'Constellation collective sur Zoom, avec le support de l\'eau.',
  'Durée : 1h30 maximum.',
  'Participation : 25 CHF par atelier.',
  'Pas de replay : l\'espace se vit en direct.',
  'Tu peux participer avec ou sans caméra, selon ton confort.',
  'Tu n\'as pas besoin d\'exposer ton histoire personnelle devant le groupe.',
  'Les ateliers ont lieu de 19h à 20h30 (heure suisse).',
];
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Les Lignées de pouvoir — Constellations sur l'eau</title>
    <meta
      name="description"
      content="Des constellations collectives sur l'eau autour des thématiques des femmes de nos lignées : ce qu'elles ont vécu et qui s'exprime encore dans nos vies, les loyautés qui limitent et les cadeaux à recevoir. 25 CHF par atelier, sans replay."
    />
    <link rel="canonical" href="https://latelierdelucette.com/constellations-sur-leau/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="L'Atelier de Lucette" />
    <meta property="og:title" content="Les Lignées de pouvoir — Constellations sur l'eau" />
    <meta property="og:description" content="Retrouver sa place dans sa vie avec des constellations sur les thématiques des femmes de nos lignées." />
    <meta property="og:url" content="https://latelierdelucette.com/constellations-sur-leau/" />
    <meta property="og:image" content="https://latelierdelucette.com/images/constellations-stripe-cover.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Les Lignées de pouvoir — Constellations sur l'eau" />
    <meta name="twitter:description" content="Des ateliers collectifs pour explorer ce que les femmes avant nous ont vécu et qui s'exprime encore dans nos vies." />
    <meta name="twitter:image" content="https://latelierdelucette.com/images/constellations-stripe-cover.jpg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "EventSeries",
        "name": "Les Lignées de pouvoir",
        "description": "Ateliers collectifs thématiques pour explorer ce que les femmes avant nous ont vécu et qui s'exprime encore dans nos vies : les loyautés, les fardeaux, les cadeaux et la puissance disponible.",
        "organizer": {
          "@type": "Person",
          "name": "Caroline Verdier",
          "url": "https://latelierdelucette.com/qui-suis-je/"
        },
        "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
        "url": "https://latelierdelucette.com/constellations-sur-leau/",
        "offers": {
          "@type": "Offer",
          "price": "25",
          "priceCurrency": "CHF",
          "availability": "https://schema.org/InStock"
        }
      }
    </script>
  </head>

  <body class="selection:bg-[#CC3DAA] selection:text-[#F7F4EE] overflow-x-hidden bg-[#F7F4EE] text-[#1E3A8A]">
    <div class="bg-grain fixed inset-0 pointer-events-none z-0"></div>
    <div class="arch-lines">
      <svg width="100%" height="100%" viewBox="0 0 1440 900" preserveAspectRatio="none">
        <line x1="8%" y1="0" x2="8%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="92%" y1="0" x2="92%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="0" y1="760" x2="1440" y2="220" stroke="#2AACCB" stroke-width="0.5" opacity="0.55" />
      </svg>
    </div>

    <Nav current="/constellations-sur-leau/" ctaHref="#inscription" ctaLabel="Participer" />

    <main class="relative z-10">
      <header class="min-h-[88vh] flex items-center px-6 pt-32 pb-20">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.05fr_0.95fr] gap-14 items-center">
          <div>
            <div class="inline-flex items-center gap-4 mb-8">
              <div class="h-px w-10 bg-[#2AACCB]"></div>
              <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#1E3A8A]/70">Les Lignées de pouvoir</span>
            </div>

            <h1 class="text-5xl md:text-7xl leading-[0.98] font-normal tracking-tight mb-8">
              Retrouver sa place<br />
              <span class="italic text-[#CC3DAA]">dans sa vie</span>
            </h1>

            <p class="text-xl md:text-2xl text-[#1E3A8A]/75 leading-relaxed mb-10 max-w-3xl">
              Des ateliers collectifs de constellations sur l'eau, inspirés par la carte Les Lignées de pouvoir de mon <a href="/oracle-dunerivealautre/" class="text-[#CC3DAA] underline decoration-[#CC3DAA]/35 underline-offset-4 hover:text-[#D4845A] transition-colors">oracle D'une Rive à l'Autre</a>. On y explore les thématiques des femmes de nos lignées : ce qu'elles ont vécu et qui s'exprime encore dans nos vies, les loyautés qui limitent, mais aussi les forces, les élans et les cadeaux qui peuvent nous soutenir.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 mb-8">
              <a href="#inscription" class="inline-flex items-center justify-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
                <iconify-icon icon="solar:waterdrops-linear" width="17" height="17"></iconify-icon>
                Participer à 25 CHF
              </a>
              <a href="#themes" class="inline-flex items-center justify-center gap-3 px-10 py-5 border border-[#1E3A8A]/25 text-[#1E3A8A] text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/5 transition-all rounded-sm">
                Voir les thèmes
              </a>
            </div>

            <p class="ui-text text-xs tracking-[0.14em] uppercase text-[#1E3A8A]/55">
              1h30 max · en ligne · sans replay · 25 CHF
            </p>
          </div>

          <aside class="bg-[#FFFCF6]/85 border border-[#1E3A8A]/10 shadow-2xl shadow-[#1E3A8A]/10 p-8 md:p-10 rounded-sm relative overflow-hidden">
            <div class="absolute -top-16 -right-16 h-44 w-44 rounded-full bg-[#2AACCB]/20 blur-2xl"></div>
            <div class="absolute -bottom-16 -left-16 h-44 w-44 rounded-full bg-[#CC3DAA]/15 blur-2xl"></div>
            <div class="relative z-10">
              <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Premier thème</p>
              <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-2">
                Les femmes et la vie professionnelle
              </h2>
              <p class="text-xl italic text-[#1E3A8A]/60 mb-6">Choisir, construire, quitter, recommencer.</p>
              <p class="text-xl leading-relaxed text-[#1E3A8A]/75 mb-8">
                Le travail est un terrain où se rejouent des histoires anciennes : des femmes qui n'ont pas choisi leur métier, qui ont dû arrêter, qui n'ont pas eu le droit d'exister professionnellement.
              </p>
              <div class="border-t border-[#1E3A8A]/10 pt-6 space-y-3 text-lg text-[#1E3A8A]/75">
                <p><strong class="text-[#1E3A8A]">Prochaine date :</strong> Jeudi 30 juillet · 19h-20h30</p>
              </div>
            </div>
          </aside>
        </div>
      </header>

      <section class="px-6 py-24 bg-[#1E3A8A] text-[#F7F4EE]">
        <div class="max-w-5xl mx-auto grid md:grid-cols-[0.9fr_1.1fr] gap-12 items-center">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#C9A96E] mb-6">Pourquoi ces ateliers</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">Chaque femme porte des histoires qui ne sont pas seulement les siennes.</h2>
          </div>
          <div class="text-xl leading-relaxed text-[#F7F4EE]/85 space-y-6">
            <p>Il y a des femmes qui ont dû se taire. Des femmes qui ont dû tenir. Des femmes qui n'ont pas eu le droit de choisir leur vie, leur argent, leur métier, leur corps, leur rythme ou leur désir.</p>
            <p>Par amour, par loyauté ou par survie, nous pouvons continuer à porter des rôles anciens : la petite fille responsable, la femme indispensable, la bonne élève, celle qui ne demande pas trop, celle qui réussit mais culpabilise.</p>
            <p>Mais le passé n'est pas seulement fait de souffrance. Il contient aussi des ressources : du courage, de la créativité, de l'instinct, de la foi, de la ténacité, une puissance de vie qui peut enfin circuler autrement.</p>
            <p class="text-2xl italic text-[#C9A96E]">Libérer, ce n'est pas rejeter ce qui vient avant nous. C'est déposer ce qui pèse, et recevoir les cadeaux qui étaient restés coincés avec l'histoire.</p>
          </div>
        </div>
      </section>

      <section class="px-6 py-24 bg-[#F7F4EE]">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.85fr_1.15fr] gap-14 items-center">
          <div class="relative max-w-sm mx-auto lg:mx-0">
            <div class="absolute -inset-5 rounded-full bg-[#2AACCB]/20 blur-2xl"></div>
            <img
              src="/images/cards/lignees-de-pouvoir.jpg"
              alt="Carte oracle Les Lignées de pouvoir"
              class="relative z-10 w-full rounded-sm shadow-2xl shadow-[#1E3A8A]/20 border border-[#1E3A8A]/10"
              loading="lazy"
            />
          </div>

          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">La carte source</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Les Lignées de pouvoir</h2>
            <div class="text-xl leading-relaxed text-[#1E3A8A]/75 space-y-6">
              <p>Dans mon <a href="/oracle-dunerivealautre/" class="text-[#CC3DAA] underline decoration-[#CC3DAA]/35 underline-offset-4 hover:text-[#D4845A] transition-colors">oracle <em>D'une Rive à l'Autre</em></a>, cette carte parle d'eau, d'émotion et de mémoire. Au centre, il y a un bassin dans lequel coule une source d'eau millénaire.</p>
              <p>L'eau porte les mémoires du passé et les messages qu'il est nécessaire d'écouter. Lorsqu'elle stagne, elle se trouble. Lorsqu'elle circule, elle retrouve sa pureté.</p>
              <p>C'est exactement l'intention de ces ateliers : remettre du mouvement là où quelque chose s'est cristallisé, non pas pour couper le lien, mais pour l'apaiser.</p>
              <p class="text-2xl italic text-[#CC3DAA]">Plonger dans les mémoires pour y retrouver la clé, la magie, l'inspiration et le pouvoir qui peuvent à nouveau circuler dans nos vies.</p>
            </div>
          </div>
        </div>
      </section>

      <section id="themes" class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Les thèmes proposés</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">Une traversée de la liberté féminine</h2>
              <p class="text-xl text-[#1E3A8A]/70 max-w-3xl mx-auto leading-relaxed">
              Des sujets concrets de la vie de femme : le travail, le corps, l'argent, la parole, la séparation, le parent absent. Chaque atelier part d'une réalité que tu connais, et descend vers ce qui se joue en dessous, dans les histoires des femmes de nos lignées.
            </p>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {themes.map((theme) => (
              <article class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-7 flex flex-col min-h-[330px]">
                <p class="ui-text text-xs tracking-[0.2em] uppercase text-[#CC3DAA] mb-1">{theme.month}</p>
                {theme.date && <p class="ui-text text-[0.65rem] tracking-[0.16em] uppercase text-[#2AACCB]/70 mb-5">{theme.date}</p>}
                {!theme.date && <p class="ui-text text-[0.65rem] tracking-[0.16em] uppercase text-[#1E3A8A]/35 mb-5 italic">Date à venir</p>}
                <h3 class="text-3xl leading-tight font-normal mb-4">{theme.title}</h3>
                <p class="text-lg italic text-[#D4845A] leading-snug mb-5">{theme.subtitle}</p>
                <p class="text-lg leading-relaxed text-[#1E3A8A]/72 mt-auto">{theme.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="px-6 py-24 bg-[#F7F4EE]">
        <div class="max-w-5xl mx-auto grid lg:grid-cols-2 gap-12 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Pour toi si</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Tu veux être libre sans devoir couper le lien.</h2>
            <div class="space-y-5 text-xl leading-relaxed text-[#1E3A8A]/75">
              <p>Ces ateliers sont pour toi si tu sens que certaines limites ne sont pas seulement personnelles, mais aussi familiales, culturelles ou liées à ce que les femmes avant toi ont vécu.</p>
              <p>Si tu veux réussir sans te durcir. Recevoir sans culpabiliser. Choisir sans abandonner. Travailler sans prouver. Aimer sans disparaître.</p>
              <p>Pour moi, le lien ne peut pas être coupé : le lien à la famille, à l'amour, aux ancêtres et au système reste là. Il peut être vécu comme un fardeau, ou devenir un lieu de soutien.</p>
              <p>Le travail consiste à apaiser ce lien pour que l'amour circule autrement entre les personnes d'une même famille ou d'un même système.</p>
              <p>Et si tu as envie d'un espace sensible, concret, symbolique, où l'invisible peut enfin prendre forme.</p>
            </div>
          </div>

          <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
            <h3 class="text-3xl font-normal mb-7">Ce que tu peux venir déposer</h3>
            <div class="space-y-4">
              {[
                "la sensation d'être celle qui doit toujours penser à tout",
                "la peur de gagner plus, réussir plus ou devenir plus visible",
                "la culpabilité de choisir une vie différente de celle des femmes avant toi",
                "le rôle de soutien, médiatrice, pilier ou bonne élève",
                "la difficulté à recevoir de l'aide, de l'argent, du repos ou de la reconnaissance",
                "l'impression de devoir choisir entre liberté et appartenance",
              ].map((item) => (
                <div class="flex gap-4 items-start border-b border-[#1E3A8A]/10 pb-4 last:border-b-0 last:pb-0">
                  <span class="text-[#CC3DAA] text-2xl leading-none">✦</span>
                  <p class="text-lg leading-relaxed text-[#1E3A8A]/75">{item}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Déroulé</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">Comment se passe une séance ?</h2>
          </div>

          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            <div class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-8">
              <span class="ui-text text-xs tracking-[0.2em] uppercase text-[#CC3DAA] block mb-5">01</span>
              <h3 class="text-2xl font-normal mb-4">Un thème commun</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Nous partons d'un sujet qui concerne le groupe, pas d'une histoire individuelle exposée en détail.</p>
            </div>
            <div class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-8">
              <span class="ui-text text-xs tracking-[0.2em] uppercase text-[#2AACCB] block mb-5">02</span>
              <h3 class="text-2xl font-normal mb-4">Une constellation sur l'eau</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Les éléments du système sont représentés par des objets sur l'eau. Le mouvement révèle les places, les tensions et les liens.</p>
            </div>
            <div class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-8">
              <span class="ui-text text-xs tracking-[0.2em] uppercase text-[#C9A96E] block mb-5">03</span>
              <h3 class="text-2xl font-normal mb-4">Représenter ou observer</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Chacune choisit sa place : être représentante si elle le souhaite, ou observer en restant pleinement reliée au travail du groupe.</p>
            </div>
            <div class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-8">
              <span class="ui-text text-xs tracking-[0.2em] uppercase text-[#D4845A] block mb-5">04</span>
              <h3 class="text-2xl font-normal mb-4">Un espace de libération</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Les phrases de libération peuvent être prononcées par toutes, pour permettre à chacune de laisser bouger ce qui a besoin de se libérer pour elle.</p>
            </div>
            <div class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-8 md:col-span-2 lg:col-span-4">
              <span class="ui-text text-xs tracking-[0.2em] uppercase text-[#C9A96E] block mb-5">Confidentialité</span>
              <h3 class="text-2xl font-normal mb-4">Un espace discret</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Tu peux participer sans dévoiler ton histoire personnelle. Ce qui se travaille dans le champ peut résonner pour chacune.</p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {details.map((detail) => (
              <div class="bg-[#F7F4EE] border border-[#1E3A8A]/10 px-5 py-4 rounded-sm">
                <p class="text-lg text-[#1E3A8A]/78">{detail}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="inscription" class="py-28 px-6 bg-[#CC3DAA] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-10"></div>
        <div class="relative z-10 max-w-4xl mx-auto text-center text-white">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-white/75 mb-6">Participation</p>
          <h2 class="text-4xl md:text-6xl font-serif mb-8 leading-[1.05] tracking-tight">
            25 CHF par atelier.<br />
            <span class="italic">Pas de replay.</span>
          </h2>
          <p class="text-xl text-white/88 max-w-2xl mx-auto mb-10 leading-relaxed">
            Le replay n'est pas proposé volontairement : ces ateliers sont pensés comme des espaces vivants, confidentiels et présents. Tu viens pour participer à un champ, pas pour consommer un contenu plus tard.
          </p>

          <div class="bg-white/10 border border-white/20 rounded-sm p-6 md:p-8 mb-10 max-w-2xl mx-auto">
            <p class="text-2xl font-serif italic mb-3">Prochain thème</p>
