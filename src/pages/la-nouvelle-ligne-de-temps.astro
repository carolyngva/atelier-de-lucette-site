---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const ctaHref = 'https://buy.stripe.com/bJe14n7qafjVbGQ0oN7bW06';

const symptomes = [
  "Tu as déjà fait du chemin sur toi, tu comprends beaucoup de choses, et pourtant ta tête reste saturée.",
  "Tu as du temps pour toi, mais tu n'arrives pas toujours à en profiter vraiment.",
  "Tu prends des pauses, tu as peut-être des routines, mais ton cerveau continue de tourner en arrière-plan.",
  "Tu as l'impression que certaines choses prennent beaucoup trop de place dans ta tête, ton agenda ou ta vie.",
  "Tu vois le temps passer et tu sens que ce qui compte pour toi reste encore repoussé.",
  "Tu as déjà essayé des agendas, listes, carnets ou routines, sans sentir que ça déposait vraiment la charge.",
];

const vraieVie = [
  "Une nouvelle demande arrive et tu sais où la poser avant qu'elle prenne toute la place dans ta tête.",
  "Une semaine déborde et tu sais comment revenir au tri, sans devoir tout reprendre depuis zéro.",
  "Un projet te revient en mémoire et tu le retrouves sans fouiller dans dix carnets, applis ou listes.",
  "Un temps pour toi arrive et tu n'as plus besoin de surveiller tout le reste en arrière-plan.",
];

const possibles = [
  {
    image: '/images/orga-chaos.jpg',
    title: 'Avant',
    text: "Tout est là, quelque part, mais trop de choses vivent encore dans ta tête.",
  },
  {
    image: '/images/retraite-yoga.jpg',
    title: "Ce qui t'appelle peut-être",
    text: "Une retraite, un week-end, une pratique, un espace pour toi... sans avoir l'impression que tout va s'écrouler pendant ton absence.",
  },
  {
    image: '/images/girlboss-focus.jpg',
    title: 'Ce qui redevient possible',
    text: "Te poser sur ce qui compte vraiment pour toi, avec assez de clarté pour avancer sans tout garder ouvert en arrière-plan.",
  },
];

const couches = [
  {
    title: 'Vider la tête',
    text: "Les rappels, rendez-vous, idées, tâches, projets et choses à ne pas oublier qui restent actifs dans ta tête faute d'un endroit fiable où attendre, jusqu'au bon moment.",
  },
  {
    title: 'Trier ce qui prend trop de place',
    text: "Ce qui est urgent, ce qui peut attendre, ce qui t'appartient vraiment, ce qui appartient à quelqu'un d'autre, ce qui prend beaucoup plus de place qu'il ne devrait. Le tri doit partir de là où tu en es dans ta vie, pas d'une semaine idéale.",
  },
  {
    title: "Rendre ce qui n'est pas à toi",
    text: "Les poids pris par loyauté, par habitude, par héritage familial ou parce que tu as longtemps été celle qui pense à tout pour tout le monde.",
  },
  {
    title: 'Créer ta nouvelle ligne de temps',
    text: "Une façon simple, sensible et praticable de déposer ce qui tourne, de retrouver ce qui compte, et de revenir à ta place même quand la semaine change.",
  },
];

const croyances = [
  {
    depart: "Le problème, c'est moi. Je suis trop dispersée, je n'arrive jamais à tenir ce que je mets en place.",
    arrivee: "Et si tu n'étais pas désorganisée, mais simplement en train d'essayer de tenir avec des cadres trop rigides ou pas faits pour ta vraie vie ?",
  },
  {
    depart: "Si je ne pense pas à tout, quelque chose va forcément s'écrouler.",
    arrivee: "Ce que tu portes peut exister hors de ta tête, dans un endroit fiable où tu peux y revenir.",
  },
  {
    depart: "Je n'ai déjà pas le temps. Je ne peux pas ajouter un accompagnement de plus.",
    arrivee: "Déposer ce que tu portes dans un cadre clair peut te rendre de l'espace au lieu de t'en prendre.",
  },
  {
    depart: "Même quand j'ai du temps pour moi, ça ne me nourrit pas vraiment.",
    arrivee: "Ton temps peut redevenir vraiment à toi quand tout le reste n'a plus besoin de tourner en arrière-plan.",
  },
  {
    depart: "C'est normal que je porte tout. C'est ma vie, ma famille, mon cerveau.",
    arrivee: "Tout ce que tu portes ne t'appartient pas forcément. Certaines choses peuvent être triées, rendues ou déposées.",
  },
];

const alternatives = [
  {
    title: 'Les agendas et to-do lists',
    text: "Ils sont utiles, mais ils ne montrent pas toute la charge mentale invisible : les idées, les projets pas encore mûrs, les rappels pour les autres, les choses qui prennent de la place sans être de vraies tâches. Ils planifient, mais ils ne contiennent pas tout ce que tu portes.",
  },
  {
    title: 'Les cadres tout faits',
    text: "Ils peuvent être utiles, mais souvent trop rigides ou trop lourds à maintenir quand ta vraie vie déborde. Un cadre utile doit pouvoir bouger avec toi.",
  },
  {
    title: 'Les routines, le yoga, la méditation, le journaling',
    text: "Ils peuvent t'apaiser et te ramener à toi, mais ils ne rangent pas forcément ce qui continue de porter le poids dans ta tête.",
  },
  {
    title: 'La thérapie ou le coaching seuls',
    text: "Ils peuvent libérer et éclairer beaucoup de choses, mais ne se traduisent pas toujours dans la matière concrète : agenda, projets, rappels, décisions, limites.",
  },
];

const avantApres = [
  {
    situation: 'Ton agenda',
    avant: "Il est trop plein ou incomplet. Il ne reflète pas tout ce que tu portes vraiment.",
    apres: "Il devient plus lisible, plus cohérent avec ta vraie vie, avec une place pour toi aussi.",
  },
  {
    situation: 'Une nouvelle demande',
    avant: "Elle reste active dans ta tête et ajoute une tension intérieure.",
    apres: "Tu sais où la déposer, quand y revenir, et tu n'as plus besoin de la garder ouverte en permanence.",
  },
  {
    situation: 'Ton temps pour toi',
    avant: "Tu penses à tout ce que tu dois faire. Le repos devient presque fatigant.",
    apres: "Tu te sens plus présente, plus déposée, plus nourrie par ce moment.",
  },
  {
    situation: 'Ce qui compte pour toi',
    avant: "Tu repousses tes envies, tes rendez-vous, tes activités plaisir, tes projets de cœur.",
    apres: "Ce qui compte vraiment retrouve une place dans ta semaine et dans ta vie.",
  },
  {
    situation: 'Quand tout déborde dans ta tête',
    avant: "Tu fais une to-do list frénétique ou tu pars en évitement, scroll, fatigue, dispersion.",
    apres: "Tu déposes, tu tries, tu retrouves. Comme après avoir rangé une pièce qui débordait.",
  },
];

const inclus = [
  '5 sessions au total : 4 sessions individuelles sur 1 mois, puis une session de rappel à 3 mois.',
  'Des sessions de 1h à 2h selon le besoin et la matière du moment.',
  'Un support WhatsApp entre les sessions, dans un cadre clair.',
  "La mise en place d'un cadre de tri flexible, simple et adapté à ta manière de fonctionner.",
  "Un temps de constellation ou de travail transgénérationnel autour de ce que tu portes.",
  "Des audios d'hypnose de reprogrammation ou de guidance pour soutenir l'intégration.",
  "Une 5e session de rappel à 3 mois pour ajuster ce qui a été mis en place après usage réel.",
];

const sessions = [
  {
    title: 'Session 1 · Déposer',
    text: "On sort de ta tête ce qui tourne : tâches, rappels, idées, obligations, projets, tensions, choses à ne pas oublier et charge invisible.",
  },
  {
    title: 'Session 2 · Trier',
    text: "On distingue ce qui est urgent, ce qui peut attendre, ce qui est à toi, ce qui ne devrait plus reposer uniquement sur toi, et ce qui demande une autre place.",
  },
  {
    title: 'Session 3 · Rendre et réorganiser',
    text: "On regarde les loyautés, les habitudes, les poids pris par amour ou par réflexe, puis on commence à poser les limites et les choix nécessaires.",
  },
  {
    title: 'Session 4 · Stabiliser',
    text: "On installe une façon de fonctionner simple, flexible, reliée à ton agenda, à tes projets, à ton énergie et à ton moment de vie.",
  },
  {
    title: 'Session 5 · Ajuster à 3 mois',
    text: "On revient sur l'usage réel : ce qui tient, ce qui a bougé, ce qui doit être simplifié, et comment garder une ligne de temps qui continue à te soutenir.",
  },
];

const resultats = [
  'Une tête plus rangée, avec un endroit fiable où déposer ce que tu portais seule.',
  'Un agenda plus lisible, plus cohérent avec ta vraie vie.',
  'Une façon plus simple de retrouver tes projets, idées, rappels et priorités.',
  "Plus de clarté sur ce qui est à toi, ce qui ne l'est pas, et ce qui demande peut-être à changer.",
  "La sensation d'avoir refait de la place dans ta tête, comme quand on a enfin remis de l'ordre dans une pièce qui débordait.",
];

const preuves = [
  "J'ai appris à transformer mon propre bazar mental en repères clairs, sinon mes projets, mes idées et mes décisions tourneraient en boucle dans ma tête.",
  "J'ai plus de 20 ans d'expérience en coordination, supply chain, process, ERP et gestion de ressources.",
  "Mon talent naturel est de faire émerger l'évidence dans ce qui semblait emmêlé : trier, réagencer et rendre les choses plus lisibles.",
  "Mon approche relie le concret et l'invisible : organisation, constellations, intuition, transgénérationnel et retour à soi.",
];

const deuxMondes = [
  "Le concret : agenda, rappels, projets, décisions, demandes, idées, priorités et organisation quotidienne.",
  "L'invisible : loyautés, culpabilité, habitudes familiales, rôle de celle qui pense à tout, difficulté à déposer.",
  "Le lien entre les deux : un tri qui ne sert pas à mieux tenir, mais à voir ce qui doit être déposé, déplacé ou rendu.",
];

const pasPourToi = [
  "Tu cherches une méthode de productivité froide pour optimiser chaque minute.",
  "Tu veux juste une solution toute faite sans regarder ta vraie vie.",
  "Tu n'as pas envie d'explorer ce qui se joue aussi émotionnellement dans ce que tu portes.",
];

const faqs = [
  {
    q: "Est-ce que c'est une formation d'organisation ?",
    a: "Non. On ne va pas seulement ranger ton agenda. On va regarder ce que tu portes, où le déposer, comment le retrouver, et ce qui ne devrait peut-être plus reposer uniquement sur toi.",
  },
  {
    q: "Est-ce qu'il y a une garantie ?",
    a: "Pas de garantie satisfaite ou remboursée pour cette bêta d'accompagnement. En revanche, tu repars avec un tri clair, des repères utilisables dans ta vraie vie, et une session de rappel à 3 mois pour ajuster après usage réel.",
  },
  {
    q: "Pourquoi seulement 5 places ?",
    a: "Parce que c'est une première version. Je veux accompagner chaque personne finement, recueillir des retours précis et construire la suite à partir du réel, pas d'une offre théorique.",
  },
  {
    q: "Et si je découvre que quelque chose doit changer dans ma vie ?",
    a: "C'est possible. Quand on sort la charge de ta tête, certaines choses deviennent plus visibles : une limite à poser, une responsabilité à redistribuer, une manière de faire à arrêter, une décision à laisser mûrir. L'accompagnement ne sert pas à te pousser à tout bouleverser. Il sert à voir plus clairement ce qui demande une autre place, à ton rythme.",
  },
];
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>La nouvelle ligne de temps — Accompagnement bêta 1:1 — L'Atelier de Lucette</title>
    <meta
      name="description"
      content="La nouvelle ligne de temps : accompagnement bêta 1:1 pour faire le tri dans ta tête, déposer ce que tu portes et retrouver de la place pour toi dans ta vie."
    />
    <link rel="canonical" href="https://latelierdelucette.com/la-nouvelle-ligne-de-temps/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="L'Atelier de Lucette" />
    <meta property="og:title" content="La nouvelle ligne de temps — Faire le tri dans ta tête" />
    <meta property="og:description" content="Un accompagnement bêta 1:1 pour faire le tri dans ta tête, déposer ce que tu portes et retrouver de la place pour toi dans ta vie." />
    <meta property="og:url" content="https://latelierdelucette.com/la-nouvelle-ligne-de-temps/" />
    <meta property="og:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="La nouvelle ligne de temps — L'Atelier de Lucette" />
    <meta name="twitter:description" content="Faire le tri dans ta tête pour retrouver de la place pour toi dans ta vie." />
    <meta name="twitter:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
