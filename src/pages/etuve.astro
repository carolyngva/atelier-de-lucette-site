---
// L'Atelier de Lucette - Page offre BOFU
// L'Étuve : espace de pratique de 6 semaines, oracle D'une Rive à l'Autre inclus.
import '../styles/global.css';

const ctaHref = 'https://buy.stripe.com/7sY8wP39U3Bd4eob3r7bW01';

const etapes = [
  {
    n: '1',
    title: 'Incarnation',
    card: 'Incarnation',
    image: '/images/cards/incarnation.jpg',
    aide: '"Je ne sens rien", "Mon mental est trop puissant", "Je ne sais pas si c\'est mon intuition ou mon imagination".',
    text: "Tu apprends à ressentir l'intuition dans le corps. Pas comme une idée abstraite, ni comme une injonction à \"faire confiance\". Comme un signal sensible : une sensation, une agitation, une lourdeur, un élan, un apaisement.",
  },
  {
    n: '2',
    title: 'Exploration',
    card: 'Chasse au trésor',
    image: '/images/cards/chasse-au-tresor.jpg',
    aide: '"Je lis le livret et ça ne me parle pas", "Je suis perdue", "Je ne sais pas si je dois me fier au texte ou à l\'image".',
    text: "Tu utilises l'oracle comme laboratoire. Tu apprends à interroger une carte sans chercher une réponse absolue. L'oracle devient un support pour dialoguer avec ce qui se passe en toi, pas une voix extérieure de plus.",
  },
  {
    n: '3',
    title: 'Régulation',
    card: 'Avancer avec élégance',
    image: '/images/cards/avancer-avec-elegance.jpg',
    aide: '"Les actions sont toujours trop grandes", "Je ne suis pas sûre de ce que je fais", "Est-ce une résistance ou une fausse route ?"',
    text: "Tu apprends à reconnaître ce que ton système nerveux peut réellement soutenir. Une action peut être juste sur le papier, mais trop grande pour toi aujourd'hui. L'objectif est de trouver l'action qui ouvre un passage sans te mettre en survie.",
  },
  {
    n: '4',
    title: 'Passage',
    card: "D'une Rive à l'Autre",
    image: '/images/cards/d-une-rive-a-l-autre.jpg',
    aide: '"Je pensais que ça irait avec l\'action mais en fait non", "J\'ai peur", "Le mental reprend toute la place".',
    text: "Tu apprends à poser l'action juste et à l'ancrer. Tu ne restes pas dans la compréhension, le tirage ou l'intuition. Tu passes dans la matière : une action simple, précise, soutenable, que tu peux réellement faire.",
  },
];

const benefices = [
  "Reconnaître les signaux de ton intuition dans ton corps, au lieu de les chercher seulement dans ta tête.",
  "Faire la différence entre peur, mental, intuition et bruit extérieur quand une décision devient floue.",
  "Construire TA façon de t'écouter, au lieu d'appliquer une méthode de plus sur toi.",
  "Sortir de la boucle des avis, des signes, des contenus et des confirmations à répétition.",
  "Transformer ce que tu sens en une action simple, faisable et soutenable dans ta vraie vie.",
  "Repartir avec un système de pratique que tu peux continuer seule après les 6 semaines, si tu choisis de l'entretenir.",
];

const problemesFond = [
  "Tu demandes des avis, puis tu n'arrives pas à les suivre et tu t'en veux.",
  "Tu as peur de déranger, de décevoir, de prendre trop de place ou de faire le mauvais choix.",
  "Tu cherches une validation extérieure parce qu'une partie de toi ne se sent pas autorisée à choisir seule.",
  "Tu confonds parfois intuition et hypervigilance : ton corps parle, mais tu ne sais plus si c'est un oui profond ou une peur ancienne.",
];

const semaines = [
  {
    title: 'Semaine 1',
    text: "Ouvrir l'espace, choisir ta matière de pratique et repérer les voix déjà présentes autour de ta décision.",
  },
  {
    title: 'Semaine 2',
    text: "Sentir comment ton intuition, ta peur et ton mental se manifestent dans ton corps.",
  },
  {
    title: 'Semaine 3',
    text: "Interroger une carte sans chercher une réponse absolue, mais comme un miroir de ce qui se joue en toi.",
  },
  {
    title: 'Semaine 4',
    text: "Distinguer ce qui t'appartient vraiment de ce qui vient des attentes, des algorithmes, des avis ou des projections.",
  },
  {
    title: 'Semaine 5',
    text: "Transformer ton signal intérieur en action assez claire et assez petite pour être posée sans te mettre en survie.",
  },
  {
    title: 'Semaine 6',
    text: "Ancrer ta manière de décider et repartir avec un rituel simple à réutiliser seule.",
  },
];

const differences = [
  "Ce n'est pas une méthode pour obtenir une réponse extérieure de plus.",
  "Ce n'est pas une injonction à faire confiance aveuglément à ton intuition.",
  "Ce n'est pas une pratique pour devenir dépendante des cartes.",
  "Ce n'est pas du développement personnel qui te demande de forcer, performer ou passer à l'action trop vite.",
  "C'est un cadre sensible et concret pour écouter, distinguer, choisir, puis agir à ta mesure.",
];

const erreurs = [
  "Demander aux autres, puis être frustrée de ne pas réussir à suivre leurs conseils.",
  "Croire que les cartes avaient LA réponse, alors qu'elles ouvraient surtout une conversation intérieure.",
  "Choisir une action trop grande, trop symbolique, trop impressionnante, puis ne pas la faire.",
  "Accumuler de nouvelles informations au lieu de pratiquer avec ce qui était déjà là.",
];

const premieresCohortes = [
  "Tu aimes participer à quelque chose qui se construit en vrai, pas seulement consommer un programme déjà figé.",
  "Tu peux accueillir qu'une première cohorte soit vivante, ajustée, parfois plus artisanale qu'un programme déjà figé.",
  "Tu as envie que tes questions, tes blocages et tes retours contribuent à façonner la suite de L'Étuve.",
  "Tu veux un tarif fondateur en échange de cette place particulière dans la naissance de l'offre.",
];

const preuves = [
  "L'Étuve est le prolongement naturel de D'une Rive à l'Autre : le moment où l'oracle devient un espace de pratique, de discernement et de passage.",
  "Cette première cohorte est faite pour des femmes qui aiment entrer dans quelque chose de vivant, en train de se préciser.",
  "Tu bénéficies d'un tarif fondateur en échange de cette place particulière dans la naissance de l'offre.",
];

const recus = [
  "6 semaines pour construire TA façon de t'écouter",
  'Ouverture + 4 ateliers collectifs + clôture (jeudi 16h30-18h30, sauf ouverture et clôture 16h30-18h)',
  'Les replays des lives',
  "L'oracle physique D'une Rive à l'Autre, envoyé chez toi",
  'Des supports de pratique liés aux 4 étapes pour continuer après la cohorte',
  'Le cadre des voix : peur, mental, intuition, bruit extérieur',
  'Un groupe Telegram dédié',
  'Un questionnaire de préparation avant les lives',
];

const temoignages = [
  {
    name: 'Marjorie',
    context: "Inspir'Action",
    quote: "Je pensais que c'était une formation sur l'intuition avec un oracle. En fait, c'est l'intuition dans sa globalité qui offre évidemment une place à l'oracle.",
  },
  {
    name: 'Caroline',
    context: "Inspir'Action",
    quote: "Je vois plus rapidement quand mon mental est en train de me raconter une histoire. Je retourne à mon corps ou à mon coeur, ou alors j'utilise le jeu pour sortir du truc dans lequel il m'embarque.",
  },
  {
    name: 'Nathalie',
    context: "Inspir'Action",
    quote: "J'avais beaucoup trop de peurs et trop de doutes, et énormément de mal à écouter mon intuition. Le groupe donne envie d'aller faire les exercices et d'aller vraiment au bout du processus.",
  },
  {
    name: 'Fanny',
    context: 'Delta',
    quote: "Je trouvais qu'elle était à la fois perchée et très pragmatique. C'est la première fois où je me suis retrouvée à parler avec autre chose que mon cerveau, sans avoir l'impression d'être folle.",
  },
];

const faqs = [
  {
    q: "Est-ce que l'oracle D'une Rive à l'Autre est inclus ?",
    a: "Oui. L'oracle physique est inclus dans les 245 CHF. Si tu l'as déjà et que tu ne veux pas le recevoir une deuxième fois, écris-moi avant de t'inscrire : je te donnerai une réduction adaptée.",
  },
  {
    q: 'Est-ce que c\'est spirituel ?',
    a: "Oui, il y a une dimension spirituelle, pas au sens religieux. Ma spiritualité, c'est la co-création avec l'univers, la foi en quelque chose de plus grand que moi, l'idée que nous avons toutes une sagesse intérieure. Et le cadre reste concret : écouter, distinguer, choisir, agir.",
  },
  {
    q: 'Est-ce que les lives sont obligatoires ?',
    a: 'Tu peux regarder les replays, mais la première cohorte est pensée comme un espace vivant. Pour en tirer le meilleur, il vaut mieux participer aux lives ou au minimum suivre les replays et les pratiques chaque semaine.',
  },
  {
    q: 'Combien de temps ça demande ?',
    a: "Prévois environ 2h de live les semaines concernées, puis un temps de pratique personnel selon ton rythme. L'idée n'est pas d'ajouter une charge énorme, mais de créer un espace régulier pour écouter et poser une action.",
  },
  {
    q: "Et si je sais déjà que j'ai du mal à pratiquer régulièrement ?",
    a: "C'est justement une des matières de L'Étuve. Tu ne repars pas seulement avec de l'inspiration : tu construis un système simple, adapté à ta vraie vie, pour continuer après. Mais je ne peux pas pratiquer à ta place. L'objectif est de rendre la pratique assez claire, assez légère et assez personnelle pour que tu puisses choisir d'y revenir.",
  },
  {
    q: "Et si j'ai une décision importante à prendre maintenant ?",
    a: "L'Étuve n'est pas là pour te faire attendre 6 semaines avant d'agir. Si une décision importante est déjà présente dans ta vie, elle peut devenir ta matière de pratique dès le début.",
  },
  {
    q: "Est-ce qu'il y aura du suivi individuel ?",
    a: "Non, pas de suivi individuel. Les questions passent par le groupe Telegram et par les questionnaires de préparation avant les lives. J'y réponds pendant les lives et/ou dans une synthèse post-live.",
  },
  {
    q: 'Quand ça commence ?',
    a: "La première cohorte commence le 1er septembre 2026 et se termine le 12 octobre 2026. Les lives ont lieu le jeudi de 16h30 à 18h30 (ouverture le 3 sept et clôture le 11 oct de 16h30 à 18h). Détail des dates : ouverture le 3 sept, live 1 le 17 sept, live 2 le 24 sept, live 3 le 1er oct, live 4 le 8 oct, clôture le 11 oct.",
  },
  {
    q: 'Combien ça coûte ?',
    a: "Le prix est de 245 CHF pour les 6 semaines, oracle D'une Rive à l'Autre inclus. Si tu as déjà l'oracle, écris-moi avant de rejoindre pour recevoir la réduction correspondante.",
  },
];
