---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const ctaHref = 'https://buy.stripe.com/28EaEX6m61t57qAdbz7bW02';

const modules = [
  'La cérémonie d\'ouverture et de consécration',
  'Prendre l\'oracle en main',
  'Speed-dating avec l\'oracle',
  'L\'art de poser les bonnes questions',
  'Les tirages de base',
  'Pour les entrepreneuses : à la rencontre de ton avatar sacré, créer une offre inspirante et un message magnétique',
  'L\'atelier de communication avec l\'énergie de son entreprise',
];
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Oracle D'une Rive à l'Autre — L'Atelier de Lucette</title>
    <meta
      name="description"
      content="42 cartes aquarellées + livret couleur + formation vidéo. Un oracle pour connecter ton intuition à l'action."
    />
    <link rel="canonical" href="https://latelierdelucette.com/oracle-dunerivealautre/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="L'Atelier de Lucette" />
    <meta property="og:title" content="Oracle D'une Rive à l'Autre" />
    <meta property="og:description" content="42 cartes aquarellées + livret couleur + formation vidéo. Un oracle pour connecter ton intuition à l'action." />
    <meta property="og:url" content="https://latelierdelucette.com/oracle-dunerivealautre/" />
    <meta property="og:image" content="https://latelierdelucette.com/images/oracle/coffret.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Oracle D'une Rive à l'Autre" />
    <meta name="twitter:description" content="42 cartes aquarellées + livret couleur + formation vidéo. Un oracle pour connecter ton intuition à l'action." />
    <meta name="twitter:image" content="https://latelierdelucette.com/images/oracle/coffret.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SNKPGHZL0Y"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      if (window.location.search.includes('tr=internal')) {
        try { localStorage.setItem('__internal', '1'); } catch(e) {}
      }
      var __int = false;
      try { __int = localStorage.getItem('__internal') === '1'; } catch(e) {}
      gtag('config', 'G-SNKPGHZL0Y', __int ? { 'traffic_type': 'internal' } : {});
    </script>
  </head>

  <body class="selection:bg-[#CC3DAA] selection:text-[#F7F4EE] overflow-x-hidden bg-[#F7F4EE] text-[#1E3A8A]">
    <div class="bg-grain fixed inset-0 pointer-events-none z-0"></div>
    <div class="arch-lines">
      <svg width="100%" height="100%" viewBox="0 0 1440 900" preserveAspectRatio="none">
        <line x1="10%" y1="0" x2="10%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="90%" y1="0" x2="90%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="0" y1="800" x2="1440" y2="360" stroke="#CC3DAA" stroke-width="0.5" opacity="0.5" />
      </svg>
    </div>

    <Nav current="/oracle-dunerivealautre/" ctaHref={ctaHref} ctaLabel="Acheter" />

    <main class="relative z-10">
      <!-- Hero -->
      <header class="min-h-screen flex items-center px-6 pt-28 pb-20">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-[1.05fr_0.95fr] gap-14 items-center">
          <div class="text-center lg:text-left">
            <div class="inline-flex items-center gap-4 mb-8">
              <div class="h-px w-10 bg-[#2AACCB]"></div>
              <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#1E3A8A]/70">Oracle D'une Rive à l'Autre</span>
              <div class="h-px w-10 bg-[#CC3DAA]"></div>
            </div>

            <h1 class="text-5xl md:text-7xl leading-[1.05] font-normal tracking-tight mb-8">
              D'une Rive <span class="italic">à l'Autre</span>
            </h1>

            <p class="text-xl md:text-2xl leading-snug text-[#1E3A8A]/85 max-w-3xl lg:mx-0 mx-auto mb-6 font-light">
              De la <strong>Vision</strong> à la <strong>matière</strong>, un oracle pour connecter ses rêves et ses désirs et les matérialiser avec amour pour soi.
            </p>

            <p class="text-2xl md:text-3xl italic leading-tight text-[#CC3DAA] mb-8">
              42 cartes aquarellées &middot; Livret couleur &middot; Formation vidéo incluse
            </p>

            <p class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/80 max-w-3xl lg:mx-0 mx-auto mb-12 font-light">
              De l'inspiration à l'action. Un outil puissant pour t'aider à écouter ton intuition et poser des gestes concrets, à ton rythme.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-10">
              <a href={ctaHref} class="inline-flex justify-center bg-[#CC3DAA] text-[#F7F4EE] ui-text text-xs tracking-[0.18em] uppercase px-9 py-4 rounded-sm hover:bg-[#D4845A] transition-colors">Je découvre l'oracle</a>
              <a href="#histoire" class="inline-flex justify-center border border-[#1E3A8A]/25 text-[#1E3A8A] ui-text text-xs tracking-[0.18em] uppercase px-9 py-4 rounded-sm hover:border-[#CC3DAA] hover:text-[#CC3DAA] transition-colors">Son histoire</a>
            </div>

            <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-10 gap-y-3 text-sm text-[#1E3A8A]/75">
              <span class="flex items-center gap-2"><iconify-icon icon="solar:stars-minimalistic-linear" width="16"></iconify-icon> 42 cartes aquarellées</span>
              <span class="flex items-center gap-2"><iconify-icon icon="solar:book-bookmark-linear" width="16"></iconify-icon> Livret 125 pages couleur</span>
              <span class="flex items-center gap-2"><iconify-icon icon="solar:play-circle-linear" width="16"></iconify-icon> 7 modules vidéo</span>
            </div>
          </div>

          <div class="relative max-w-xl mx-auto lg:mx-0 w-full">
            <div class="absolute inset-0 bg-[#CC3DAA] translate-x-5 translate-y-5 rounded-sm"></div>
            <div class="relative aspect-square overflow-hidden rounded-sm border border-[#1E3A8A]/10 shadow-2xl bg-[#C9A96E]">
              <img src="/images/oracle/coffret.png" alt="Oracle D'une Rive à l'Autre" class="w-full h-full object-cover" />
            </div>
          </div>
        </div>
      </header>

      <!-- L'histoire -->
      <section id="histoire" class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6 text-center">L'histoire</p>
          <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-10 text-center">
            Un oracle né d'un rêve
          </h2>

          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/80 space-y-6 max-w-3xl mx-auto">
            <p>
              À l'aube d'expédier les premières commandes de l'oracle D'une Rive à l'Autre, je fais un rêve. <strong>Un grand rêve</strong> comme je les appelle. Ceux qui ne s'oublient pas et qui vous marquent. Ceux dont on se rappelle facilement pendant les jours, les mois et les années qui suivent.
            </p>
            <p>
              Dans ce rêve, je me vois créer. En accéléré et avec une précision chirurgicale, je vois <strong>le processus créatif</strong> par lequel je vais passer pour donner naissance au voyage initiatique digital.
            </p>
            <p>
              Je décide de mettre ces intuitions en action et la première vidéo du voyage, qui connecte et révèle les énergies de la carte "1-Vision", prend forme.
            </p>
            <p>
              Je suis heureuse de ma création, je l'aime, elle <strong>vibre</strong>. Et la montrer au monde me fait plus <strong>peur</strong> que jamais.
            </p>
            <p>
              Je ressens l'élan de créer les 42 vidéos, comme un voyage initiatique digital des énergies de l'oracle. J'ai peur. Je doute. J'y vais.
            </p>
            <p>
              <strong>L'Oracle D'une Rive à l'Autre porte en lui les énergies</strong> de ce processus créatif spirituel et donne l'élan de matérialiser ses idées et son art malgré les doutes et les peurs, par amour pour soi.
            </p>
          </div>

          <div class="mt-14 max-w-2xl mx-auto border-l-2 border-[#CC3DAA]/60 pl-8 py-4">
            <p class="text-2xl md:text-3xl font-serif italic leading-relaxed text-[#1E3A8A]">
              "Remerciez-moi en offrant votre art au monde et je serais comblée."
            </p>
          </div>
        </div>
      </section>

      <!-- L'univers du jeu -->
      <section class="px-6 py-24 bg-[#F7F4EE]">
        <div class="max-w-4xl mx-auto">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6 text-center">L'univers du jeu</p>
          <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-10 text-center">
            Un voyage d'une rive à l'autre
          </h2>

          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/80 space-y-5 max-w-3xl mx-auto">
            <p>
              Même si aucun visuel ne le montre clairement, l'énergie du jeu est directement liée aux légendes d'Avalon, cette île magique et mystérieuse où règne une grande sagesse.
            </p>
            <p>
              Le nom de l'oracle <strong>"D'une Rive à l'Autre"</strong> est un clin d'oeil au voyage en barque qu'il est nécessaire d'entreprendre pour rejoindre l'île, comme métaphore du voyage initiatique que nous faisons pour rejoindre le coeur de notre intuition.
            </p>
            <p>
              Alors que j'avais terminé de canaliser chacune des aquarelles et les messages de celles-ci, je ne trouvais pas le nom à donner à cet oracle. En reprenant la carte-guide créée pour m'accompagner au tout début de cette aventure et que j'avais posée sur mon autel de création lors d'un rituel, j'ai vu ces mots au milieu d'autres <strong>"d'une rive à l'autre"</strong>… l'inspiration avait traversé le temps pour être déjà là lorsque j'en ai eu besoin.
            </p>
            <p>
              J'ai co-écrit le livret avec Hehoa, ma femme, à partir des messages que j'ai canalisés. Nous y proposons des questions d'auto-coaching et une lecture ombre et lumière de chacune des cartes.
            </p>
          </div>
        </div>
      </section>

      <!-- Spécifications -->
      <section id="specs" class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-5xl mx-auto">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6 text-center">Spécifications</p>
          <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-14 text-center">
            Un objet pensé dans les moindres détails
          </h2>

          <div class="grid md:grid-cols-3 gap-6 mb-14">
            <div class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-7 text-center">
              <h3 class="text-2xl font-serif text-[#1E3A8A] mb-2">Coffret</h3>
              <p class="text-lg text-[#1E3A8A]/70">Rigide &middot; 13&times;17 cm</p>
              <p class="text-sm text-[#1E3A8A]/50">Noir et doré</p>
            </div>
            <div class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-7 text-center">
              <h3 class="text-2xl font-serif text-[#1E3A8A] mb-2">42 cartes</h3>
              <p class="text-lg text-[#1E3A8A]/70">9&times;12,5 cm &middot; Fini mat et doux</p>
              <p class="text-sm text-[#1E3A8A]/50">Très belle sensorialité</p>
            </div>
            <div class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-7 text-center">
              <h3 class="text-2xl font-serif text-[#1E3A8A] mb-2">Livret</h3>
              <p class="text-lg text-[#1E3A8A]/70">125 pages &middot; 11,5&times;15 cm</p>
              <p class="text-sm text-[#1E3A8A]/50">Couleur &middot; Fini mat</p>
            </div>
          </div>

          <div class="max-w-md mx-auto">
            <div class="relative">
              <div class="absolute inset-0 bg-[#CC3DAA] translate-x-3 translate-y-3 rounded-sm"></div>
              <div class="relative overflow-hidden rounded-sm border border-[#1E3A8A]/10 shadow-xl bg-[#C9A96E]">
                <img src="/images/oracle/livret-page.png" alt="Exemple d'une page du livret de l'oracle D'une Rive à l'Autre" class="w-full object-cover" />
              </div>
            </div>
            <p class="text-center text-sm text-[#1E3A8A]/50 mt-4 italic">Exemple d'une page du livret</p>
          </div>
        </div>
      </section>

      <!-- Le processus de création -->
      <section class="px-6 py-24 bg-[#F7F4EE]">
        <div class="max-w-5xl mx-auto">
          <div class="flex flex-col md:flex-row gap-16 items-center">
            <div class="w-full md:w-5/12 relative group">
              <div class="absolute inset-0 bg-[#CC3DAA] transform translate-x-4 translate-y-4 rounded-sm transition-transform duration-500 group-hover:translate-x-2 group-hover:translate-y-2"></div>
              <div class="aspect-[3/4] bg-[#C9A96E] relative overflow-hidden rounded-sm grayscale contrast-110 hover:grayscale-0 transition-all duration-1000 z-10 shadow-xl border border-white/20">
                <img src="/images/oracle/caroline.jpg" alt="Caroline Verdier" class="w-full h-full object-cover" style="object-position: center 30%;" />
              </div>
            </div>
            <div class="w-full md:w-7/12">
              <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Le processus de création</p>
              <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">9 mois de création, une renaissance</h2>
              <div class="space-y-5 text-lg leading-relaxed text-[#1E3A8A]/80">
                <p>
                  Quelle aventure intense que de créer cet oracle ! Ce voyage a été complètement différent de ce que j'avais pu envisager en Février 2020 lorsque l'idée s'est présentée clairement en moi. Une expérience où le mental n'avait absolument plus sa place.
                </p>
                <p>
                  J'ai d'abord canalisé les aquarelles des cartes, en me connectant à l'énergie qui voulait descendre et en laissant mon corps peindre, sans chercher à comprendre le message qui se déposait à travers mes pinceaux et mes couleurs.
                </p>
                <p>
                  Pendant tout le processus de création, mon travail a été d'écouter l'énergie de l'oracle et d'obéir à ces élans qui me traversaient pour les matérialiser.
                </p>
                <p class="italic text-[#CC3DAA]">
                  De l'idée à l'impression, cette aventure aura duré 9 mois. Une naissance pour l'oracle et une renaissance pour moi.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Prix et contenu -->
      <section id="prix" class="py-32 px-6 bg-[#1E3A8A] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-20"></div>
        <div class="relative z-10 max-w-3xl mx-auto text-center">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#C9A96E] mb-6">L'offre complète</p>
          <h2 class="text-4xl md:text-5xl font-serif text-white mb-10 leading-tight tracking-tight">
            Ce que tu reçois
          </h2>

          <div class="grid sm:grid-cols-3 gap-4 mb-12 text-left">
            <div class="bg-white/7 border border-white/10 rounded-sm p-5">
              <p class="ui-text text-[0.65rem] tracking-[0.18em] uppercase text-[#C9A96E] mb-2">Coffret</p>
              <p class="text-xl text-white">42 cartes + livret</p>
            </div>
            <div class="bg-white/7 border border-white/10 rounded-sm p-5">
              <p class="ui-text text-[0.65rem] tracking-[0.18em] uppercase text-[#C9A96E] mb-2">Formation</p>
              <p class="text-xl text-white">7 modules vidéo</p>
            </div>
            <div class="bg-white/7 border border-white/10 rounded-sm p-5">
              <p class="ui-text text-[0.65rem] tracking-[0.18em] uppercase text-[#C9A96E] mb-2">Livraison</p>
              <p class="text-xl text-white">Port inclus en Europe</p>
            </div>
          </div>

          <div class="text-left max-w-xl mx-auto mb-12">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#C9A96E] mb-5">Les modules de la formation "Les secrets d'une Rive à l'Autre"</p>
            <ul class="space-y-3">
              {modules.map((module, i) => (
                <li class="flex items-start gap-4 text-[#F1D9A7]/95 text-lg font-light">
                  <span class="w-6 h-6 rounded-full bg-[#CC3DAA]/20 flex items-center justify-center shrink-0 mt-0.5 text-[#CC3DAA] text-xs font-serif">{i + 1}</span>
                  <span>{module}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="bg-[#F7F4EE] p-8 md:p-10 rounded-sm shadow-2xl max-w-md mx-auto">
            <div class="text-6xl font-serif text-[#1E3A8A] mb-2">97</div>
            <div class="ui-text text-sm tracking-[0.18em] uppercase text-[#1E3A8A]/60 mb-8">CHF, port inclus en Europe</div>
            <a href={ctaHref} class="w-full inline-flex justify-center items-center gap-3 py-4 px-6 bg-[#CC3DAA] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#D4845A] transition-colors rounded-sm">
              Acheter l'oracle D'une Rive à l'Autre
              <iconify-icon icon="solar:arrow-right-linear" width="14" height="14"></iconify-icon>
            </a>
            <p class="text-xs text-[#1E3A8A]/60 mt-6 leading-relaxed">
              Paiement sécurisé par Stripe. Livraison en Europe incluse. Oracle expédié sous 5-7 jours ouvrés.
            </p>
          </div>
        </div>
      </section>

      <!-- Témoignages -->
      <section class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-5xl mx-auto">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6 text-center">Témoignages</p>
          <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6 text-center">
            On me dit souvent que l'oracle est magique.
          </h2>
          <p class="text-xl text-center text-[#1E3A8A]/70 mb-14 max-w-2xl mx-auto leading-relaxed">
            Oui. Et c'est aussi toi, qui est magique. Le DRAL vient révéler TA magie.
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4">
            <div class="col-span-2 sm:col-span-1">
              <img src="/images/oracle/testimonials/t-01.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-02.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-03.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-04.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-05.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-06.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-07.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-08.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-09.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-10.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-11.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-12.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-13.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-14.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-15.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
              <img src="/images/oracle/testimonials/t-16.png" alt="Témoignage" class="w-full rounded-sm border border-[#1E3A8A]/10" loading="lazy" />
            </div>
            <div>
