---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Oracle miroir pour prendre une décision — L'Atelier de Lucette</title>
    <meta
      name="description"
      content="Un oracle n'est pas une prédiction. C'est un miroir qui t'aide à voir ce que tu sais déjà. Découvre l'oracle D'une Rive à l'Autre et le tirage gratuit en ligne."
    />
    <link rel="canonical" href="https://latelierdelucette.com/oracle-miroir/" />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="L'Atelier de Lucette" />
    <meta property="og:title" content="Oracle miroir pour prendre une décision — L'Atelier de Lucette" />
    <meta property="og:description" content="Un oracle n'est pas une prédiction. C'est un miroir qui t'aide à voir ce que tu sais déjà." />
    <meta property="og:url" content="https://latelierdelucette.com/oracle-miroir/" />
    <meta property="og:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Oracle miroir pour prendre une décision" />
    <meta name="twitter:description" content="Un oracle n'est pas une prédiction. C'est un miroir." />
    <meta name="twitter:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Oracle miroir pour prendre une décision",
        "description": "Un oracle n'est pas une prédiction. C'est un miroir qui t'aide à voir ce que tu sais déjà.",
        "author": {
          "@type": "Person",
          "name": "Caroline Verdier",
          "url": "https://latelierdelucette.com/qui-suis-je/"
        },
        "url": "https://latelierdelucette.com/oracle-miroir/"
      }
    </script>
  </head>

  <body class="selection:bg-[#CC3DAA] selection:text-[#F7F4EE] overflow-x-hidden bg-[#F7F4EE] text-[#1E3A8A]">
    <div class="bg-grain fixed inset-0 pointer-events-none z-0"></div>
    <div class="arch-lines">
      <svg width="100%" height="100%" viewBox="0 0 1440 900" preserveAspectRatio="none">
        <line x1="10%" y1="0" x2="10%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="90%" y1="0" x2="90%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="0" y1="800" x2="1440" y2="360" stroke="#CC3DAA" stroke-width="0.5" opacity="0.5" />
      </svg>
    </div>

    <Nav current="/oracle-miroir/" />

    <main class="relative z-10">
      <!-- Hero -->
      <header class="min-h-[80vh] flex items-center px-6 pt-28 pb-20">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-4 mb-8">
            <div class="h-px w-10 bg-[#2AACCB]"></div>
            <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#1E3A8A]/70">Outil</span>
            <div class="h-px w-10 bg-[#CC3DAA]"></div>
          </div>

          <h1 class="text-5xl md:text-7xl leading-[1.05] font-normal tracking-tight mb-8">
            L'oracle comme <span class="italic">miroir</span>
          </h1>

          <p class="text-xl md:text-2xl text-[#1E3A8A]/75 max-w-3xl mx-auto leading-relaxed mb-12">
            Un oracle n'est pas une prédiction. Il ne décide pas à ta place.
            Il te montre ce que tu sais déjà, mais que tu n'osais pas te dire.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href="#difference" class="inline-flex items-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
              <iconify-icon icon="solar:stars-minimalistic-linear" width="16" height="16" stroke-width="1.5"></iconify-icon>
              Comprendre la différence
            </a>
            <a href="/tirage/" class="inline-flex items-center gap-2 px-10 py-5 border border-[#1E3A8A]/30 text-[#1E3A8A] text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/5 transition-all rounded-sm">
              <iconify-icon icon="solar:letter-linear" width="16" height="16"></iconify-icon>
              Essayer le tirage gratuit
            </a>
          </div>
        </div>
      </header>

      <!-- Différence -->
      <section id="difference" class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Clarifier</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">Ce n'est pas de la divination</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 space-y-6 max-w-3xl mx-auto">
            <p>Quand on entend "oracle", on pense prédiction, voyance, destin écrit d'avance. Ce n'est pas ça. L'oracle que j'ai créé — <em>D'une Rive à l'Autre</em> — n'est pas un outil pour savoir ce qui va arriver. C'est un outil pour voir ce qui est déjà là, en toi, mais que tu n'entends plus.</p>
            <p>Les cartes sont des déclencheurs. Elles ne donnent pas la réponse — elles bousculent le mental assez pour que ta propre réponse émerge. La réaction que tu as en voyant une carte (un "non" immédiat, un soulagement, une évidence) est parfois plus parlante que n'importe quelle interprétation.</p>
            <p class="text-2xl font-serif italic text-[#CC3DAA]">L'oracle ne te dit pas quoi faire. Il te montre ce que tu sais déjà, mais que tu n'osais pas te dire.</p>
          </div>
        </div>
      </section>

      <!-- Comment ça marche -->
      <section class="py-24 px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Pratique</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">Comment utiliser l'oracle pour éclairer une décision</h2>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <div class="w-12 h-12 rounded-full bg-[#CC3DAA]/10 flex items-center justify-center mb-6">
                <span class="text-xl font-serif italic text-[#CC3DAA]">01</span>
              </div>
              <h3 class="text-2xl font-normal mb-4">Formuler ta question</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Pas "est-ce que je dois... ?" mais "qu'est-ce que j'ai besoin de voir pour décider ?". La question ouverte laisse place à ce qui veut émerger, sans forcer une réponse binaire.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <div class="w-12 h-12 rounded-full bg-[#CC3DAA]/10 flex items-center justify-center mb-6">
                <span class="text-xl font-serif italic text-[#CC3DAA]">02</span>
              </div>
              <h3 class="text-2xl font-normal mb-4">Tirer et observer</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Tire une ou plusieurs cartes. Observe ta réaction immédiate avant toute interprétation. La première sensation — gêne, surprise, apaisement, rejet — est souvent plus vraie que le sens de la carte.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <div class="w-12 h-12 rounded-full bg-[#CC3DAA]/10 flex items-center justify-center mb-6">
                <span class="text-xl font-serif italic text-[#CC3DAA]">03</span>
              </div>
              <h3 class="text-2xl font-normal mb-4">Écouter ce que ça réveille</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">La carte est un prétexte. Ce qui compte, c'est ce qu'elle réveille en toi : une peur, une évidence, un soulagement, une résistance. Ton corps et ton intuition parlent dans cet espace entre la carte et ta réaction.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- L'oracle -->
      <section class="px-6 py-24 bg-[#1E3A8A] text-[#F7F4EE]">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#C9A96E] mb-6">L'oracle</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">D'une Rive à l'Autre</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#F7F4EE]/80 space-y-6 max-w-3xl mx-auto">
            <p>42 cartes, un chemin de retour à soi. Chaque carte est une invitation, un angle, une question qui bouscule le mental. Pas de dogme, pas de grille à apprendre — chaque carte parle directement à celle qui la tire.</p>
            <p>J'ai créé cet oracle parce que j'avais besoin d'un outil qui ne remplace pas l'intuition, mais qui la réveille. Un outil pour les femmes sensibles et actives, qui n'ont pas besoin d'une méthode de plus, mais d'un espace pour entendre leur propre voix.</p>
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-5 mt-14">
            <a href="/oracle-dunerivealautre/" class="inline-flex items-center gap-3 px-8 py-4 bg-[#CC3DAA] text-[#F7F4EE] text-xs uppercase tracking-[0.2em] hover:bg-[#CC3DAA]/90 transition-all rounded-sm">
              Découvrir l'oracle
            </a>
            <a href="/tirage/" class="inline-flex items-center gap-3 px-8 py-4 border border-[#F7F4EE]/30 text-[#F7F4EE] text-xs uppercase tracking-[0.2em] hover:bg-white/10 transition-all rounded-sm">
              Tirage gratuit
            </a>
          </div>
        </div>
      </section>

      <!-- Quand l'oracle ne suffit pas -->
      <section class="py-24 px-6 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Et si ça ne suffit pas</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">Quand le miroir ne suffit plus</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 space-y-6 max-w-3xl mx-auto">
            <p>Parfois, l'oracle révèle un blocage, mais il ne le dénoue pas. Parfois, on voit ce qui doit changer, mais on ne sait pas comment faire. Dans ces moments-là, l'oracle a fait son travail : il a montré l'invisible. Reste à agir.</p>
            <p>C'est là que les <strong>constellations</strong> et les <strong><a href="/lignes-de-temps/" class="text-[#CC3DAA] underline hover:no-underline">lignes de temps</a></strong> prennent le relais. L'oracle est la porte d'entrée — un espace doux pour commencer à voir. Le chemin continue avec d'autres outils. Si ton corps est bloqué, commence par <a href="/systeme-nerveux/" class="text-[#CC3DAA] underline hover:no-underline">comprendre ton système nerveux</a>.</p>
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-5 mt-14">
            <a href="/constellations/" class="inline-flex items-center gap-3 px-8 py-4 bg-[#1E3A8A] text-[#F7F4EE] text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all rounded-sm">
              Les constellations
            </a>
            <a href="/lignes-de-temps/" class="inline-flex items-center gap-3 px-8 py-4 border border-[#1E3A8A]/30 text-[#1E3A8A] text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/5 transition-all rounded-sm">
              Les lignes de temps
            </a>
            <a href="/prendre-une-decision/" class="inline-flex items-center gap-3 px-8 py-4 border border-[#1E3A8A]/30 text-[#1E3A8A] text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/5 transition-all rounded-sm">
              Prendre une décision
            </a>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="py-28 px-6 bg-[#CC3DAA] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-10"></div>
        <div class="relative z-10 max-w-3xl mx-auto text-center">
          <h2 class="text-4xl md:text-6xl font-serif text-white mb-8 leading-[1.1] tracking-tight">
            Prête à voir <span class="italic">ce que l'oracle révèle ?</span>
          </h2>
          <p class="text-lg text-white/90 font-light max-w-2xl mx-auto mb-12 leading-relaxed">
            Commence par un tirage gratuit en ligne, ou découvre l'oracle D'une Rive à l'Autre.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href="/tirage/" class="inline-flex items-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
              <iconify-icon icon="solar:stars-minimalistic-linear" width="16" height="16" stroke-width="1.5"></iconify-icon>
              Tirage gratuit
            </a>
            <a href="/oracle-dunerivealautre/" class="inline-flex items-center gap-2 px-10 py-5 border border-white/30 text-white text-xs uppercase tracking-[0.2em] hover:bg-white/10 transition-all rounded-sm">
              <iconify-icon icon="solar:letter-linear" width="16" height="16"></iconify-icon>
              Découvrir l'oracle
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
