---
import '../styles/global.css';
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>L'Atelier de Lucette — Liens</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SNKPGHZL0Y"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      if (window.location.search.includes('tr=internal')) {
        try { localStorage.setItem('__internal', '1'); } catch(e) {}
      }
      var __int = false;
      try { __int = localStorage.getItem('__internal') === '1'; } catch(e) {}
      gtag('config', 'G-SNKPGHZL0Y', __int ? { 'traffic_type': 'internal' } : {});
    </script>
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "bcce27c504d642ebb7d6257ea3fc8993"}'></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Cormorant Garamond', Georgia, serif;
        background-color: #F7F4EE;
        color: #1E3A8A;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .ui-text { font-family: 'Special Elite', 'Courier New', monospace; }

      .container {
        width: 100%;
        max-width: 400px;
        padding: 48px 24px;
        text-align: center;
      }

      h1 {
        font-size: 2rem;
        font-weight: 500;
        margin: 0 0 4px;
        line-height: 1.2;
      }
      h1 .italic {
        font-style: italic;
        color: #CC3DAA;
      }

      .tagline {
        font-size: 1.1rem;
        color: #1E3A8A;
        opacity: 0.7;
        margin: 0 0 8px;
        font-weight: 400;
        line-height: 1.35;
      }

      .tagline .arrow-line {
        display: block;
        margin-top: 6px;
      }

      .divider {
        width: 32px;
        height: 1.5px;
        background: #C9A96E;
        margin: 24px auto;
      }

      .links {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 32px;
      }

      .link-card {
        display: block;
        text-decoration: none;
        padding: 18px 20px;
        background: rgba(255, 255, 255, 0.5);
        border: 1px solid rgba(38, 63, 147, 0.08);
        border-radius: 6px;
        color: #1E3A8A;
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
      }
      .link-card::before {
        content: '';
        position: absolute;
        inset: 0;
        opacity: 0;
        transition: opacity 0.25s ease;
        background: linear-gradient(135deg, rgba(200, 58, 183, 0.04) 0%, rgba(213, 132, 88, 0.04) 100%);
      }
      .link-card:hover {
        transform: translateY(-2px);
        border-color: rgba(200, 58, 183, 0.2);
        box-shadow: 0 8px 24px rgba(38, 63, 147, 0.06);
      }
      .link-card:hover::before { opacity: 1; }
      .link-card:active { transform: translateY(0); }

      .link-card h2 {
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0 0 3px;
        position: relative;
      }
      .link-card p {
        font-size: 0.95rem;
        margin: 0;
        opacity: 0.65;
        font-weight: 400;
        position: relative;
      }

      .link-card .icon {
        display: inline-block;
        vertical-align: middle;
        margin-right: 6px;
      }
      .link-card .arrow {
        position: absolute;
        right: 20px;
        top: 50%;
        transform: translateY(-50%);
        opacity: 0;
        transition: opacity 0.25s ease, right 0.25s ease;
        font-size: 1.1rem;
      }
      .link-card:hover .arrow {
        opacity: 0.4;
        right: 16px;
      }

    </style>
  </head>
  <body>
    <div class="container">
      <h1>L'Atelier <span class="italic">de Lucette</span></h1>
      <p class="tagline">
        Je relance mon business après 2 burn-out<br />
        5 licenciements, 3 mariages, et ça va très bien
        <span class="arrow-line">→ Je te raconte comment ça se passe</span>
      </p>

      <div class="divider"></div>

      <div class="links">
        <a href="https://carolineverdier.substack.com" target="_blank" rel="noopener" class="link-card">
          <h2><span class="icon">✧</span> Newsletter</h2>
          <p>Les coulisses en entier : ce que je comprends, ce que je rate, ce qui me fait rire malgré tout</p>
          <span class="arrow">→</span>
        </a>

        <a href="/oracle-dunerivealautre/" target="_blank" rel="noopener" class="link-card">
          <h2><span class="icon">✦</span> L'oracle</h2>
          <p>42 cartes pour les jours où ton cerveau a ouvert 47 onglets et refuse de fermer la session</p>
          <span class="arrow">→</span>
        </a>

        <a href="/zayin/" target="_blank" rel="noopener" class="link-card">
          <h2><span class="icon">◈</span> Travailler avec moi</h2>
          <p>Si tu veux faire le tri, voir plus clair et remettre le mouvement en route</p>
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </body>
</html>
