            class="w-full px-4 py-3 mb-3 border border-[#1E3A8A]/20 rounded-sm text-sm text-[#1E3A8A] placeholder-[#1E3A8A]/40 bg-white focus:outline-none focus:border-[#CC3DAA] transition-colors">
          <input type="email" id="fe" placeholder="Ton email" required
            class="w-full px-4 py-3 mb-4 border border-[#1E3A8A]/20 rounded-sm text-sm text-[#1E3A8A] placeholder-[#1E3A8A]/40 bg-white focus:outline-none focus:border-[#CC3DAA] transition-colors">
          <button type="submit" id="sb" class="w-full py-4 px-6 bg-[#CC3DAA] text-white text-xs uppercase tracking-[0.2em] hover:bg-[#D4845A] transition-all rounded-sm">Recevoir mon audio</button>
          <p class="text-xs text-[#1E3A8A]/50 mt-4">Gratuit. Je peux me désinscrire à tout moment.</p>
        </form>
        <div id="fm" class="hidden mt-6"></div>
      </div>`;
    gi('s-result').classList.remove('hidden');
  }

  async function subQ(e, wid) {
    e.preventDefault();
    const btn = gi('sb'), msg = gi('fm');
    btn.disabled = true; btn.textContent = 'Envoi…';

    const prenom = gi('fn').value.trim();
    const email = gi('fe').value.trim();

    try {
      // Submit to NocoDB
      fetch(NOCODB_URL, {
        method:'POST',
        headers:{'Content-Type':'application/json','xc-token':NOCODB_TOKEN},
        body:JSON.stringify({
          email, prenom,
          resultat: R[wid].t,
          score_innocente: sc.innocente||0,
          score_hedoniste: sc.hedoniste||0,
          score_divine_mere: sc.divine_mere||0,
          score_artiste: sc.artiste||0,
          score_sage_leader: sc.sage_leader||0,
          score_guerrier: sc.guerrier||0,
          score_explorateur: sc.explorateur||0,
          reponses: JSON.stringify(ans),
          referrer: document.referrer||'',
        })
      }).catch(()=>{});

      // Subscribe to MailerLite
      const mlBody = new URLSearchParams();
      mlBody.append('fields[name]', prenom);
      mlBody.append('fields[email]', email);
      mlBody.append('ml-submit', '1');
      mlBody.append('anticsrf', 'true');
      fetch('https://assets.mailerlite.com/jsonp/'+ML_ACCOUNT_ID+'/forms/'+ML_FORM_ID+'/subscribe', {
        method:'POST', body:mlBody
      }).catch(()=>{});

      // Track
      if(typeof fbq === 'function') fbq('track','Lead',{content_name:'Quiz - '+R[wid].t});

      btn.textContent = '✅ C'est parti !';
      msg.classList.remove('hidden');
      msg.innerHTML =
        '<div class="p-6 bg-white border border-[#2AACCB]/20 rounded-sm text-center">'+
        '<p class="text-lg font-serif text-[#1E3A8A] mb-3">Merci ' + prenom + ' !</p>'+
        '<p class="text-[#1E3A8A]/70 leading-relaxed">Vérifie ta boîte mail dans les prochaines minutes.<br/>Ton audio personnalisé t\'attend.</p>'+
        '<div class="mt-6 border-t border-[#1E3A8A]/10 pt-6">'+
        '<p class="text-sm text-[#1E3A8A]/60 mb-4">En attendant, découvre L\'Étuve — un espace de pratique de 6 semaines pour approfondir ce que ce quiz a commencé.</p>'+
        '<a href="/etuve/" class="inline-flex px-8 py-4 bg-[#CC3DAA] text-white text-xs uppercase tracking-[0.2em] hover:bg-[#D4845A] transition-all rounded-sm">Découvrir L\'Étuve</a>'+
        '</div></div>';
      gi('qf').classList.add('hidden');

    } catch(e) {
      msg.classList.remove('hidden');
      msg.innerHTML = '<div class="p-4 bg-white border border-[#1E3A8A]/10 rounded-sm text-center text-[#1E3A8A]/80">Merci ! Vérifie tes emails.</div>';
      btn.textContent = '✅ Fait';
    }
  }

  function gi(id) { return document.getElementById(id); }
  </script>
</body>
</html>