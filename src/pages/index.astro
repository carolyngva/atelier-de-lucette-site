---
const destination = '/etuve/';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://latelierdelucette.com/etuve/" />
    <title>Redirection vers L'Étuve</title>
    <script is:inline define:vars={{ destination }}>
      window.location.replace(destination);
    </script>
  </head>
  <body>
    <p>Redirection vers <a href={destination}>L'Étuve</a>.</p>
  </body>
</html>
