---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Comment prendre une décision difficile — L'Atelier de Lucette</title>
    <meta
      name="description"
      content="Tu ne sais pas quelle décision prendre ? Apprends à utiliser ton corps, ton intuition et des outils concrets pour sortir de l'hésitation et choisir en conscience."
    />
    <link rel="canonical" href="https://latelierdelucette.com/prendre-une-decision/" />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="L'Atelier de Lucette" />
    <meta property="og:title" content="Comment prendre une décision difficile — L'Atelier de Lucette" />
    <meta property="og:description" content="Sortir de l'hésitation et choisir en conscience — avec ton corps, ton intuition et des outils concrets." />
    <meta property="og:url" content="https://latelierdelucette.com/prendre-une-decision/" />
    <meta property="og:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Comment prendre une décision difficile" />
    <meta name="twitter:description" content="Sortir de l'hésitation et choisir en conscience." />
    <meta name="twitter:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Comment prendre une décision difficile",
        "description": "Sortir de l'hésitation et choisir en conscience — avec ton corps, ton intuition et des outils concrets.",
        "author": {
          "@type": "Person",
          "name": "Caroline Verdier",
          "url": "https://latelierdelucette.com/qui-suis-je/"
        },
        "url": "https://latelierdelucette.com/prendre-une-decision/"
      }
    </script>
  </head>

  <body class="selection:bg-[#CC3DAA] selection:text-[#F7F4EE] overflow-x-hidden bg-[#F7F4EE] text-[#1E3A8A]">
    <div class="bg-grain fixed inset-0 pointer-events-none z-0"></div>
    <div class="arch-lines">
      <svg width="100%" height="100%" viewBox="0 0 1440 900" preserveAspectRatio="none">
        <line x1="10%" y1="0" x2="10%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="90%" y1="0" x2="90%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="0" y1="800" x2="1440" y2="360" stroke="#CC3DAA" stroke-width="0.5" opacity="0.5" />
      </svg>
    </div>

    <Nav current="/prendre-une-decision/" />

    <main class="relative z-10">
      <!-- Hero -->
      <header class="min-h-[80vh] flex items-center px-6 pt-28 pb-20">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-4 mb-8">
            <div class="h-px w-10 bg-[#2AACCB]"></div>
            <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#1E3A8A]/70">Guide</span>
            <div class="h-px w-10 bg-[#CC3DAA]"></div>
          </div>

          <h1 class="text-5xl md:text-7xl leading-[1.05] font-normal tracking-tight mb-8">
            Comment prendre<br />
            <span class="italic text-[#CC3DAA]">une décision difficile</span>
          </h1>

          <p class="text-xl md:text-2xl text-[#1E3A8A]/75 max-w-3xl mx-auto leading-relaxed mb-12">
            Le mental tourne en rond. Les avis divergent. Et toi, tu ne sais plus
            ce qui est vraiment à toi. Voici comment sortir de l'hésitation.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href="#pourquoi" class="inline-flex items-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
              <iconify-icon icon="solar:stars-minimalistic-linear" width="16" height="16" stroke-width="1.5"></iconify-icon>
              Pourquoi c'est si dur
            </a>
            <a href="#methode" class="inline-flex items-center gap-2 px-10 py-5 border border-[#1E3A8A]/30 text-[#1E3A8A] text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/5 transition-all rounded-sm">
              <iconify-icon icon="solar:letter-linear" width="16" height="16"></iconify-icon>
              La méthode
            </a>
          </div>
        </div>
      </header>

      <!-- Pourquoi c'est si dur -->
      <section id="pourquoi" class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Le problème</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">Pourquoi c'est si dur de décider ?</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 space-y-6 max-w-3xl mx-auto">
            <p>Parce que tu n'as pas trop peu d'informations — tu en as trop. Ton mental pèse le pour et le contre, mais il ne peut pas tout calculer. Et au milieu de cette surcharge, la peur de se tromper paralyse.</p>
            <p>Mais le vrai problème n'est pas l'hésitation. Le vrai problème, c'est que tu ne sais plus à quelle voix te fier. L'intuition dit une chose, la peur en dit une autre, le mental ajoute ses scénarios, et l'avis des autres vient tout brouiller.</p>
            <p class="text-2xl font-serif italic text-[#CC3DAA]">Prendre une décision difficile, ce n'est pas trouver la bonne réponse. C'est apprendre à reconnaître sa propre voix au milieu du bruit.</p>
          </div>
        </div>
      </section>

      <!-- La méthode -->
      <section id="methode" class="py-24 px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">La méthode</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">3 étapes pour y voir clair</h2>
            <p class="text-lg md:text-xl text-[#1E3A8A]/65 max-w-2xl mx-auto">Un processus qui ne passe pas que par le mental.</p>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <div class="w-12 h-12 rounded-full bg-[#CC3DAA]/10 flex items-center justify-center mb-6">
                <span class="text-xl font-serif italic text-[#CC3DAA]">01</span>
              </div>
              <h3 class="text-2xl font-normal mb-4">Le corps d'abord</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Avant toute analyse, vérifie l'état de ton système nerveux. Si tu es en stress ou en fatigue, tu ne peux pas décider correctement. Commence par une respiration, un mouvement, un retour au corps. Puis, pour chaque option, observe la sensation physique : est-ce que ça ouvre ou ça ferme ?</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <div class="w-12 h-12 rounded-full bg-[#CC3DAA]/10 flex items-center justify-center mb-6">
                <span class="text-xl font-serif italic text-[#CC3DAA]">02</span>
              </div>
              <h3 class="text-2xl font-normal mb-4">L'oracle comme miroir</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Un tirage oracle n'est pas une prédiction. C'est un miroir qui bouscule le mental assez pour que ta propre réponse émerge. La carte que tu tires, et surtout ta réaction ("ah non, pas ça"), en dit souvent plus long que des heures d'hésitation.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <div class="w-12 h-12 rounded-full bg-[#CC3DAA]/10 flex items-center justify-center mb-6">
                <span class="text-xl font-serif italic text-[#CC3DAA]">03</span>
              </div>
              <h3 class="text-2xl font-normal mb-4">La décision juste</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Une fois que le corps a parlé et que l'oracle a éclairé, la question devient : qu'est-ce qui est aligné, pas parfait ? La "bonne" décision n'existe pas. Mais il y a une décision qui est plus toi que les autres. Et ton corps la connaît déjà.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Les outils -->
      <section class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Aller plus loin</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">Quand l'hésitation persiste</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 space-y-6 max-w-3xl mx-auto">
            <p>Si tu as essayé ces étapes et que l'hésitation est toujours là, c'est que le blocage n'est peut-être pas dans la question que tu te poses. Il peut être plus profond : une loyauté familiale invisible, une peur qui n'est pas la tienne, une place que tu occupes par habitude.</p>
            <p>Dans ce cas, les <strong>constellations</strong> et l'exploration des <strong>lignes de temps</strong> sont des outils qui contournent le mental et rendent visible ce qui agit en dessous. Ce n'est pas plus "magique" qu'autre chose — c'est juste une autre couche d'information, que le mental seul ne peut pas atteindre.</p>
          </div>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-5 mt-14">
            <a href="/oracle-miroir/" class="inline-flex items-center gap-3 px-8 py-4 bg-[#1E3A8A] text-[#F7F4EE] text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all rounded-sm">
              L'oracle comme miroir
            </a>
            <a href="/constellations/" class="inline-flex items-center gap-3 px-8 py-4 border border-[#1E3A8A]/30 text-[#1E3A8A] text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/5 transition-all rounded-sm">
              Les constellations
            </a>
            <a href="/lignes-de-temps/" class="inline-flex items-center gap-3 px-8 py-4 border border-[#1E3A8A]/30 text-[#1E3A8A] text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/5 transition-all rounded-sm">
              Les lignes de temps
            </a>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="py-28 px-6 bg-[#CC3DAA] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-10"></div>
        <div class="relative z-10 max-w-3xl mx-auto text-center">
          <h2 class="text-4xl md:text-6xl font-serif text-white mb-8 leading-[1.1] tracking-tight">
            Prête à sortir <span class="italic">de l'hésitation ?</span>
          </h2>
          <p class="text-lg text-white/90 font-light max-w-2xl mx-auto mb-12 leading-relaxed">
            Que ce soit par toi-même ou accompagnée, il y a toujours un chemin pour y voir plus clair.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href="/oracle-miroir/" class="inline-flex items-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
              <iconify-icon icon="solar:stars-minimalistic-linear" width="16" height="16" stroke-width="1.5"></iconify-icon>
              L'oracle comme miroir
            </a>
            <a href="/intuition-peur-mental/" class="inline-flex items-center gap-2 px-10 py-5 border border-white/30 text-white text-xs uppercase tracking-[0.2em] hover:bg-white/10 transition-all rounded-sm">
              <iconify-icon icon="solar:letter-linear" width="16" height="16"></iconify-icon>
              Distinguer intuition, peur, mental
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
