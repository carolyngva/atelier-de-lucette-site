---
// L'Atelier de Lucette — Page À propos / Qui suis-je
// Caroline Verdier : intuition, oracle, constellations, supply chain, IA
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const ctaOffre = '/zayin/';

const timeline = [
  {
    period: '2003 — 2014',
    title: 'Les racines',
    subtitle: 'Supply Chain & Coordination',
    text: "Plus de 10 ans dans la logistique internationale et la supply chain : coordination de flux, gestion de commandes, ERP, process, KPI et coordination cross-fonctionnelle. De la logistique à Genève aux arômes chez Firmenich, de la medtech chez BD à la pharma cold chain chez Aptissen.",
    formations: [{ text: 'BTS Commerce International' }, { text: 'Cambridge English / Business English' }],
    image: null,
  },
  {
    period: '2014 — 2016',
    title: 'Le grand large',
    subtitle: 'Voyages et reconnexion',
    text: "Deux années de sabbatique et de voyage. Un moment fondateur : retrouver le corps, la nature, la lenteur. Apprendre à être sans produire. Une reconnexion à elle-même qui deviendra le fil invisible de tout le reste. Pérou, Bolivie, Argentine, Chili, Île de Pâques, Polynésie Française, Thaïlande, Japon — des territoires qui ont ouvert des espaces intérieurs.",
    formations: [{ text: 'Hatha Vinyasa Yoga Teacher Training — Bhakti Healing School' }],
    image: null,
  },
  {
    period: '2018 — 2023',
    title: "L'éveil",
    subtitle: 'Accompagnement, burn-out, création',
    text: "Création de son activité indépendante : accompagnement des femmes sur les relations, la communication, l'audace de se lancer. Ça fonctionnait. Puis deux burn-out. Une vérité traversée : le corps n'est pas le problème. Il est le traducteur que l'intuition utilise pour se faire entendre. C'est aussi là que naît l'oracle D'une Rive à l'Autre — 42 cartes, un chemin de retour à soi.",
    formations: [{ text: 'Certificat de facilitatrice en hypnose spirituelle — Institut IIHS (2018)', href: '/lignes-de-temps/' }, { text: 'Relationship Coach Certificate — The Relationship School (2021)', href: '/coaching-de-relations/' }],
    image: '/images/ecoute-toi-caroline-drize.jpg',
    imageAlt: "Caroline Verdier avec l'oracle D'une Rive à l'Autre",
  },
  {
    period: '2025 — 2026',
    title: 'L\'invisible',
    subtitle: "L'Atelier de Lucette",
    text: "Formation en constellations familiales et systémiques, puis spécialisation sur l'eau. BodyWise pour comprendre les mécanismes du système nerveux. Un nouveau territoire s'ouvre : rendre visible ce qui agit en dessous — les places, les loyautés, les attachements, les mouvements bloqués, les forces invisibles qui façonnent nos vies. Après plus de 20 ans dans la logistique, la supply chain et la coordination, Caroline choisit de se consacrer pleinement à L'Atelier de Lucette : le Substack, Zayin, les constellations, l'oracle, l'accompagnement. Elle explore l'IA comme levier avec le Prisme One Bootcamp — et construit, chaque jour, le business qui lui ressemble.",
    formations: [{ text: 'BodyWise — Régulation du système nerveux (2025)', href: '/systeme-nerveux/' }, { text: 'Constellations Familiales et Systémiques — L\'Athanor (2026)', href: '/constellations/' }, { text: 'Spécialisation constellations sur l\'eau — Paula Eskinazi (2026)', href: '/constellations/' }, { text: 'Prisme One Bootcamp IA (2026)', href: 'https://prisme.one/ref/cavew4am' }],
    image: null,
  },
];

const croyances = [
  "S'isoler n'est pas le chemin. Me laisser happer par le monde non plus. J'explore la voie du milieu.",
  "On peut décider de déconstruire son armure avant qu'elle nous brise. Le choix précède la souffrance.",
  'Le corps n\'est pas le problème. Il est le traducteur que l\'intuition utilise pour se faire entendre.',
];
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Caroline Verdier — Intuition, oracle et constellations — L'Atelier de Lucette</title>
    <meta
      name="description"
      content="Supply chain et optimisation de systèmes, créatrice de l'oracle D'une Rive à l'Autre et constellatrice. Caroline aide les femmes sensibles et actives à retrouver leur voix intérieure dans un monde saturé de bruit, sans se couper du réel."
    />
    <link rel="canonical" href="https://latelierdelucette.com/qui-suis-je/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="L'Atelier de Lucette" />
    <meta property="og:title" content="Caroline Verdier — Intuition, oracle et constellations — L'Atelier de Lucette" />
    <meta property="og:description" content="Supply chain et optimisation de systèmes, créatrice de l'oracle D'une Rive à l'Autre et constellatrice. Caroline aide les femmes sensibles et actives à retrouver leur voix intérieure." />
    <meta property="og:url" content="https://latelierdelucette.com/qui-suis-je/" />
    <meta property="og:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1080" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Caroline Verdier — Intuition, oracle et constellations" />
    <meta name="twitter:description" content="Supply chain et optimisation de systèmes, créatrice de l'oracle D'une Rive à l'Autre et constellatrice." />
    <meta name="twitter:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script type="application/ld+json" is:inline>
      [
        {
          "@context": "https://schema.org",
          "@type": "Person",
          "name": "Caroline Verdier",
          "description": "Supply chain et optimisation de systèmes, créatrice de l'oracle D'une Rive à l'Autre et constellatrice. J'aide les femmes sensibles et actives à retrouver leur voix intérieure dans un monde saturé de bruit.",
          "url": "https://latelierdelucette.com/qui-suis-je/",
          "image": "https://latelierdelucette.com/images/portrait-caroline.png",
          "knowsAbout": ["Intuition", "Oracle", "Constellations familiales", "Supply chain", "Customer service", "Intelligence artificielle"],
          "sameAs": [
            "https://carolineverdier.substack.com",
            "https://instagram.com/carolineverdier.atelier"
          ]
        },
        {
          "@context": "https://schema.org",
          "@type": "AboutPage",
          "name": "À propos de Caroline Verdier",
          "description": "Supply chain et optimisation de systèmes, créatrice de l'oracle D'une Rive à l'Autre et constellatrice.",
          "mainEntity": {
            "@type": "Person",
            "name": "Caroline Verdier"
          }
        },
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "C'est quoi la différence entre intuition, peur et mental ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "L'intuition est une sensation (calme, juste, cohérente). La peur est une contraction (protection, survie, connu). Le mental est un moulin (répétition, contrôle, scénarios). Leur point commun : elles parlent toutes les trois dans le corps. Ce qui les distingue ? La sensation qui les accompagne. Mon travail est de t'aider à reconnaître la signature corporelle de chacune — pour ne plus les confondre."
              }
            },
            {
              "@type": "Question",
              "name": "Est-ce qu'il faut déjà savoir écouter son intuition ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "La plupart des femmes qui viennent me voir savent écouter leur intuition. Mais elles sont dans une phase de vie où elles n'y arrivent plus vraiment — le bruit, les responsabilités, la fatigue ont pris le dessus. L'atelier est fait pour ça : retrouver une voie que tu connais déjà, mais que tu n'entends plus clairement. Pas besoin de prérequis, juste l'envie de retrouver le fil."
              }
            },
            {
              "@type": "Question",
              "name": "Je travaille dans un milieu cartésien, est-ce que c'est pour moi ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "J'optimise des systèmes et des processus de distribution. Je déploie des ERP et des process. Je parle à l'IA. Si j'ai pu concilier intuition et cartesianisme, c'est que c'est possible. L'Atelier de Lucette est fait pour les femmes qui vivent dans le réel, pas pour celles qui veulent fuir le monde."
              }
            },
            {
              "@type": "Question",
              "name": "C'est quoi la différence avec du coaching ou une thérapie ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ce n'est pas une thérapie. Et c'est plus qu'un coaching. Une thérapeute s'occupe de blessures et de traumatismes. Un coach t'accompagne vers un objectif. Moi, je commence par une étape qui vient avant : t'aider à distinguer ta voix de la peur, du mental et du bruit extérieur. C'est seulement après ce discernement que l'accompagnement vers l'action a du sens."
              }
            },
            {
              "@type": "Question",
              "name": "Tu fais des constellations, c'est quoi exactement ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Les constellations sont un outil pour rendre visible les dynamiques invisibles — les places, les loyautés, les blocages qui se jouent dans une famille, un couple, une organisation. Je ne les utilise pas comme une thérapie, mais comme un miroir : voir ce qui est là pour pouvoir choisir autre chose. C'est un complément aux approches plus classiques, pas un substitut."
              }
            },
            {
              "@type": "Question",
              "name": "Je ne sais pas par où commencer, vous proposez quoi ?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Si tu veux être accompagnée pour faire le tri, clarifier ce qui est mélangé et remettre le mouvement en route : Zayin est l'accompagnement à rejoindre. Si tu veux découvrir l'oracle : D'une Rive à l'Autre est un outil de 42 cartes pour t'aider à voir ce que tu sais déjà. Tu peux aussi lire la newsletter pour voir si mon approche te parle."
              }
            }
          ]
        }
      ]
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SNKPGHZL0Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      if (window.location.search.includes('tr=internal')) {
        try { localStorage.setItem('__internal', '1'); } catch(e) {}
      }
      var __int = false;
      try { __int = localStorage.getItem('__internal') === '1'; } catch(e) {}
      gtag('config', 'G-SNKPGHZL0Y', __int ? { 'traffic_type': 'internal' } : {});
    </script>
  </head>

  <body class="selection:bg-[#CC3DAA] selection:text-[#F7F4EE] overflow-x-hidden bg-[#F7F4EE] text-[#1E3A8A]">
    <div class="bg-grain fixed inset-0 pointer-events-none z-0"></div>
    <div class="arch-lines">
      <svg width="100%" height="100%" viewBox="0 0 1440 900" preserveAspectRatio="none">
        <line x1="10%" y1="0" x2="10%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="90%" y1="0" x2="90%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="0" y1="800" x2="1440" y2="360" stroke="#CC3DAA" stroke-width="0.5" opacity="0.5" />
      </svg>
    </div>

    <Nav current="/qui-suis-je/" />

    <main class="relative z-10">
      <!-- Hero -->
      <header class="min-h-screen flex items-center px-6 pt-28 pb-20">
        <div class="max-w-7xl mx-auto grid lg:grid-cols-[1.05fr_0.95fr] gap-14 items-center">
          <div class="text-center lg:text-left">
            <div class="inline-flex items-center gap-4 mb-8">
              <div class="h-px w-10 bg-[#2AACCB]"></div>
              <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#1E3A8A]/70">Qui je suis</span>
              <div class="h-px w-10 bg-[#CC3DAA]"></div>
            </div>

            <h1 class="text-5xl md:text-7xl leading-[1.05] font-normal tracking-tight mb-6">
              Caroline <span class="italic">Verdier</span>
            </h1>

            <p class="text-2xl md:text-3xl italic leading-tight text-[#CC3DAA] mb-10">
              S'isoler n'est pas le chemin.<br />Me laisser happer par le monde non plus.<br />J'explore la voie du milieu.
            </p>

            <div class="space-y-4">
              <div class="flex items-center gap-4 text-lg md:text-xl text-[#1E3A8A]/80">
                <span class="text-[#CC3DAA] shrink-0">✦</span>
                <span>Supply Chain et optimisation de systèmes</span>
              </div>
              <div class="flex items-center gap-4 text-lg md:text-xl text-[#1E3A8A]/80">
                <span class="text-[#CC3DAA] shrink-0">✦</span>
                <span>Créatrice de l'oracle <em>D'une Rive à l'Autre</em></span>
              </div>
              <div class="flex items-center gap-4 text-lg md:text-xl text-[#1E3A8A]/80">
                <span class="text-[#CC3DAA] shrink-0">✦</span>
                <span>Constellatrice</span>
              </div>
            </div>
          </div>

          <div class="relative max-w-xl mx-auto lg:mx-0 w-full">
            <div class="absolute inset-0 bg-[#CC3DAA] translate-x-5 translate-y-5 rounded-sm"></div>
            <div class="relative aspect-[4/5] overflow-hidden rounded-sm border border-[#1E3A8A]/10 shadow-2xl bg-[#C9A96E]">
              <img src="/images/portrait-caroline.png" alt="Caroline Verdier" class="w-full h-full object-cover" style="object-position: center 32%;" />
            </div>
          </div>
        </div>
      </header>

      <!-- Intro — Je suis Caroline -->
      <section class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <div class="max-w-3xl">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Je suis Caroline</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Une planificatrice qui croit aux forces invisibles.</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 space-y-6 max-w-4xl">
            <p>J'optimise des systèmes et des processus. Je crée des oracles. Je fais des constellations. Je parle à l'IA comme à mon assistante. Et au milieu de tout ça, j'apprends à écouter mon corps et à faire confiance à ce que je sens.</p>
            <p>Pendant plus de 20 ans, j'ai coordonné des flux logistiques, déployé des ERP, géré des plannings, optimisé des process dans des multinationales — l'aviation, la medtech, les biens de consommation, le transport international. J'aime les systèmes, la rigueur, l'organisation. C'est une vraie partie de moi.</p>
            <p>Parallèlement, j'ai créé une activité indépendante autour des relations, des oracles, des constellations et de l'accompagnement des femmes. J'ai traversé deux burn-out qui m'ont appris ce que mon mental seul ne pouvait pas m'enseigner : mon corps me parle. Et quand je l'écoute, mes décisions deviennent plus justes.</p>
            <p class="text-2xl font-serif italic text-[#CC3DAA]">Je crois aux oracles et à l'IA. Je crois au corps et aux systèmes. Je crois aux signes et à l'action concrète. Je crois qu'on peut être intuitive sans être hors-sol.</p>
          </div>
        </div>
      </section>

      <!-- Timeline — Mon chemin -->
      <section id="chemin" class="py-24 px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Mon chemin</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">Les étapes qui m'ont construite</h2>
          </div>

          <div class="space-y-20 md:space-y-28">
            {timeline.map((etape, i) => (
              <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
                {i % 2 === 0 ? (
                  <>
                    <div class="order-1">
                      {etape.image ? (
                        <div class="relative group">
                          <div class="absolute inset-0 bg-[#CC3DAA] translate-x-4 translate-y-4 rounded-sm transition-transform duration-500 group-hover:translate-x-2 group-hover:translate-y-2"></div>
                          <div class="relative aspect-[4/5] overflow-hidden rounded-sm border border-[#1E3A8A]/10 shadow-xl bg-[#C9A96E]">
                            <img src={etape.image} alt={etape.imageAlt || etape.title} class="w-full h-full object-cover" loading="lazy" />
                          </div>
                        </div>
                      ) : (
                        <div class="aspect-[4/5] bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm flex items-center justify-center p-8">
                          <div class="text-center">
                            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-[#CC3DAA]/10 flex items-center justify-center">
                              <span class="text-3xl font-serif italic text-[#CC3DAA]">{String(i + 1).padStart(2, '0')}</span>
                            </div>
                            <p class="text-xl font-serif text-[#1E3A8A]/50 italic">{etape.period}</p>
                          </div>
                        </div>
                      )}
                    </div>
                    <div class="order-2">
                      <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA]">{etape.period}</span>
                      <h3 class="text-3xl md:text-4xl leading-tight font-normal mt-3 mb-1">{etape.title}</h3>
                      <p class="text-lg text-[#2AACCB] font-light mb-6">{etape.subtitle}</p>
                      <p class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 mb-6">{etape.text}</p>
                      {etape.formations.length > 0 && (
                        <div class="border-t border-[#1E3A8A]/10 pt-5">
                          <p class="ui-text text-[0.65rem] tracking-[0.18em] uppercase text-[#C9A96E] mb-3">Formations</p>
                          <div class="space-y-2">
                            {etape.formations.map((f) => (
                              <div class="flex gap-3 text-[#1E3A8A]/65 text-base">
                                <span class="text-[#C9A96E] shrink-0">—</span>
                                {f.href ? <a href={f.href} class="hover:text-[#CC3DAA] transition-colors underline underline-offset-2 decoration-[#1E3A8A]/20 hover:decoration-[#CC3DAA]/50">{f.text}</a> : <span>{f.text}</span>}
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  </>
                ) : (
                  <>
                    <div class="order-2 md:order-1">
                      <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA]">{etape.period}</span>
                      <h3 class="text-3xl md:text-4xl leading-tight font-normal mt-3 mb-1">{etape.title}</h3>
                      <p class="text-lg text-[#2AACCB] font-light mb-6">{etape.subtitle}</p>
                      <p class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 mb-6">{etape.text}</p>
                      {etape.formations.length > 0 && (
                        <div class="border-t border-[#1E3A8A]/10 pt-5">
                          <p class="ui-text text-[0.65rem] tracking-[0.18em] uppercase text-[#C9A96E] mb-3">Formations</p>
                          <div class="space-y-2">
                            {etape.formations.map((f) => (
                              <div class="flex gap-3 text-[#1E3A8A]/65 text-base">
                                <span class="text-[#C9A96E] shrink-0">—</span>
                                {f.href ? <a href={f.href} class="hover:text-[#CC3DAA] transition-colors underline underline-offset-2 decoration-[#1E3A8A]/20 hover:decoration-[#CC3DAA]/50">{f.text}</a> : <span>{f.text}</span>}
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                    <div class="order-1 md:order-2">
                      {etape.image ? (
                        <div class="relative group">
                          <div class="absolute inset-0 bg-[#CC3DAA] translate-x-4 translate-y-4 rounded-sm transition-transform duration-500 group-hover:translate-x-2 group-hover:translate-y-2"></div>
                          <div class="relative aspect-[4/5] overflow-hidden rounded-sm border border-[#1E3A8A]/10 shadow-xl bg-[#C9A96E]">
                            <img src={etape.image} alt={etape.imageAlt || etape.title} class="w-full h-full object-cover" loading="lazy" />
                          </div>
                        </div>
                      ) : (
                        <div class="aspect-[4/5] bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm flex items-center justify-center p-8">
                          <div class="text-center">
                            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-[#CC3DAA]/10 flex items-center justify-center">
                              <span class="text-3xl font-serif italic text-[#CC3DAA]">{String(i + 1).padStart(2, '0')}</span>
                            </div>
                            <p class="text-xl font-serif text-[#1E3A8A]/50 italic">{etape.period}</p>
                          </div>
                        </div>
                      )}
                    </div>
                  </>
                )}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Ce que je fais -->
      <section id="ce-que-je-fais" class="px-6 py-24 bg-[#FFFCF6] border-b border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Ce que je fais</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">L'Atelier de Lucette, c'est quoi ?</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 space-y-6">
            <p>L'Atelier de Lucette est un espace pour les femmes qui vivent dans le r&eacute;el — qui travaillent, ont des enfants, des responsabilit&eacute;s, des &eacute;crans — et qui sentent qu'une autre voie est possible sans avoir &agrave; tout quitter.</p>
            <p>Je ne vends pas une m&eacute;thode de plus pour "faire confiance &agrave; son intuition". Je pose une question diff&eacute;rente : avant de savoir si tu peux lui faire confiance, sais-tu la reconna&icirc;tre ? Peur, mental, conditionnements, bruit ext&eacute;rieur : tout &ccedil;a parle fort. Mon travail est de t'aider &agrave; retrouver le fil de ce qui est vraiment &agrave; toi.</p>
            <p>Avec les constellations, les oracles, les espaces collectifs et les outils pratiques, je cr&eacute;e des exp&eacute;riences o&ugrave; l'invisible devient lisible. Ma promesse : ne pas quitter le monde pour s'entendre, mais cr&eacute;er un espace o&ugrave; le bruit redescend assez pour reconna&icirc;tre sa propre voix.</p>
            <div class="grid md:grid-cols-3 gap-8 mt-12 pt-12 border-t border-[#1E3A8A]/10">
              <div class="text-center">
                <p class="text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-4">Pour qui</p>
                <p class="text-lg text-[#1E3A8A]/80">Les femmes sensibles et actives qui vivent dans le monde r&eacute;el et veulent &eacute;couter leur intuition sans se couper du moderne.</p>
              </div>
              <div class="text-center">
                <p class="text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-4">Comment</p>
                <p class="text-lg text-[#1E3A8A]/80">Constellations, oracle D'une Rive &agrave; l'Autre, espaces collectifs, outils pratiques — des miroirs pour &eacute;clairer l'invisible.</p>
              </div>
              <div class="text-center">
                <p class="text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-4">Ce qui me diff&eacute;rencie</p>
                <p class="text-lg text-[#1E3A8A]/80">Je ne dis pas "fais confiance &agrave; ton intuition". Je dis : ton syst&egrave;me nerveux te prot&egrave;ge. Avant d'&eacute;couter, encore faut-il pouvoir cr&eacute;er un espace de s&eacute;curit&eacute;. Mon travail, c'est de te donner des outils concrets pour distinguer ce qui est peur, mental ou v&eacute;ritable signal int&eacute;rieur — et savoir quoi en faire.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Ce en quoi je crois -->
      <section id="croyances" class="px-6 py-24 bg-[#1E3A8A] text-[#F7F4EE]">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#C9A96E] mb-6">Ce en quoi je crois</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">Quelques phrases qui me guident</h2>
          </div>
          <div class="space-y-8">
            {croyances.map((citation) => (
              <div class="border-l-2 border-[#CC3DAA] pl-8 md:pl-12 py-2">
                <p class="text-2xl md:text-3xl font-serif italic leading-snug text-[#F1D9A7]">{citation}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Pourquoi Lucette -->
      <section id="lucette" class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-12">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Pourquoi Lucette ?</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">L'histoire derrière le nom</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 space-y-6 max-w-3xl mx-auto">
            <p>Lucette, c'était ma grand-mère. Une femme créative, sensible, talentueuse, qui n'a pas toujours eu la place qu'elle méritait. Je me souviens d'elle dans son atelier de peinture sur soie — les couleurs, la patience, la beauté qui naissait entre ses mains.</p>
            <p>L'Atelier de Lucette, c'est un hommage. Et une promesse : ne pas laisser nos élans, nos désirs et notre vérité rester coincés dans une vie trop petite. Ne pas attendre que quelqu'un nous donne la permission de créer, d'oser, d'exister pleinement.</p>
            <p class="text-2xl font-serif italic text-[#CC3DAA]">Lucette, c'est le rappel que ce qui veut naître à travers nous mérite une place dans le monde.</p>
          </div>
        </div>
      </section>

      <!-- Questions fr&eacute;quentes -->
      <section id="questions" class="px-6 py-24 bg-[#F7F4EE]">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Questions fr&eacute;quentes</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">Tu te poses peut-&ecirc;tre ces questions</h2>
          </div>
          <div class="space-y-8">
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <h3 class="text-xl md:text-2xl font-normal text-[#1E3A8A] mb-4">C'est quoi la diff&eacute;rence entre intuition, peur et mental ?</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">L'intuition est une sensation (calme, juste, coh&eacute;rente). La peur est une contraction (protection, survie, connu). Le mental est un moulin (r&eacute;p&eacute;tition, contr&ocirc;le, sc&eacute;narios). Leur point commun : elles parlent toutes les trois dans le corps. Ce qui les distingue ? La sensation qui les accompagne. Mon travail est de t'aider &agrave; reconna&icirc;tre la signature corporelle de chacune — pour ne plus les confondre.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <h3 class="text-xl md:text-2xl font-normal text-[#1E3A8A] mb-4">Est-ce qu'il faut d&eacute;j&agrave; savoir &eacute;couter son intuition ?</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">La plupart des femmes qui viennent me voir savent &eacute;couter leur intuition. Mais elles sont dans une phase de vie o&ugrave; elles n'y arrivent plus vraiment — le bruit, les responsabilit&eacute;s, la fatigue ont pris le dessus. L'atelier est fait pour &ccedil;a : retrouver une voie que tu connais d&eacute;j&agrave;, mais que tu n'entends plus clairement. Pas besoin de pr&eacute;requis, juste l'envie de retrouver le fil.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <h3 class="text-xl md:text-2xl font-normal text-[#1E3A8A] mb-4">Je travaille dans un milieu cart&eacute;sien, est-ce que c'est pour moi ?</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">J'optimise des syst&egrave;mes et des processus de distribution. Je d&eacute;ploie des ERP et des process. Je parle &agrave; l'IA. Si j'ai pu concilier intuition et cartesianisme, c'est que c'est possible. L'Atelier de Lucette est fait pour les femmes qui vivent dans le r&eacute;el, pas pour celles qui veulent fuir le monde.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <h3 class="text-xl md:text-2xl font-normal text-[#1E3A8A] mb-4">C'est quoi la diff&eacute;rence avec du coaching ou une th&eacute;rapie ?</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Ce n'est pas une th&eacute;rapie. Et c'est plus qu'un coaching. Une th&eacute;rapeute s'occupe de blessures et de traumatismes. Un coach t'accompagne vers un objectif. Moi, je commence par une &eacute;tape qui vient avant : t'aider &agrave; distinguer ta voix de la peur, du mental et du bruit ext&eacute;rieur. C'est seulement apr&egrave;s ce discernement que l'accompagnement vers l'action a du sens.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <h3 class="text-xl md:text-2xl font-normal text-[#1E3A8A] mb-4">Tu fais des constellations, c'est quoi exactement ?</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Les constellations sont un outil pour rendre visible les dynamiques invisibles — les places, les loyaut&eacute;s, les blocages qui se jouent dans une famille, un couple, une organisation. Je ne les utilise pas comme une th&eacute;rapie, mais comme un miroir : voir ce qui est l&agrave; pour pouvoir choisir autre chose. C'est un compl&eacute;ment aux approches plus classiques, pas un substitut.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <h3 class="text-xl md:text-2xl font-normal text-[#1E3A8A] mb-4">Je ne sais pas par o&ugrave; commencer, vous proposez quoi ?</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Si tu veux &ecirc;tre accompagn&eacute;e pour faire le tri, clarifier ce qui est m&eacute;lang&eacute; et remettre le mouvement en route : <a href="/zayin/" class="text-[#CC3DAA] underline hover:no-underline">Zayin</a> est l'accompagnement &agrave; rejoindre. Si tu veux d&eacute;couvrir l'oracle : <a href="/oracle-dunerivealautre/" class="text-[#CC3DAA] underline hover:no-underline">D'une Rive &agrave; l'Autre</a>. Tu peux aussi <a href="https://carolineverdier.substack.com" target="_blank" rel="noopener" class="text-[#CC3DAA] underline hover:no-underline">lire la newsletter</a> pour voir si mon approche te parle.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Tu veux travailler avec moi ? -->
      <section class="py-28 px-6 bg-[#CC3DAA] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-10"></div>
        <div class="relative z-10 max-w-3xl mx-auto text-center">
          <h2 class="text-4xl md:text-6xl font-serif text-white mb-8 leading-[1.1] tracking-tight">
            Tu veux travailler<br /><span class="italic">avec moi ?</span>
          </h2>
          <p class="text-lg text-white/90 font-light max-w-2xl mx-auto mb-12 leading-relaxed">
            Si tu te reconnais dans ce chemin — cette fatigue d'avoir trop de réponses et pas assez de silence, cette envie de retrouver ce qui est vraiment à toi — j'ai créé un espace pour ça.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href={ctaOffre} class="inline-flex items-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
              <iconify-icon icon="solar:stars-minimalistic-linear" width="16" height="16" stroke-width="1.5"></iconify-icon>
              Rejoindre l'accompagnement
            </a>
            <a href="https://carolineverdier.substack.com" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-10 py-5 border border-white/30 text-white text-xs uppercase tracking-[0.2em] hover:bg-white/10 transition-all rounded-sm">
              <iconify-icon icon="solar:letter-linear" width="16" height="16"></iconify-icon>
              Lire la newsletter
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
