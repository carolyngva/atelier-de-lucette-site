---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Système nerveux et intuition — L'Atelier de Lucette</title>
    <meta
      name="description"
      content="Ton système nerveux décide si tu peux entendre ton intuition. Découvre comment la régulation du système nerveux (BodyWise) libère ta capacité d'écoute intérieure."
    />
    <link rel="canonical" href="https://latelierdelucette.com/systeme-nerveux/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="L'Atelier de Lucette" />
    <meta property="og:title" content="Système nerveux et intuition — L'Atelier de Lucette" />
    <meta property="og:description" content="Avant d'écouter ton intuition, encore faut-il que ton système nerveux te le permette." />
    <meta property="og:url" content="https://latelierdelucette.com/systeme-nerveux/" />
    <meta property="og:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Système nerveux et intuition — L'Atelier de Lucette" />
    <meta name="twitter:description" content="Avant d'écouter ton intuition, encore faut-il que ton système nerveux te le permette." />
    <meta name="twitter:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Système nerveux et intuition",
        "description": "Ton système nerveux décide si tu peux entendre ton intuition.",
        "author": {
          "@type": "Person",
          "name": "Caroline Verdier",
          "url": "https://latelierdelucette.com/qui-suis-je/"
        },
        "url": "https://latelierdelucette.com/systeme-nerveux/"
      }
    </script>
  </head>

  <body class="selection:bg-[#CC3DAA] selection:text-[#F7F4EE] overflow-x-hidden bg-[#F7F4EE] text-[#1E3A8A]">
    <div class="bg-grain fixed inset-0 pointer-events-none z-0"></div>
    <div class="arch-lines">
      <svg width="100%" height="100%" viewBox="0 0 1440 900" preserveAspectRatio="none">
        <line x1="10%" y1="0" x2="10%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="90%" y1="0" x2="90%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="0" y1="800" x2="1440" y2="360" stroke="#CC3DAA" stroke-width="0.5" opacity="0.5" />
      </svg>
    </div>

    <Nav current="/systeme-nerveux/" />

    <main class="relative z-10">
      <!-- Hero -->
      <header class="min-h-[80vh] flex items-center px-6 pt-28 pb-20">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-4 mb-8">
            <div class="h-px w-10 bg-[#2AACCB]"></div>
            <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#1E3A8A]/70">Comprendre</span>
            <div class="h-px w-10 bg-[#CC3DAA]"></div>
          </div>

          <h1 class="text-5xl md:text-7xl leading-[1.05] font-normal tracking-tight mb-8">
            Système nerveux <span class="italic">et intuition</span>
          </h1>

          <p class="text-xl md:text-2xl text-[#1E3A8A]/75 max-w-3xl mx-auto leading-relaxed mb-12">
            Ton système nerveux décide si tu peux entendre ton intuition. Ce n'est pas une
            métaphore : si ton corps est en protection, l'écoute fine n'est pas accessible.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href="#comprendre" class="inline-flex items-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
              <iconify-icon icon="solar:stars-minimalistic-linear" width="16" height="16" stroke-width="1.5"></iconify-icon>
              Comprendre
            </a>
            <a href="/intuition-peur-mental/" class="inline-flex items-center gap-2 px-10 py-5 border border-[#1E3A8A]/30 text-[#1E3A8A] text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/5 transition-all rounded-sm">
              <iconify-icon icon="solar:letter-linear" width="16" height="16"></iconify-icon>
              Distinguer intuition, peur, mental
            </a>
          </div>
        </div>
      </header>

      <!-- Pourquoi le système nerveux -->
      <section id="comprendre" class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">La clé</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">Le système nerveux, porte d'entrée de l'intuition</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 space-y-6 max-w-3xl mx-auto">
            <p>On croit que l'intuition est un don, un talent spirituel, quelque chose qu'on a ou qu'on n'a pas. En réalité, l'intuition est une capacité physiologique. Et elle dépend directement de l'état de ton système nerveux.</p>
            <p>Quand ton système nerveux est en mode survie (stress chronique, fatigue, hypervigilance), ton corps est occupé à te protéger. Toute son énergie part dans la détection de menaces. Dans cet état, tu ne peux pas entendre ton intuition. Ce n'est pas un manque de connexion — c'est de la physiologie pure.</p>
            <p class="text-2xl font-serif italic text-[#CC3DAA]">Avant d'écouter, encore faut-il pouvoir créer un espace de sécurité dans ton corps.</p>
          </div>
        </div>
      </section>

      <!-- Les états -->
      <section class="py-24 px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Les états</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">Où est ton système nerveux maintenant ?</h2>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <span class="text-3xl text-[#CC3DAA] block mb-4">△</span>
              <h3 class="text-2xl font-normal mb-4">Survie (sympathique)</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Stress, agitation, hypervigilance, anxiété. Tu es en action, en alerte, en protection. L'intuition n'est pas accessible — trop de bruit intérieur. Le corps est tendu, prêt à fuir ou à combattre.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <span class="text-3xl text-[#C9A96E] block mb-4">▽</span>
              <h3 class="text-2xl font-normal mb-4">Effondrement (dorsal)</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Fatigue, engourdissement, déconnexion, "je n'ai plus d'énergie". Le système nerveux s'est éteint pour se protéger. L'intuition est noyée, inaccessible. Tu n'as pas la force d'écouter quoi que ce soit.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <span class="text-3xl text-[#2AACCB] block mb-4">✦</span>
              <h3 class="text-2xl font-normal mb-4">Sécurité (ventral)</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Calme, présence, connexion à soi et aux autres. C'est dans cet état que l'intuition devient audible. Le corps est détendu, l'esprit est clair. La régulation du système nerveux est la condition préalable à l'écoute fine.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- BodyWise -->
      <section class="px-6 py-24 bg-[#1E3A8A] text-[#F7F4EE]">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#C9A96E] mb-6">La méthode</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">BodyWise : comprendre et réguler</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#F7F4EE]/80 space-y-6 max-w-3xl mx-auto">
            <p>J'ai suivi la formation <strong><a href="https://julielaroche.teachable.com" target="_blank" rel="noopener" class="text-[#F1D9A7] underline hover:no-underline">BodyWise</a></strong> de Julie Laroche (2025) pour moi-même — pas pour obtenir une certification qui m'autoriserait à le pratiquer sur les autres. J'ai appris à lire les signaux de mon propre système nerveux, à comprendre ce qui se passe dans mon corps quand je suis en stress, et à trouver des outils concrets pour revenir à un état de sécurité.</p>
            <p>Ce travail personnel m'a donné un langage et une compréhension qui éclairent profondément ma façon d'accompagner. Mais quand on me demande "est-ce que tu peux m'aider avec mon système nerveux ?", ma réponse est claire : la meilleure chose à faire est de se former directement avec BodyWise ou une autre approche sérieuse. C'est un investissement pour soi qui change tout.</p>
            <p>Ce n'est pas une technique de relaxation de plus. C'est une éducation physiologique : apprendre à reconnaître où on est dans son système nerveux, et savoir quoi faire pour en sortir. Avant d'écouter son intuition, avant de prendre une décision, avant de communiquer dans son couple — il faut que le corps soit en sécurité.</p>
            <p class="text-xl font-serif italic text-[#F1D9A7]">La régulation du système nerveux n'est pas un luxe. C'est le socle de tout le reste.</p>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="py-28 px-6 bg-[#CC3DAA] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-10"></div>
        <div class="relative z-10 max-w-3xl mx-auto text-center">
          <h2 class="text-4xl md:text-6xl font-serif text-white mb-8 leading-[1.1] tracking-tight">
            Ton système nerveux<span class="italic"><br />a besoin d'être entendu ?</span>
          </h2>
          <p class="text-lg text-white/90 font-light max-w-2xl mx-auto mb-12 leading-relaxed">
            La régulation du système nerveux est la clé de tout le reste. Explore les outils qui t'aident à créer un espace de sécurité intérieure.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href="/intuition-peur-mental/" class="inline-flex items-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
              <iconify-icon icon="solar:stars-minimalistic-linear" width="16" height="16" stroke-width="1.5"></iconify-icon>
              Distinguer intuition, peur, mental
            </a>
            <a href="/lignes-de-temps/" class="inline-flex items-center gap-2 px-10 py-5 border border-white/30 text-white text-xs uppercase tracking-[0.2em] hover:bg-white/10 transition-all rounded-sm">
              <iconify-icon icon="solar:letter-linear" width="16" height="16"></iconify-icon>
              Explorer les lignes de temps
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
