---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Qu'est-ce qui brouille ta direction intérieure ? | L'Atelier de Lucette</title>
  <meta name="description" content="Mini-diagnostic en 5 questions pour voir ce qui t'empêche de retrouver ta direction après avoir trop tenu." />
  <link rel="canonical" href="https://latelierdelucette.com/diagnostic/" />
  <meta property="og:title" content="Qu'est-ce qui brouille ta direction intérieure ?" />
  <meta property="og:description" content="Après avoir trop tenu, fais le mini-diagnostic pour voir ce qui t'empêche de retrouver ta direction." />
  <meta property="og:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap" rel="stylesheet" />
  <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
  <style>
    .fade-in { animation: fadeIn 0.35s ease-out both; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
    .progress-bar { transition: width 0.35s ease-out; }
    .answer-card { transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
    .answer-card:hover { transform: translateY(-3px); box-shadow: 0 16px 35px -20px rgba(30, 58, 138, 0.45); border-color: rgba(204, 61, 170, 0.35); }
    .answer-card:active { transform: scale(0.98); }
    .copy-status { min-height: 1.25rem; }
    .dm-message { word-break: break-word; }
  </style>
</head>

<body class="selection:bg-[#CC3DAA] selection:text-[#F7F4EE] overflow-x-hidden bg-[#F7F4EE] text-[#1E3A8A]">
  <Nav current="/diagnostic/" ctaHref="/zayin/" ctaLabel="L'accompagnement" />

  <main class="relative z-10 pt-28 pb-20 px-4 min-h-screen flex items-center" id="app">
    <div class="max-w-3xl mx-auto w-full">
      <section id="intro" class="text-center fade-in">
        <div class="inline-flex items-center gap-4 mb-8">
          <div class="h-px w-10 bg-[#2AACCB]"></div>
          <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#1E3A8A]/70">Mini-diagnostic</span>
          <div class="h-px w-10 bg-[#CC3DAA]"></div>
        </div>
          <h1 class="text-4xl md:text-6xl leading-[1.05] font-normal tracking-tight mb-6">
          Qu'est-ce qui brouille<br class="hidden md:block" /> <span class="italic text-[#CC3DAA]">ta direction intérieure</span> ?
        </h1>
        <p class="text-lg md:text-xl text-[#1E3A8A]/75 max-w-2xl mx-auto mb-5 leading-relaxed">
          Après avoir trop tenu, tu peux aller mieux et ne pas encore savoir dans quel sens reconstruire.
        </p>
        <p class="text-base md:text-lg text-[#1E3A8A]/65 max-w-xl mx-auto mb-10 leading-relaxed">
          En 5 questions, repère ce qui brouille le plus ta direction en ce moment : peur de te tromper, poids à rendre, ancien système, trop de possibles ou élan recouvert.
        </p>
        <button onclick="startDiagnostic()" class="px-10 py-5 bg-[#CC3DAA] text-[#F7F4EE] text-xs uppercase tracking-[0.2em] hover:bg-[#D4845A] transition-all rounded-sm">
          Faire le mini-diagnostic
        </button>
      </section>

      <section id="quiz" class="hidden">
        <div class="mb-8">
          <div class="flex justify-between items-center text-xs text-[#1E3A8A]/60 mb-2">
            <div class="flex items-center gap-3">
              <button id="back-btn" onclick="goBack()" class="hidden hover:text-[#CC3DAA] transition-colors p-1 -ml-1" title="Question précédente">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 12L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <span id="q-num">Question 1/5</span>
            </div>
            <span id="q-pct">0%</span>
          </div>
          <div class="h-1 bg-[#1E3A8A]/10 rounded-full overflow-hidden"><div id="progress" class="progress-bar h-full bg-[#CC3DAA] rounded-full" style="width:0%"></div></div>
        </div>
        <div id="q-box"></div>
      </section>

      <section id="result" class="hidden"></section>
    </div>
  </main>

  <Footer />

  <script is:inline>
    const profiles = {
      garantie: {
        title: 'Tu cherches une garantie',
        subtitle: 'Ta tête veut être sûre avant d’avancer.',
        color: '#CC3DAA',
        icon: '→',
        text: "Ton premier point de blocage semble venir de la pression à trouver la bonne direction. Pas juste une piste. La direction qui serait encore vraie dans 20 ans, qui ne te ferait pas souffrir, qui ne dérangerait personne et qui prouverait que tu ne vas pas recommencer comme avant.",
        next: "Le premier tri à faire : distinguer ce qui vient de ton élan de ce qui cherche surtout une sécurité parfaite. Une direction juste n'a pas besoin d'être verrouillée pour commencer."
      },
      poids: {
        title: "Tu portes ce qui ne t'appartient plus",
        subtitle: 'Ta direction est recouverte par des rôles, des loyautés ou des responsabilités anciennes.',
        color: '#2AACCB',
        icon: '◇',
        text: "Ton premier point de blocage semble venir de ce que tu continues à porter : attentes, responsabilités, besoins des autres, loyautés familiales, anciens rôles. Une partie de ton énergie sert encore à tenir une place qui n'est peut-être plus juste pour toi.",
        next: "Le premier tri à faire : regarder ce qui est vraiment à toi, ce qui vient d'avant, et ce qui peut être rendu ou libéré sans abandonner personne."
      },
      ancien: {
        title: "Ton ancien système pilote encore",
        subtitle: 'Ce qui t’a protégée avant continue peut-être de décider pour toi.',
        color: '#D4845A',
        icon: '△',
        text: "Ton premier point de blocage semble venir de réflexes anciens : anticiper, contrôler, prouver, tenir, comprendre encore, sécuriser encore. Ces mécanismes ont peut-être été utiles pour survivre ou tenir, mais ils ne peuvent plus guider toute la suite.",
        next: "Le premier tri à faire : repérer ce que ton ancien système essaie de protéger, puis mettre à jour ce qui n'a plus besoin de fonctionner comme avant."
      },
      possibles: {
        title: 'Tu as trop de possibles ouverts',
        subtitle: 'Tout t’appelle un peu, donc plus rien ne devient vraiment praticable.',
        color: '#C9A96E',
        icon: '✦',
        text: "Ton premier point de blocage semble venir de l'accumulation de pistes : formations, idées, projets, envies, scénarios, nouvelles voies possibles. Ce n'est pas que rien ne t'intéresse. C'est qu'il y a trop de portes ouvertes en même temps.",
        next: "Le premier tri à faire : déposer toutes les pièces sur la table pour voir ce qui est vivant maintenant, ce qui peut attendre, et ce qui n'a plus besoin de rester ouvert."
      },
      elan: {
        title: 'Ton élan est recouvert par la peur',
        subtitle: 'Ce qui t’appelle existe, mais il se fait vite rattraper par le doute.',
        color: '#1E3A8A',
        icon: '✧',
        text: "Ton premier point de blocage semble venir de l'écart entre ce que tu sens et ce que tu oses suivre. Il y a peut-être un appel, une envie, une direction qui revient souvent, mais elle est aussitôt recouverte par la peur de te tromper, de décevoir, ou de refaire comme avant.",
        next: "Le premier tri à faire : distinguer la voix de ton élan de la voix de la peur, puis chercher un prochain pas assez juste pour être vécu dans ta vraie vie."
      }
    };

    const questions = [
      {
        q: "Quand tu penses à la suite, qu'est-ce qui arrive en premier ?",
        answers: [
          { text: 'J’ai peur de choisir une direction qui ne sera pas la bonne', score: 'garantie', bg: '#CC3DAA' },
          { text: 'Je pense à tout ce que je porte encore pour les autres', score: 'poids', bg: '#2AACCB' },
          { text: 'Je sens mes vieux réflexes revenir : contrôler, prouver, tenir', score: 'ancien', bg: '#D4845A' },
          { text: 'Je vois trop de pistes possibles et je ne sais plus laquelle suivre', score: 'possibles', bg: '#C9A96E' },
          { text: 'Je sens quelque chose qui m’appelle, puis je doute tout de suite', score: 'elan', bg: '#1E3A8A' }
        ]
      },
      {
        q: "Ce qui tourne le plus dans ta tête en ce moment, c'est plutôt...",
        answers: [
          { text: 'Et si je me trompe encore ?', score: 'garantie', bg: '#1E3A8A' },
          { text: 'Ce qui est à moi, ce qui ne l’est pas, ce que je dois rendre', score: 'poids', bg: '#C9A96E' },
          { text: 'Pourquoi je refais encore les mêmes choses ?', score: 'ancien', bg: '#CC3DAA' },
          { text: 'Toutes les formations, idées et projets que j’ai déjà ouverts', score: 'possibles', bg: '#2AACCB' },
          { text: 'Ce que je veux vraiment, mais que je n’ose pas suivre', score: 'elan', bg: '#D4845A' }
        ]
      },
      {
        q: "Quand une idée ou une envie apparaît, qu'est-ce qui se passe le plus souvent ?",
        answers: [
          { text: 'Je veux être sûre avant de bouger', score: 'garantie', bg: '#D4845A' },
          { text: 'Je pense à l’impact que ça aura sur les autres', score: 'poids', bg: '#CC3DAA' },
          { text: 'Je transforme ça en plan, en pression ou en performance', score: 'ancien', bg: '#C9A96E' },
          { text: 'Je l’ajoute à une liste déjà trop longue', score: 'possibles', bg: '#1E3A8A' },
          { text: 'Je la sens juste, puis la peur recouvre tout', score: 'elan', bg: '#2AACCB' }
        ]
      },
      {
        q: "Ce que tu aimerais déposer en premier, ce serait...",
        answers: [
          { text: 'La pression de trouver LA bonne voie', score: 'garantie', bg: '#C9A96E' },
          { text: 'Les responsabilités, attentes ou loyautés qui ne sont plus justes', score: 'poids', bg: '#D4845A' },
          { text: 'Le réflexe de tout sécuriser avant d’avancer', score: 'ancien', bg: '#2AACCB' },
          { text: 'Les 12 pistes gardées pour plus tard', score: 'possibles', bg: '#CC3DAA' },
          { text: 'La peur qui arrive dès que mon élan devient visible', score: 'elan', bg: '#1E3A8A' }
        ]
      },
      {
        q: "La sensation que tu aimerais retrouver, c'est surtout...",
        answers: [
          { text: 'Avancer sans exiger une certitude parfaite', score: 'garantie', bg: '#2AACCB' },
          { text: 'Me sentir à ma place, sans porter celle des autres', score: 'poids', bg: '#1E3A8A' },
          { text: 'Ne plus reconstruire depuis mes anciens mécanismes', score: 'ancien', bg: '#C9A96E' },
          { text: 'Savoir ce qui est vivant maintenant et ce qui peut attendre', score: 'possibles', bg: '#D4845A' },
          { text: 'Sentir mon élan et oser poser un premier pas', score: 'elan', bg: '#CC3DAA' }
        ]
      }
    ];

    let current = 0;
    const scores = { garantie: 0, poids: 0, ancien: 0, possibles: 0, elan: 0 };
    const history = [];

    function startDiagnostic() {
      document.getElementById('intro').classList.add('hidden');
      document.getElementById('quiz').classList.remove('hidden');
      showQuestion(0);
    }

    function showQuestion(index) {
      current = index;
      const question = questions[index];
      const pct = Math.round((index + 1) / questions.length * 100);
      document.getElementById('q-num').textContent = 'Question ' + (index + 1) + '/' + questions.length;
      document.getElementById('q-pct').textContent = pct + '%';
      document.getElementById('progress').style.width = pct + '%';
      document.getElementById('back-btn').classList.toggle('hidden', index === 0);

      document.getElementById('q-box').innerHTML = `
        <div class="fade-in">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Question ${index + 1}</p>
          <h2 class="text-2xl md:text-4xl leading-tight font-normal mb-8">${question.q}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            ${question.answers.map((answer, answerIndex) => `
              <button class="answer-card min-h-[128px] rounded-sm border border-[#1E3A8A]/10 p-5 text-left text-white flex items-end" style="background:${answer.bg}" onclick="pickAnswer(${answerIndex})">
                <span class="text-xl sm:text-2xl leading-tight font-serif" style="text-shadow:0 1px 5px rgba(0,0,0,0.22)">${answer.text}</span>
              </button>
            `).join('')}
          </div>
        </div>`;
    }

    function pickAnswer(answerIndex) {
      const answer = questions[current].answers[answerIndex];
      scores[answer.score] += 1;
      history[current] = answer.score;
      current + 1 < questions.length ? showQuestion(current + 1) : showResult();
    }

    function goBack() {
      if (current <= 0) return;
      const previousIndex = current - 1;
      const previousScore = history[previousIndex];
      if (previousScore) scores[previousScore] -= 1;
      history.splice(previousIndex, 1);
      showQuestion(previousIndex);
    }

    function showResult() {
      const maxScore = Math.max(...Object.values(scores));
      const tiedProfiles = Object.keys(scores).filter(key => scores[key] === maxScore);
      const winner = [...history].reverse().find(key => tiedProfiles.includes(key)) || 'garantie';
      const result = profiles[winner];
      const subject = encodeURIComponent('Mini-diagnostic - ' + result.title);
      const body = encodeURIComponent('Bonjour Caroline,\n\nJ’ai fait le mini-diagnostic et mon résultat est : ' + result.title + '.\n\nJ’aimerais regarder avec toi ce qui brouille ma direction en ce moment.');
      const dmMessage = encodeURIComponent('J’ai fait le mini-diagnostic et mon résultat est : ' + result.title + '. J’aimerais regarder avec toi ce qui brouille ma direction en ce moment.');

      document.getElementById('quiz').classList.add('hidden');
      document.getElementById('result').innerHTML = `
        <div class="fade-in text-center">
          <div class="w-28 h-28 mx-auto mb-6 rounded-full flex items-center justify-center text-5xl text-white shadow-lg" style="background:${result.color}">${result.icon}</div>
          <p class="ui-text text-xs tracking-[0.22em] uppercase mb-2" style="color:${result.color}">Ce qui brouille ta direction</p>
          <h2 class="text-3xl md:text-5xl font-normal mb-3">${result.title}</h2>
          <p class="text-lg text-[#1E3A8A]/70 mb-10 italic">${result.subtitle}</p>

          <div class="text-left max-w-2xl mx-auto space-y-4 mb-10">
            <div class="bg-white border border-[#1E3A8A]/10 rounded-sm p-6">
              <p class="ui-text text-[0.65rem] tracking-[0.18em] uppercase text-[#2AACCB] mb-3">Ce que ça dit de ta direction</p>
              <p class="text-lg text-[#1E3A8A]/80 leading-relaxed">${result.text}</p>
            </div>
            <div class="bg-white border border-[#1E3A8A]/10 rounded-sm p-6">
              <p class="ui-text text-[0.65rem] tracking-[0.18em] uppercase text-[#CC3DAA] mb-3">Le premier tri à regarder</p>
              <p class="text-lg text-[#1E3A8A]/80 leading-relaxed">${result.next}</p>
            </div>
          </div>

          <div class="max-w-2xl mx-auto bg-[#1E3A8A] text-white p-7 md:p-8 rounded-sm mb-8 text-left">
            <p class="ui-text text-[0.65rem] tracking-[0.18em] uppercase text-[#F1D9A7] mb-3">Si tu veux aller plus loin</p>
            <p class="text-xl md:text-2xl leading-snug mb-5">Tu n'as pas besoin d'arriver claire. Tu peux arriver avec le brouillard, les pistes ouvertes, les peurs et ce que tu portes encore.</p>
            <p class="text-white/75 leading-relaxed mb-6">Si tu m'envoies ton résultat, je te réponds avec une première piste pour voir par où commencer le tri.</p>
            <div class="dm-message bg-white/10 border border-white/15 p-4 rounded-sm mb-4 text-white/80 text-sm leading-relaxed">
              J’ai fait le mini-diagnostic et mon résultat est : <strong class="text-white">${result.title}</strong>. J’aimerais regarder avec toi ce qui brouille ma direction en ce moment.
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
              <button onclick="openInstagramDm('${dmMessage}')" class="inline-flex justify-center px-6 py-4 bg-[#CC3DAA] text-white text-xs uppercase tracking-[0.18em] hover:bg-[#D4845A] transition-colors rounded-sm">Copier et ouvrir Instagram</button>
              <a href="mailto:hello@carolineverdier.com?subject=${subject}&body=${body}" class="inline-flex justify-center px-6 py-4 border border-white/30 text-white text-xs uppercase tracking-[0.18em] hover:bg-white hover:text-[#1E3A8A] transition-colors rounded-sm">Par email</a>
              <a href="/zayin/" class="inline-flex justify-center px-6 py-4 border border-white/30 text-white text-xs uppercase tracking-[0.18em] hover:bg-white hover:text-[#1E3A8A] transition-colors rounded-sm">Voir l'accompagnement</a>
            </div>
            <p id="copy-status" class="copy-status text-xs text-white/60 mt-3"></p>
          </div>

          <button onclick="restartDiagnostic()" class="text-xs uppercase tracking-[0.18em] text-[#1E3A8A]/60 hover:text-[#CC3DAA] transition-colors">Refaire le diagnostic</button>
        </div>`;
      document.getElementById('result').classList.remove('hidden');
      document.getElementById('progress').style.width = '100%';
    }

    async function openInstagramDm(encodedMessage) {
      const message = decodeURIComponent(encodedMessage);
      const status = document.getElementById('copy-status');
      try {
        await navigator.clipboard.writeText(message);
        status.textContent = 'Message copié. Ouvre un message Instagram et colle-le à Caroline.';
      } catch (error) {
        status.textContent = 'Instagram va s’ouvrir. Tu peux copier le message affiché juste au-dessus.';
      }
      window.open('https://www.instagram.com/carolineverdier.atelier/', '_blank', 'noopener');
    }

    function restartDiagnostic() {
      current = 0;
      Object.keys(scores).forEach(key => scores[key] = 0);
      history.splice(0, history.length);
      document.getElementById('result').classList.add('hidden');
      document.getElementById('intro').classList.remove('hidden');
    }
  </script>
</body>
</html>
