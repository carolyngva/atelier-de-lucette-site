---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Coaching de relations — L'Atelier de Lucette</title>
    <meta
      name="description"
      content="Accompagnement pour les relations de couple, familiales et professionnelles. Caroline Verdier, certifiée Relationship School, t'aide à voir ce qui se joue entre toi et l'autre."
    />
    <link rel="canonical" href="https://latelierdelucette.com/coaching-de-relations/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="L'Atelier de Lucette" />
    <meta property="og:title" content="Coaching de relations — L'Atelier de Lucette" />
    <meta property="og:description" content="Voir ce qui se joue entre toi et l'autre, et choisir une nouvelle façon d'être en relation." />
    <meta property="og:url" content="https://latelierdelucette.com/coaching-de-relations/" />
    <meta property="og:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Coaching de relations — L'Atelier de Lucette" />
    <meta name="twitter:description" content="Voir ce qui se joue entre toi et l'autre." />
    <meta name="twitter:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": "Coaching de relations",
        "description": "Accompagnement pour les relations de couple, familiales et professionnelles.",
        "author": {
          "@type": "Person",
          "name": "Caroline Verdier",
          "url": "https://latelierdelucette.com/qui-suis-je/"
        },
        "url": "https://latelierdelucette.com/coaching-de-relations/"
      }
    </script>
  </head>

  <body class="selection:bg-[#CC3DAA] selection:text-[#F7F4EE] overflow-x-hidden bg-[#F7F4EE] text-[#1E3A8A]">
    <div class="bg-grain fixed inset-0 pointer-events-none z-0"></div>
    <div class="arch-lines">
      <svg width="100%" height="100%" viewBox="0 0 1440 900" preserveAspectRatio="none">
        <line x1="10%" y1="0" x2="10%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="90%" y1="0" x2="90%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="0" y1="800" x2="1440" y2="360" stroke="#CC3DAA" stroke-width="0.5" opacity="0.5" />
      </svg>
    </div>

    <Nav current="/coaching-de-relations/" />

    <main class="relative z-10">
      <!-- Hero -->
      <header class="min-h-[80vh] flex items-center px-6 pt-28 pb-20">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-flex items-center gap-4 mb-8">
            <div class="h-px w-10 bg-[#2AACCB]"></div>
            <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#1E3A8A]/70">Accompagnement</span>
            <div class="h-px w-10 bg-[#CC3DAA]"></div>
          </div>

          <h1 class="text-5xl md:text-7xl leading-[1.05] font-normal tracking-tight mb-8">
            Coaching de<br />
            <span class="italic text-[#CC3DAA]">relations</span>
          </h1>

          <p class="text-xl md:text-2xl text-[#1E3A8A]/75 max-w-3xl mx-auto leading-relaxed mb-12">
            Voir ce qui se joue entre toi et l'autre. Les schémas, les attentes,
            les blessures et les places — pour choisir une nouvelle façon d'être en relation.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href="#approche" class="inline-flex items-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
              <iconify-icon icon="solar:stars-minimalistic-linear" width="16" height="16" stroke-width="1.5"></iconify-icon>
              Découvrir mon approche
            </a>
          </div>
        </div>
      </header>

      <!-- Pourquoi les relations -->
      <section id="approche" class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Le problème</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">Pourquoi les relations sont si dures ?</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 space-y-6 max-w-3xl mx-auto">
            <p>Parce qu'on n'a pas appris. On a appris à être en couple comme on a vu faire, ou à l'inverse, à ne pas reproduire. On entre en relation avec notre histoire, nos blessures, nos attentes inconscientes — et on croit que l'autre est le problème.</p>
            <p>Mon travail ne consiste pas à "sauver le couple" ou à "trouver le bon partenaire". Il consiste à t'aider à voir les schémas que tu rejoues, les loyautés qui dirigent tes choix, les places que tu occupes — pour que tu puisses choisir, vraiment, la relation que tu veux.</p>
            <p class="text-2xl font-serif italic text-[#CC3DAA]">Les relations ne sont pas le problème. Elles sont le miroir de ce qu'on n'a pas encore vu de nous-mêmes.</p>
          </div>
        </div>
      </section>

      <!-- Mon approche -->
      <section class="py-24 px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Mon approche</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">Une approche systémique des relations</h2>
            <p class="text-lg md:text-xl text-[#1E3A8A]/65 max-w-2xl mx-auto">Formée à la <a href="https://relationshipschool.com" target="_blank" rel="noopener" class="text-[#CC3DAA] underline hover:no-underline">Relationship School</a> (2021), je combine outils concrets et lecture systémique.</p>
          </div>

          <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <span class="text-3xl text-[#CC3DAA] block mb-4">♡</span>
              <h3 class="text-2xl font-normal mb-4">Voir le schéma</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Identifier les boucles relationnelles que tu répètes — en couple, en famille, au travail. Ce n'est pas un hasard, c'est un pattern. Une fois que tu le vois, tu peux choisir d'en sortir.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <span class="text-3xl text-[#2AACCB] block mb-4">∞</span>
              <h3 class="text-2xl font-normal mb-4">Comprendre le système</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Une relation ne se joue pas à deux. Elle se joue avec les familles d'origine, les loyautés invisibles, les places héritées. Je t'aide à voir le système dans son ensemble — pas juste le symptôme.</p>
            </div>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10">
              <span class="text-3xl text-[#C9A96E] block mb-4">✦</span>
              <h3 class="text-2xl font-normal mb-4">Choisir sa place</h3>
              <p class="text-lg leading-relaxed text-[#1E3A8A]/75">Une fois que tu as vu le schéma et compris le système, la question devient : quelle place veux-tu occuper désormais ? Je ne te dis pas quoi faire. Je t'accompagne à choisir en conscience.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Le pouvoir d'être vu -->
      <section class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Le coeur de l'accompagnement</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">Se sentir vu et reconnu</h2>
          </div>
          <div class="text-lg md:text-xl leading-relaxed text-[#1E3A8A]/78 space-y-6 max-w-3xl mx-auto">
            <p>Avant les outils, avant les schémas, avant les solutions — il y a quelque chose de plus simple et de plus rare : le fait d'être vraiment vue. D'être reconnue dans ce que tu vis, sans qu'on te dise "tu devrais" ou "ce n'est pas si grave".</p>
            <p>Dans le coaching de relations comme dans les constellations, ce qui opère d'abord, c'est cette présence. Être accompagnée par quelqu'un qui ne juge pas, qui ne cherche pas à te réparer, mais qui te voit — dans ta complexité, dans tes contradictions, dans ta vérité du moment. Et de cet espace-là, quelque chose peut bouger.</p>
            <p class="text-2xl font-serif italic text-[#CC3DAA]">Ce n'est pas une technique. C'est une qualité de présence. Mais sans elle, aucune technique ne marche.</p>
          </div>
        </div>
      </section>

      <!-- Pour qui -->
      <section class="px-6 py-24 bg-[#1E3A8A] text-[#F7F4EE]">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#C9A96E] mb-6">Pour qui</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">Cet accompagnement est pour toi si...</h2>
          </div>
          <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
            <div class="border-l-2 border-[#CC3DAA] pl-6 py-2">
              <p class="text-lg leading-relaxed text-[#F7F4EE]/85">Tu répètes les mêmes schémas en couple et tu ne comprends pas pourquoi.</p>
            </div>
            <div class="border-l-2 border-[#CC3DAA] pl-6 py-2">
              <p class="text-lg leading-relaxed text-[#F7F4EE]/85">Tu es dans une relation qui te questionne — rester, partir, transformer ?</p>
            </div>
            <div class="border-l-2 border-[#CC3DAA] pl-6 py-2">
              <p class="text-lg leading-relaxed text-[#F7F4EE]/85">Tu veux comprendre l'impact de ton histoire familiale sur tes choix relationnels.</p>
            </div>
            <div class="border-l-2 border-[#CC3DAA] pl-6 py-2">
              <p class="text-lg leading-relaxed text-[#F7F4EE]/85">Tu sens qu'il est temps d'apprendre une autre façon d'être en relation.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="py-28 px-6 bg-[#CC3DAA] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-10"></div>
        <div class="relative z-10 max-w-3xl mx-auto text-center">
          <h2 class="text-4xl md:text-6xl font-serif text-white mb-8 leading-[1.1] tracking-tight">
            Prête à voir ce qui se joue<span class="italic"><br />dans tes relations ?</span>
          </h2>
          <p class="text-lg text-white/90 font-light max-w-2xl mx-auto mb-12 leading-relaxed">
            Que ce soit en individuel ou en constellation, je t'accompagne à voir clair.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href="/qui-suis-je/" class="inline-flex items-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
              <iconify-icon icon="solar:stars-minimalistic-linear" width="16" height="16" stroke-width="1.5"></iconify-icon>
              Découvrir mon approche
            </a>
            <a href="https://carolineverdier.substack.com" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-10 py-5 border border-white/30 text-white text-xs uppercase tracking-[0.2em] hover:bg-white/10 transition-all rounded-sm">
              <iconify-icon icon="solar:letter-linear" width="16" height="16"></iconify-icon>
              Lire la newsletter
            </a>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
