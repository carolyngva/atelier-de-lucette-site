---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const ctaHref = 'https://buy.stripe.com/bJe14n7qafjVbGQ0oN7bW06';

const symptomes = [
  "Tu as tenu trop longtemps. Peut-être jusqu'au burn-out, à la saturation, à la rupture intérieure, ou à ce moment où tu as compris que ton ancien fonctionnement ne pouvait plus continuer.",
  "Aujourd'hui, tu vas mieux. Ou tu commences à aller mieux. Et tu sens que tu as envie de reconstruire.",
  "Mais il y a 1000 dossiers ouverts dans ta tête : ce qui pèse encore, ce qui t'appelle sans être clair, ce que tu portes pour les autres, ce que tu n'oses pas encore choisir.",
  "Dès que tu essaies d'y voir clair, tout se mélange : les possibilités, les peurs, les envies, les anciennes responsabilités, les prochaines étapes.",
  "Tu peux passer une heure à réfléchir à tout ce qui serait possible, et finir encore plus submergée qu'avant.",
  "Tu peux regarder une formation, un accompagnement, une nouvelle piste, alors que tu en as déjà 12 commencés, notés, gardés pour plus tard.",
  "Ce n'est pas que rien ne t'intéresse. C'est qu'il y a trop de possibles ouverts en même temps, et pas assez d'espace pour sentir lequel est vivant maintenant.",
  "Tu as besoin d'un espace pour poser tout ça, faire le tri, écouter différemment, et retrouver ta direction.",
];

const vraieVie = [
  "Ta direction redevient plus claire.",
  "Tu sais mieux distinguer ce qui est à toi, ce qui vient d'une ancienne loyauté, et ce qui ne t'appartient plus.",
  "Tu reconnais les anciens réflexes qui essaient encore de te protéger, sans les laisser décider toute la suite à ta place.",
  "Tu retrouves ton élan intérieur, et l'action redevient possible.",
  "Tu peux choisir un prochain pas sans lui demander d'être valable pour les 20 prochaines années, ni d'être confortable pour tout le monde.",
  "Tu reconstruis depuis un espace plus juste : pas pour prouver, pas pour tenir, pas pour rassurer tout le monde, mais parce que quelque chose en toi redevient vivant.",
];

const possibles = [
  {
    image: '/images/orga-chaos.jpg',
    title: 'Avant',
    text: "Tout est là, quelque part, mais trop de choses vivent encore dans ta tête : les envies, les peurs, les projets possibles, les anciennes charges, les décisions en suspens.",
  },
  {
    image: '/images/retraite-yoga.jpg',
    title: "Ce qui t'appelle peut-être",
    text: "Un nouveau projet, une manière différente de travailler, une envie de créer, de transmettre, de ralentir, de changer de place, ou simplement de revenir à quelque chose de plus vivant en toi.",
  },
  {
    image: '/images/girlboss-focus.jpg',
    title: 'Ce qui redevient possible',
    text: "Avancer sans tout verrouiller. Choisir un prochain pas. Retrouver ton élan intérieur. Reconstruire une suite qui ne te demande pas de redevenir celle qui tenait tout.",
  },
];

const couches = [
  {
    title: 'Déposer ce qui tourne',
    text: "Les pensées, idées, projets, peurs, scénarios, décisions en suspens, envies et choses à ne pas oublier qui restent actives dans ta tête faute d'un endroit fiable où exister.",
  },
  {
    title: "Libérer ce qui ne t'appartient plus",
    text: "Les responsabilités, loyautés, attentes, rôles et poids que tu as peut-être portés par amour, par habitude, par peur de décevoir, ou parce que tu as longtemps été celle qui tient. On regarde aussi ce qui vient des générations d'avant : ce que tu as reçu, repris, prolongé parfois sans le savoir. L'objectif n'est pas de rejeter ton histoire, mais de libérer ce qui n'a plus à passer par toi, pour pouvoir recevoir les cadeaux de ta lignée sans continuer à porter ses fardeaux.",
  },
  {
    title: "Mettre à jour l'ancien système",
    text: "Les croyances, peurs et réflexes qui t'ont aidée à survivre, à tenir, à anticiper ou à rester en sécurité, mais qui ne peuvent plus guider la suite de ta vie.",
  },
  {
    title: "Retrouver ce qui appelle",
    text: "Ce qui revient souvent. Ce qui te donne de l'élan. Ce qui t'intrigue. Ce qui te fait peur aussi, parce que ça demande peut-être une décision, une limite ou un changement.",
  },
  {
    title: 'Reconstruire une suite plus juste',
    text: "Une direction simple, incarnée et praticable. Pas forcément toute la réponse pour les 20 prochaines années, mais un prochain pas qui respecte ton énergie, ton histoire et ce qui est vrai pour toi maintenant.",
  },
];

const croyances = [
  {
    depart: "Je devrais être capable d'avancer maintenant que ça va mieux.",
    arrivee: "Après avoir trop tenu et souffert pour ça, ton système interne ne veut plus se tromper. Il cherche la direction parfaite. Celle qui sera encore vraie dans 20 ans. Trop de pression.",
  },
  {
    depart: "Je suis trop dispersée. Je me juge de ne pas réussir à choisir.",
    arrivee: "Quand trop de choses sont restées ouvertes trop longtemps, ton cerveau essaie de tout garder visible en même temps. Le problème n'est pas ton manque de clarté. C'est l'absence d'un espace où tout peut être posé, trié et remis à sa juste place.",
  },
  {
    depart: "Je ne sais plus ce que je veux.",
    arrivee: "Ce que tu veux vraiment n'est pas si loin. Il est peut-être simplement caché sous ce que tu portes encore, ce qui ne te sert plus, et ce qui ne t'appartient pas.",
  },
  {
    depart: "Je devrais réussir à reconstruire seule.",
    arrivee: "C'est normal. C'est ton ancien fonctionnement : comprendre, porter, avancer, tenir. Mais c'est aussi ce fonctionnement qui t'a menée à devoir reconstruire autrement.",
  },
];

const alternatives = [
  {
    title: 'Comprendre ce que tu as vécu',
    text: "Comprendre peut soulager énormément. Ça remet du sens là où il y avait de la confusion. Mais comprendre ne suffit pas toujours à changer ce qui se rejoue dans ton quotidien, dans tes choix, dans ton corps, dans ta manière de porter ou d'anticiper.",
  },
  {
    title: 'Te reposer, ralentir, prendre soin de toi',
    text: "C'est nécessaire. Et parfois vital. Le repos ne suffit pas toujours à retrouver une direction. Tu peux aller mieux, sans encore savoir quoi reconstruire.",
  },
  {
    title: 'Chercher ta voie',
    text: "Ça peut ouvrir des pistes. Mais ça peut aussi ajouter de la pression, comme s'il fallait trouver la bonne réponse, le bon projet, la bonne version de toi pour les 20 prochaines années.",
  },
  {
    title: "T'organiser autrement",
    text: "Un meilleur agenda, une liste ou un cadre peuvent aider. Mais si ce que tu portes n'a pas été trié, libéré ou remis à sa juste place, tu risques seulement d'organiser ton ancien système un peu mieux.",
  },
  {
    title: 'Travailler sur tes croyances',
    text: "C'est précieux. Mais certaines croyances ne se mettent pas à jour seulement avec des phrases. Elles ont besoin d'être replacées dans ton histoire, ton corps, ton quotidien, et parfois dans ce qui vient de plus loin que toi.",
  },
];

const avantApres = [
  {
    situation: 'Ta tête',
    avant: "Tout se mélange : les envies, les peurs, les idées, les responsabilités, les scénarios et les décisions en suspens.",
    apres: "Tu sais où déposer ce qui tourne, comment le regarder, et quoi en faire sans tout garder ouvert en permanence.",
  },
  {
    situation: 'Ta direction',
    avant: "Tu cherches la bonne réponse, celle qui sera encore vraie dans 20 ans, et cette pression te fige.",
    apres: "Ta direction redevient plus claire, et tu peux choisir un prochain pas sans lui demander de contenir toute ta vie.",
  },
  {
    situation: 'Ce que tu portes',
    avant: "Tu continues à porter des responsabilités, loyautés, attentes ou rôles qui ne t'appartiennent plus vraiment.",
    apres: "Tu distingues ce qui est à toi, ce qui vient d'avant, ce qui peut être rendu, libéré ou remis à sa juste place.",
  },
  {
    situation: 'Tes anciens réflexes',
    avant: "Ton système essaie encore de te protéger comme avant : anticiper, tenir, tout comprendre, tout sécuriser.",
    apres: "Tu reconnais ces réflexes sans les laisser piloter toute la suite. Tu peux mettre à jour ce qui n'a plus besoin de fonctionner comme ça.",
  },
  {
    situation: 'Ton élan',
    avant: "Tu sens peut-être qu'il y a quelque chose qui t'appelle, mais c'est flou, fragile ou aussitôt recouvert par la peur.",
    apres: "Tu retrouves un contact plus clair avec ton élan intérieur, et l'action redevient possible.",
  },
];

const inclus = [
  '5 sessions au total : 4 sessions individuelles sur 1 mois, puis une session de rappel à 1 mois.',
  'Des sessions de 1h à 2h selon le besoin et la matière du moment.',
  'Un support WhatsApp entre les sessions, dans un cadre clair.',
  "Un espace pour déposer tout ce qui tourne, pèse ou appelle, et remettre les choses à leur juste place.",
  "Un temps de constellation ou de travail transgénérationnel pour libérer ce qui ne t'appartient plus.",
  "Un travail sur les peurs, croyances et réflexes de l'ancien système qui continuent peut-être de piloter la suite.",
];

const sessions = [
  {
    title: 'Session 1 · Déposer',
    text: "On sort de ta tête ce qui tourne : pensées, idées, projets, peurs, scénarios, décisions en suspens, envies, responsabilités, tensions et choses à ne pas oublier. Souvent, une première direction commence déjà à apparaître dès cette séance, parce que tout cesse d'être mélangé. Entre les séances, tu repars avec un travail personnel simple pour observer, ressentir ou poser un premier pas dans ta vraie vie.",
  },
  {
    title: 'Session 2 · Trier',
    text: "On distingue ce qui est à toi, ce qui ne l'est pas, ce qui est pour maintenant, ce qui peut attendre, ce qui vient de la peur, ce qui vient de l'élan, et ce qui demande une autre place. La direction qui a commencé à émerger se précise : on regarde ce qui la soutient, ce qui la brouille, et ce qui demande encore à être trié.",
  },
  {
    title: 'Session 3 · Libérer',
    text: "On regarde ce que tu portes par loyauté, par habitude, par amour, par héritage familial ou parce que tu as longtemps été celle qui tient. On libère ce qui ne t'appartient plus, pour recevoir les cadeaux de ton histoire sans continuer à porter ses fardeaux. La direction se confirme à mesure que les anciennes charges perdent leur pouvoir sur tes choix.",
  },
  {
    title: 'Session 4 · Mettre à jour',
    text: "On travaille sur les peurs, croyances et réflexes de l'ancien système : ceux qui t'ont aidée à survivre, anticiper, tenir ou rester en sécurité, mais qui ne peuvent plus guider la suite. On dépasse ce qui te fige encore, sans te forcer à aller plus vite que ton système. La direction devient plus incarnée : pas seulement une idée claire, mais quelque chose que tu peux commencer à vivre.",
  },
  {
    title: 'Session 5 · Revenir et ajuster',
    text: "Un mois plus tard, on revient sur ce qui a bougé : ce qui est devenu plus clair, ce qui résiste encore, ce qui demande à être simplifié, approfondi ou réajusté. On ajuste à partir du réel, parce que la vraie clarté se confirme aussi dans l'expérience. L'objectif : stabiliser le passage à l'action dans ta vraie vie.",
  },
];

const resultats = [
  "Tu sais enfin dans quelle direction avancer, sans avoir besoin que cette direction soit parfaite, définitive ou valable pour les 20 prochaines années.",
  "Tu comprends ce qui te bloquait vraiment : ce qui était à toi, ce qui ne l'était pas, ce qui venait de la peur, de l'ancien système ou d'une loyauté plus ancienne.",
  "Tu as libéré une partie de ce que tu portais sans t'en rendre compte : des rôles, des attentes, des responsabilités ou des héritages qui n'ont plus besoin de guider ta vie.",
  "Tu repars avec un prochain pas clair, concret et praticable, pas seulement avec une prise de conscience de plus.",
  "Tu sens mieux la différence entre ce qui vient de ton élan et ce qui vient de la peur de te tromper, de décevoir ou de recommencer comme avant.",
  "Tu vois mieux les choix, limites ou conversations qui deviennent nécessaires pour que la suite ne repose plus sur ton effacement.",
  "Tu peux repasser à l'action depuis un endroit plus juste : moins en force, moins dans la preuve, moins dans l'urgence de tout sécuriser.",
  "Tu as une manière de revenir à toi quand ça se mélange à nouveau, parce que tu sais mieux déposer, trier, libérer et remettre à jour ce qui prend trop de place.",
  "Tu ne repars pas avec une vie parfaite. Tu repars avec une suite plus claire, plus incarnée, et la sensation profonde que tu peux avancer sans redevenir celle qui tenait tout.",
];

const preuves = [
  "J'ai traversé plusieurs périodes de transition qui m'ont demandé de reconstruire différemment : divorce, licenciement, burn-out.",
  "Mon talent naturel est de faire émerger l'évidence dans ce qui semblait emmêlé : trier, réagencer et rendre les choses plus lisibles.",
  "Mon approche relie le concret et l'invisible : organisation, constellations, intuition, transgénérationnel, croyances et retour à soi.",
];

const deuxMondes = [
  "Le concret : pensées, projets, idées, décisions, priorités, prochaines étapes, organisation et passage à l'action.",
  "L'invisible : loyautés, peurs, croyances, héritages familiaux, rôle de celle qui tient, difficulté à choisir ou à déposer.",
  "Le lien entre les deux : un tri qui ne sert pas à mieux tenir, mais à libérer ce qui pèse pour retrouver une direction plus juste.",
];

const temoignages = [
  "Caroline allie parfaitement l'exigence, la qualité du travail, l'humain, la douceur et la connexion.",
  "Ça permet une transformation globale, pas juste sur les actions ou les résultats, mais aussi sur l'être.",
  "J'ai eu plus de visibilité, plus de clarté sur l'avenir, et je me suis sentie beaucoup plus sereine.",
  "Avec Caroline, j'ai construit un socle solide, presque avec mon âme. Elle est venue chercher à l'intérieur ce qui était important pour moi.",
  "Avant, j'avais du mal à prendre des décisions. Maintenant, quand je décide, j'aime mes décisions et je ne reviens pas dessus.",
  "J'ai ressenti une libération. Je me suis déculpabilisée de beaucoup de choses. Je me suis libérée d'un poids extraordinaire.",
];

const pasPourToi = [
  "Tu cherches une réponse extérieure. Ce n'est pas moi qui sais à ta place.",
  "Tu veux aller très vite sans regarder ce qui te fait peur, ce que tu portes encore, ou ce qui continue de piloter tes choix.",
  "Tu veux seulement parler de ta direction sans toucher au corps, aux croyances, aux loyautés ou à l'histoire plus large dans laquelle elle s'inscrit.",
  "Tu veux qu'on te garantisse une vision parfaite, définitive et verrouillée pour les 20 prochaines années.",
];

const faqs = [
  {
    q: 'Est-ce que tu vas me dire quoi faire ?',
    a: "Non. Ce n'est pas moi qui sais à ta place. Mon rôle est de t'aider à déposer, trier, libérer et écouter autrement, pour que ta propre direction devienne plus claire.",
  },
  {
    q: 'Est-ce que je dois déjà savoir sur quoi je veux travailler ?',
    a: "Non. Tu peux venir avec une sensation floue : je ne peux plus repartir comme avant, je sens qu'il y a quelque chose à changer, je ne sais plus dans quel sens avancer. On part de ce qui est là.",
  },
  {
    q: "Est-ce qu'on va parler uniquement de projet professionnel ?",
    a: "Non. Le projet professionnel peut être un terrain important, parce qu'il cristallise souvent beaucoup de choses : sécurité, identité, argent, reconnaissance, liberté, peur de se tromper. Mais on regarde surtout ce qui demande à retrouver sa juste place dans ta vie.",
  },
  {
    q: "Est-ce que c'est une thérapie ?",
    a: "Non. Ce n'est pas un accompagnement thérapeutique ni médical. On peut toucher à ton histoire, à tes loyautés, à tes croyances, à ce que tu portes, mais l'objectif reste de remettre de l'ordre, de retrouver une direction et de soutenir le passage à l'action.",
  },
  {
    q: "Est-ce qu'il y a une garantie ?",
    a: "Oui. Après la première séance, si tu sens que l'accompagnement n'est pas juste pour toi, on peut arrêter là et tu seras intégralement remboursée. L'idée est que tu puisses t'engager sans te sentir coincée.",
  },
  {
    q: "Pourquoi seulement 5 places ?",
    a: "Parce que c'est la première ouverture de cette nouvelle version. Je veux accompagner chaque personne finement, recueillir des retours précis et construire la suite à partir du réel, pas d'une offre théorique.",
  },
  {
    q: "Et si je découvre que quelque chose doit changer dans ma vie ?",
    a: "C'est possible. Quand on dépose tout sur la table, certaines choses deviennent plus visibles : une limite à poser, une responsabilité à rendre, une croyance à remettre à jour, une décision à laisser mûrir, une direction à suivre. L'accompagnement ne sert pas à te pousser à tout bouleverser. Il sert à voir plus clairement ce qui demande une autre place, à ton rythme.",
  },
];
