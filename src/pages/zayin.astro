---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const ctaHref = 'https://buy.stripe.com/bJe14n7qafjVbGQ0oN7bW06';
const discoveryHref = 'https://calendly.com/carolyn17-v/comment-nous-pourrions-travailler-ensemble';

const pourToi = [
  "tu sens que quelque chose doit changer, mais tu n'arrives pas encore à voir clairement quoi ;",
  'tu tournes en rond dans tes réflexions ;',
  'tu veux lancer un projet ou une activité sans te trahir ;',
  'tu souhaites construire une vie, une relation ou un fonctionnement plus aligné avec qui tu es réellement ;',
  "tu n'as pas besoin que quelqu'un décide à ta place, mais tu aimerais être accompagnée pour retrouver ta propre direction.",
];

const attentes = [
  'Une vision beaucoup plus claire de la situation.',
  'Des décisions plus simples à prendre.',
  "Un plan d'action réaliste.",
  'Davantage de confiance dans ta propre manière de fonctionner.',
  'Le sentiment de ne plus porter tout ça seule.',
];

const inclus = [
  "5 séances d'accompagnement.",
  'Des exercices concrets adaptés à ta situation.',
  'Des outils de réflexion et de prise de décision.',
  "Un espace où tu peux déposer tes idées sans avoir besoin qu'elles soient déjà organisées.",
];

const outils = [
  'questionnement stratégique',
  'exercices concrets',
  'visualisations',
  'constellations systémiques lorsque c\'est pertinent',
  'réflexion commune',
];
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zayin | Accompagnement | L'Atelier de Lucette</title>
    <meta
      name="description"
      content="Zayin est un accompagnement pour construire une vie qui te ressemble vraiment."
    />
    <link rel="canonical" href="https://latelierdelucette.com/zayin/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="L'Atelier de Lucette" />
    <meta property="og:title" content="Zayin | Accompagnement" />
    <meta property="og:description" content="Tu n'as peut-être pas besoin de plus d'informations. Tu as peut-être besoin d'un espace où tout ce que tu sais déjà devient enfin clair." />
    <meta property="og:url" content="https://latelierdelucette.com/zayin/" />
    <meta property="og:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Zayin | Accompagnement" />
    <meta name="twitter:description" content="Un espace pour construire une vie qui te ressemble vraiment." />
    <meta name="twitter:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Zayin",
        "description": "Accompagnement pour faire le tri, retrouver sa direction et remettre du mouvement là où tout semblait bloqué.",
        "provider": {
          "@type": "Organization",
          "name": "L'Atelier de Lucette",
          "url": "https://latelierdelucette.com"
        },
        "url": "https://latelierdelucette.com/zayin/",
        "areaServed": "CH",
        "offers": {
          "@type": "Offer",
          "price": "500",
          "priceCurrency": "CHF",
          "availability": "https://schema.org/LimitedAvailability"
        }
      }
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SNKPGHZL0Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      if (window.location.search.includes('tr=internal')) {
        try { localStorage.setItem('__internal', '1'); } catch(e) {}
      }
      var __int = false;
      try { __int = localStorage.getItem('__internal') === '1'; } catch(e) {}
      gtag('config', 'G-SNKPGHZL0Y', __int ? { 'traffic_type': 'internal' } : {});
    </script>
  </head>

  <body class="selection:bg-[#CC3DAA] selection:text-[#F7F4EE] overflow-x-hidden bg-[#F7F4EE] text-[#1E3A8A]">
    <div class="bg-grain fixed inset-0 pointer-events-none z-0"></div>
    <div class="arch-lines">
      <svg width="100%" height="100%" viewBox="0 0 1440 900" preserveAspectRatio="none">
        <line x1="8%" y1="0" x2="8%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="92%" y1="0" x2="92%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="0" y1="760" x2="1440" y2="310" stroke="#CC3DAA" stroke-width="0.5" opacity="0.45" />
      </svg>
    </div>

    <Nav current="/zayin/" ctaHref={ctaHref} ctaLabel="Réserver" />

    <main class="relative z-10">
      <header class="min-h-screen flex items-center px-6 pt-32 pb-20">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_0.75fr] gap-14 items-center">
          <div>
            <div class="inline-flex items-center gap-4 mb-8">
              <div class="h-px w-10 bg-[#2AACCB]"></div>
              <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#1E3A8A]/70">Accompagnement · 5 séances · 500 CHF</span>
            </div>

            <h1 class="text-5xl md:text-7xl leading-[1.02] font-normal tracking-tight mb-8">
              Zayin<br /><span class="italic text-[#CC3DAA]">Un espace pour construire une vie qui te ressemble vraiment.</span>
            </h1>

            <div class="space-y-6 text-2xl md:text-3xl leading-tight text-[#1E3A8A]/85 mb-10 max-w-3xl">
              <p class="italic">Tu n'as peut-être pas besoin de plus d'informations.</p>
              <p>Tu as peut-être besoin d'un espace où tout ce que tu sais déjà devient enfin clair.</p>
            </div>

            <div class="space-y-5 text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/78 max-w-2xl mb-10">
              <p>C'est ce que je fais.</p>
              <p>Je ne te donne pas une vie toute faite.</p>
              <p>Je t'aide à retrouver la tienne.</p>
            </div>

            <div class="flex flex-col sm:flex-row gap-5">
              <a href={ctaHref} class="inline-flex items-center justify-center gap-3 bg-[#CC3DAA] text-[#F7F4EE] ui-text text-xs tracking-[0.18em] uppercase px-9 py-4 rounded-sm hover:bg-[#D4845A] transition-colors">
                <iconify-icon icon="solar:letter-linear" width="15" height="15"></iconify-icon>
                Réserver mon accompagnement
              </a>
              <a href={discoveryHref} class="inline-flex items-center justify-center gap-3 border border-[#1E3A8A]/25 text-[#1E3A8A] ui-text text-xs tracking-[0.18em] uppercase px-9 py-4 rounded-sm hover:border-[#CC3DAA] hover:text-[#CC3DAA] transition-colors">
                Vérifier si c'est juste
              </a>
            </div>
          </div>

          <aside class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10 shadow-xl shadow-[#1E3A8A]/5 relative overflow-hidden">
            <div class="absolute -top-20 -right-20 w-52 h-52 rounded-full bg-[#F1D9A7]/50 blur-2xl"></div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Le mouvement</p>
            <p class="text-3xl md:text-4xl italic leading-tight text-[#1E3A8A] mb-8 relative z-10">
              Ensemble, nous faisons le tri.
            </p>
            <div class="space-y-4 text-xl leading-relaxed text-[#1E3A8A]/78 relative z-10">
              <p>Nous mettons des mots.</p>
              <p>Nous créons un système qui te ressemble.</p>
              <p>Et surtout, nous remettons le mouvement en route.</p>
            </div>
          </aside>
        </div>
      </header>

      <section class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-5xl mx-auto grid lg:grid-cols-[0.8fr_1.2fr] gap-14 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6">Pour qui</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">J'aime travailler avec des personnes qui tournent en rond.</h2>
          </div>

          <div class="space-y-6 text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/78">
            <p>Pas parce qu'elles manquent d'intelligence.</p>
            <p>Au contraire.</p>
            <p>Elles ont souvent beaucoup d'idées, beaucoup d'intuition, beaucoup de possibilités.</p>
            <p>Mais tout est mélangé.</p>
            <p>Alors elles repoussent une décision. Hésitent. Cherchent encore un livre, une stratégie, une certitude.</p>
          </div>
        </div>
      </section>

      <section class="px-6 py-24">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-14 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">C'est pour toi si</p>
            <div class="space-y-4">
              {pourToi.map((item) => (
                <div class="flex gap-4 bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-5">
                  <span class="text-[#CC3DAA]">✦</span>
                  <p class="text-xl leading-relaxed text-[#1E3A8A]/78">{item}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="bg-[#1E3A8A] text-[#F7F4EE] rounded-sm p-8 md:p-10 lg:sticky lg:top-28">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#F1D9A7] mb-6">Ce que nous faisons ensemble</p>
            <p class="text-3xl md:text-4xl italic leading-tight mb-8">Je ne viens pas t'apporter une réponse toute faite.</p>
            <div class="space-y-5 text-xl md:text-2xl leading-relaxed text-white/85">
              <p>Je t'aide à retrouver les tiennes.</p>
              <p>Pendant cinq séances, nous clarifions ce qui est important pour toi, nous mettons des mots sur ce que tu ressens déjà, nous construisons un système qui te ressemble et nous transformons cette clarté en mouvement.</p>
              <p>Je travaille aussi bien sur des sujets de vie personnelle, de couple que de business.</p>
              <p>Le sujet change.</p>
              <p>Le processus reste le même.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="px-6 py-24">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.8fr_1.2fr] gap-14 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6">Ce que tu peux attendre</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Tu repartiras souvent avec quelque chose de plus simple.</h2>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            {attentes.map((item) => (
              <div class="flex gap-4 bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-5">
                <span class="text-[#2AACCB]">✓</span>
                <p class="text-xl leading-relaxed text-[#1E3A8A]/78">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="px-6 py-24 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.8fr_1.2fr] gap-14 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6">Déroulé</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">5 séances d'accompagnement.</h2>
            <p class="text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/75">Pourquoi cinq ? Parce qu'une seule séance peut ouvrir quelque chose, mais elle ne suffit pas toujours à l'ancrer.</p>
          </div>

          <div class="space-y-6 text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/78">
            <p>Entre les séances, tu expérimentes.</p>
            <p>Tu avances.</p>
            <p>Tu observes.</p>
            <p>Puis nous ajustons ensemble.</p>
            <p>C'est ce qui permet à la transformation de s'installer dans ta vraie vie, pas seulement dans une prise de conscience.</p>

            <div class="grid sm:grid-cols-2 gap-4 pt-6">
              {inclus.map((item) => (
                <p class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-5 text-xl leading-relaxed text-[#1E3A8A]/78">{item}</p>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="px-6 py-24">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.95fr_1.05fr] gap-14 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Ma manière d'accompagner</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Je ne suis pas attachée à une méthode.</h2>
            <p class="text-3xl md:text-4xl italic leading-tight text-[#CC3DAA]">Je suis attachée à ce qui crée du mouvement.</p>
          </div>

          <div class="space-y-6 text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/78">
            <p>Je combine différents outils selon ce qui est le plus pertinent pour toi.</p>
            <div class="flex flex-wrap gap-3">
              {outils.map((outil) => (
                <span class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-full px-5 py-3 text-lg text-[#1E3A8A]/75">{outil}</span>
              ))}
            </div>
            <p>Je ne choisis jamais un outil parce que c'est ma méthode. Je choisis celui qui aidera le mieux à débloquer la situation que tu vis.</p>
            <p>Mais mon principal outil reste notre réflexion commune.</p>
            <p>Je t'aide à voir les liens, les angles morts, les contradictions et les possibilités que tu ne voyais pas encore.</p>
            <p>Mon rôle n'est pas de penser à ta place. Mon rôle est de rendre ta pensée plus claire.</p>
          </div>
        </div>
      </section>

      <section class="px-6 py-24 bg-[#1E3A8A] text-[#F7F4EE] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-10"></div>
        <div class="relative z-10 max-w-5xl mx-auto grid lg:grid-cols-[0.8fr_1.2fr] gap-14 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#F1D9A7] mb-6">Tarif</p>
            <p class="text-6xl md:text-7xl font-serif text-[#F1D9A7] mb-4">500 CHF</p>
            <p class="text-xl leading-relaxed text-white/75">Le tarif comprend les 5 séances de l'accompagnement.</p>
          </div>

          <div class="space-y-6 text-xl md:text-2xl leading-relaxed text-white/85">
            <p>Si tu sais déjà que tu veux commencer, tu peux réserver ton accompagnement.</p>
            <p>Si tu préfères vérifier ensemble que c'est le bon moment et que je suis la bonne personne pour t'accompagner, tu peux m'écrire pour un appel découverte gratuit.</p>
            <p>L'objectif de cet appel n'est pas de te convaincre.</p>
            <p>C'est de voir si nous avons envie de travailler ensemble.</p>

            <div class="flex flex-col sm:flex-row gap-5 pt-4">
              <a href={ctaHref} class="inline-flex items-center justify-center gap-3 bg-[#CC3DAA] text-[#F7F4EE] ui-text text-xs tracking-[0.18em] uppercase px-9 py-4 rounded-sm hover:bg-[#D4845A] transition-colors">
                <iconify-icon icon="solar:letter-linear" width="15" height="15"></iconify-icon>
                Réserver mon accompagnement
              </a>
              <a href={discoveryHref} class="inline-flex items-center justify-center gap-3 border border-white/25 text-white ui-text text-xs tracking-[0.18em] uppercase px-9 py-4 rounded-sm hover:border-[#F1D9A7] hover:text-[#F1D9A7] transition-colors">
                Demander un appel découverte
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
