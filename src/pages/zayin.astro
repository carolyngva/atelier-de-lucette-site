---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const ctaHref = 'https://buy.stripe.com/bJe14n7qafjVbGQ0oN7bW06';

const heroItems = [
  'Les pensées.',
  'Les responsabilités.',
  'Les décisions en attente.',
  'Les scénarios.',
  'Les attentes des autres.',
  "Les projets qui t'appellent.",
  "Les peurs qui se réveillent dès qu'une piste devient sérieuse.",
];

const agendaInvisible = [
  'Tout ce que tu prévois.',
  'Tout ce que tu surveilles.',
  'Tout ce que tu gardes en mémoire.',
  'Tout ce que tu portes pour que les choses ne tombent pas.',
];

const remiseOrdre = [
  {
    title: 'Ce qui tourne',
    items: ['Les pensées en boucle.', 'Les décisions en suspens.', 'Les scénarios.', 'Les idées commencées.', 'Les projets qui reviennent.', 'Les choses à ne pas oublier.'],
    text: "On sort de ta tête ce qui n'a plus besoin d'y tourner en permanence.",
  },
  {
    title: 'Ce qui pèse',
    items: ['Les responsabilités prises par défaut.', 'Les attentes.', 'Les culpabilités.', 'Les loyautés.', 'Les rôles anciens.', 'La charge émotionnelle des autres.'],
    text: "On distingue ce qui t'appartient vraiment de ce qui s'est posé sur toi.",
  },
  {
    title: 'Ce qui appelle',
    items: ['Une envie.', 'Un projet.', 'Une limite.', 'Une conversation.', 'Une autre manière de travailler.', 'Une vie plus respirable.', "Une décision que tu repousses parce qu'elle changerait quelque chose."],
    text: "On crée assez de calme pour que tu puisses l'entendre sans te mettre la pression.",
  },
];

const imagine = [
  'Te réveiller un lundi sans sentir immédiatement le poids de tout ce que tu dois porter.',
  "Ouvrir ton ordinateur sans cette sensation de dette intérieure envers tous les projets en attente.",
  "Regarder ton agenda sans avoir l'impression que ta semaine est déjà en train de te prendre.",
  'Boire ton café et rester là, vraiment là.',
  "Avoir une heure libre sans la remplir avant même qu'elle commence.",
  "Sentir qu'une demande ne t'appartient pas avant de la prendre dans ta tête.",
  "Penser à un projet sans devoir immédiatement savoir s'il est valable pour les 20 prochaines années.",
  'Aimer les autres sans garder toute leur vie dans ton cerveau.',
];

const apres = [
  'Tu ne repars pas avec une vie parfaite.',
  'Tu repars avec une tête plus respirable.',
  'Tu sais mieux quoi poser, quoi garder, quoi rendre, quoi déplacer.',
  'Tu reconnais les anciens réflexes qui veulent encore tout sécuriser.',
  "Tu sens plus vite quand tu es en train de porter ce qui n'est pas à toi.",
  'Tu peux te poser et être vraiment là.',
  "Tu peux revenir à toi quand ça recommence à se mélanger.",
  "Tu n'as plus besoin que chaque décision contienne toute ta vie.",
  "Et peu à peu, ta direction cesse d'être une réponse à trouver. Elle devient quelque chose que tu peux entendre.",
];

const experiences = [
  'Ta tête.',
  'Ton agenda invisible.',
  'Tes responsabilités.',
  'Tes peurs.',
  'Tes élans.',
  'Tes loyautés.',
  'Tes anciennes manières de tenir.',
  'Ce qui revient encore et encore.',
  'Ce qui demande une autre place.',
];

const passages = [
  {
    title: '1. Déposer',
    text: "On sort la matière de ta tête. Pas joliment. Pas parfaitement. Pas dans le bon ordre. On pose ce qui tourne, ce qui fatigue, ce qui revient, ce que tu repousses, ce que tu n'oses pas regarder.",
    example: "Concrètement, cela peut vouloir dire poser sur la table les projets ouverts, les décisions en attente, les conversations évitées, les responsabilités invisibles, les 'il faut que je pense à...' qui tournent en arrière-plan.",
  },
  {
    title: '2. Distinguer',
    text: "On sépare ce qui est à toi, ce qui ne l'est pas, ce qui est pour maintenant, ce qui peut attendre, ce qui vient de la peur, ce qui vient de l'élan, et ce qui vient d'un ancien rôle.",
    example: "Une tâche peut sembler pratique, alors qu'elle porte en réalité une peur de décevoir. Une envie peut sembler floue, alors qu'elle revient depuis des mois. Une responsabilité peut sembler normale, alors qu'elle ne devrait plus reposer uniquement sur toi.",
  },
  {
    title: '3. Libérer',
    text: "On regarde les charges invisibles : les loyautés, les héritages, les attentes, les places prises trop tôt ou trop longtemps, les responsabilités qui se sont installées comme si elles étaient naturelles.",
    example: "On peut travailler avec des constellations, du transgénérationnel, des images, des phrases, des ressentis corporels, selon ce qui se présente. L'objectif n'est pas de rejeter ton histoire. L'objectif est de ne plus la laisser décider à ta place.",
  },
  {
    title: '4. Entendre',
    text: "Quand il y a moins de choses ouvertes, ce qui appelle devient plus perceptible : un projet, un choix, une limite, une envie, un changement de rythme, une conversation, une décision.",
    example: "On ne force pas la direction. On crée les conditions pour qu'elle devienne évidente. Pas forcément définitive. Mais assez claire pour avancer.",
  },
  {
    title: '5. Ajuster',
    text: "Un mois plus tard, on revient au réel : ce qui a bougé, ce qui s'est confirmé, ce qui résiste, ce qui demande encore à être simplifié, ce qui devient possible maintenant que tu n'es plus exactement au même endroit.",
    example: "La clarté se vérifie dans la vie. Cette dernière session sert à ajuster, stabiliser et éviter que l'ancien système reprenne toute la place.",
  },
];

const inclus = [
  '5 sessions individuelles.',
  '4 sessions sur 1 mois.',
  '1 session de rappel un mois plus tard.',
  'Des sessions de 1h à 2h selon la matière.',
  'Un support WhatsApp entre les séances.',
  'Un travail de tri mental, concret, émotionnel et symbolique.',
  'Un temps de constellation ou de travail transgénérationnel.',
  'Un travail sur les peurs, croyances et anciens réflexes.',
  'Un prochain pas clair, incarné et praticable.',
];

const pourToi = [
  'Tu as trop tenu.',
  "Tu as vécu une saturation, une transition, une rupture intérieure, ou ce moment où tu sens que tu ne veux plus attendre de craquer pour changer quelque chose.",
  'Tu sens que ta tête reste pleine même quand ton agenda se vide.',
  "Tu as parfois du temps pour toi, mais tu n'arrives pas à l'habiter.",
  "Tu portes des choses qui ne devraient peut-être plus être à toi.",
  'Tu as beaucoup compris, mais ta vie concrète reste trop serrée.',
  "Tu veux entendre ce qui t'appelle sans te forcer à trouver immédiatement la bonne réponse.",
  "Tu veux reconstruire sans recréer une version plus douce du même épuisement.",
];

const pasPourToi = [
  "Tu veux qu'on te dise quoi faire.",
  "Tu cherches une méthode d'organisation purement pratique.",
  'Tu veux une réponse définitive pour les 20 prochaines années.',
  'Tu es en situation de burn-out aigu ou de détresse psychique nécessitant un suivi médical ou thérapeutique prioritaire.',
  'Tu veux aller vite sans regarder ce que tu continues à porter.',
];

const temoignages = [
  "Caroline allie parfaitement l'exigence, la qualité du travail, l'humain, la douceur et la connexion.",
  "Ça permet une transformation globale, pas juste sur les actions ou les résultats, mais aussi sur l'être.",
  "J'ai eu plus de visibilité, plus de clarté sur l'avenir, et je me suis sentie beaucoup plus sereine.",
  "Avec Caroline, j'ai construit un socle solide, presque avec mon âme. Elle est venue chercher à l'intérieur ce qui était important pour moi.",
  "Avant, j'avais du mal à prendre des décisions. Maintenant, quand je décide, j'aime mes décisions et je ne reviens pas dessus.",
  "J'ai ressenti une libération. Je me suis déculpabilisée de beaucoup de choses. Je me suis libérée d'un poids extraordinaire.",
];

const faqs = [
  {
    q: 'Est-ce que je dois déjà savoir ce que je veux travailler ?',
    a: "Non. Tu peux venir avec une sensation floue : je suis saturée, je ne peux plus repartir comme avant, je sens qu'il y a quelque chose à changer, mais je ne sais pas encore quoi. On part de ce qui est là.",
  },
  {
    q: 'Est-ce que tu vas me dire quoi faire ?',
    a: "Non. Je ne prends pas la place de ta boussole intérieure. Je t'aide à retirer ce qui fait trop de bruit autour d'elle.",
  },
  {
    q: "Est-ce qu'on va parler seulement du professionnel ?",
    a: "Non. Le professionnel peut être présent, parce qu'il touche souvent à l'identité, au rythme, à l'argent, à la sécurité et à la reconnaissance. Mais Zayin regarde la vie comme un système entier : corps, relations, projets, loyautés, fatigue, envies, décisions, place intérieure.",
  },
  {
    q: "Est-ce que c'est une thérapie ?",
    a: "Non. Zayin n'est pas une thérapie ni un suivi médical. On peut toucher à ton histoire, à tes loyautés, à tes croyances et à ce que tu portes, mais l'objectif reste de remettre de l'ordre, retrouver de l'écoute intérieure et soutenir une suite plus juste.",
  },
  {
    q: 'Et si je manque déjà de temps ?',
    a: "Alors attendre d'avoir plus de temps risque de ne pas suffire. Parce que le problème n'est peut-être pas seulement ton agenda. C'est ce qui continue d'occuper ta tête, même quand un créneau se libère.",
  },
  {
    q: "Est-ce que c'est seulement pour les femmes après un burn-out ?",
    a: "Non. Zayin peut être juste après un burn-out, mais aussi avant. Pour les femmes qui sentent qu'elles ont trop tenu. Ou qui voient qu'elles sont en train de se perdre dans la gestion, l'anticipation, la charge mentale, les responsabilités, les projets et les attentes. Tu n'as pas besoin d'attendre l'effondrement pour remettre de l'ordre à l'intérieur.",
  },
  {
    q: "Est-ce qu'il y a une garantie ?",
    a: "Oui. Après la première séance, si tu sens que l'accompagnement n'est pas juste pour toi, on peut s'arrêter là et tu seras intégralement remboursée. Tu peux t'engager sans te sentir coincée.",
  },
];
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zayin | Remise en ordre intérieure | L'Atelier de Lucette</title>
    <meta
      name="description"
      content="Zayin est une expérience de remise en ordre intérieure pour les femmes qui portent trop dans leur tête et veulent retrouver assez de place en elles pour pouvoir enfin s'entendre."
    />
    <link rel="canonical" href="https://latelierdelucette.com/zayin/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="L'Atelier de Lucette" />
    <meta property="og:title" content="Zayin | Remise en ordre intérieure" />
    <meta property="og:description" content="Une expérience de remise en ordre intérieure pour retrouver assez de place en toi et pouvoir enfin t'entendre." />
    <meta property="og:url" content="https://latelierdelucette.com/zayin/" />
    <meta property="og:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Zayin | Remise en ordre intérieure" />
    <meta name="twitter:description" content="Pour retrouver assez de place en toi et pouvoir enfin t'entendre." />
    <meta name="twitter:image" content="https://latelierdelucette.com/images/portrait-caroline.png" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Special+Elite&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js"></script>
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Service",
        "name": "Zayin",
        "description": "Une expérience de remise en ordre intérieure pour les femmes qui portent trop dans leur tête et veulent retrouver assez de place en elles pour pouvoir enfin s'entendre.",
        "provider": {
          "@type": "Organization",
          "name": "L'Atelier de Lucette",
          "url": "https://latelierdelucette.com"
        },
        "url": "https://latelierdelucette.com/zayin/",
        "areaServed": "CH",
        "offers": {
          "@type": "Offer",
          "price": "500",
          "priceCurrency": "CHF",
          "availability": "https://schema.org/LimitedAvailability"
        }
      }
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SNKPGHZL0Y"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      if (window.location.search.includes('tr=internal')) {
        try { localStorage.setItem('__internal', '1'); } catch(e) {}
      }
      var __int = false;
      try { __int = localStorage.getItem('__internal') === '1'; } catch(e) {}
      gtag('config', 'G-SNKPGHZL0Y', __int ? { 'traffic_type': 'internal' } : {});
    </script>
  </head>

  <body class="selection:bg-[#CC3DAA] selection:text-[#F7F4EE] overflow-x-hidden bg-[#F7F4EE] text-[#1E3A8A]">
    <div class="bg-grain fixed inset-0 pointer-events-none z-0"></div>
    <div class="arch-lines">
      <svg width="100%" height="100%" viewBox="0 0 1440 900" preserveAspectRatio="none">
        <line x1="8%" y1="0" x2="8%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="92%" y1="0" x2="92%" y2="100%" stroke="#1E3A8A" stroke-width="0.5" />
        <line x1="0" y1="760" x2="1440" y2="310" stroke="#CC3DAA" stroke-width="0.5" opacity="0.45" />
      </svg>
    </div>

    <Nav current="/zayin/" ctaHref={ctaHref} ctaLabel="Oui. C'est le moment." />

    <main class="relative z-10">
      <header class="min-h-screen flex items-center px-6 pt-32 pb-20">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_0.9fr] gap-14 items-center">
          <div>
            <div class="inline-flex items-center gap-4 mb-8">
              <div class="h-px w-10 bg-[#2AACCB]"></div>
              <span class="ui-text text-xs tracking-[0.22em] uppercase text-[#1E3A8A]/70">5 places · offre de lancement · 500 CHF</span>
            </div>

            <h1 class="text-5xl md:text-7xl leading-[1.02] font-normal tracking-tight mb-8">
              Zayin<br /><span class="italic text-[#CC3DAA]">Une expérience de remise en ordre intérieure.</span>
            </h1>

            <p class="text-2xl md:text-3xl italic leading-tight text-[#1E3A8A]/85 mb-8 max-w-3xl">
              Pour retrouver assez de place en toi afin de pouvoir enfin t'entendre.
            </p>

            <p class="text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/78 max-w-2xl mb-10">
              Quand tout réclame ton attention en même temps, il devient presque impossible de savoir ce qui est vraiment à toi.
            </p>

            <div class="grid sm:grid-cols-2 gap-3 mb-10 max-w-2xl">
              {heroItems.map((item) => (
                <p class="bg-[#FFFCF6]/80 border border-[#1E3A8A]/10 rounded-sm px-4 py-3 text-lg leading-relaxed text-[#1E3A8A]/78">{item}</p>
              ))}
            </div>

            <div class="space-y-5 text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/82 max-w-2xl mb-10">
              <p>Alors tu peux te croire perdue.</p>
              <p>Mais tu ne manques pas forcément de clarté.</p>
              <p>Tu essaies peut-être simplement d'entendre ta propre voix au milieu de tout ce que tu portes encore.</p>
            </div>

            <p class="text-xl leading-relaxed text-[#1E3A8A]/78 max-w-2xl mb-10">
              Zayin est une expérience de remise en ordre intérieure pour les femmes qui ont trop tenu, ou qui sentent qu'elles ne veulent plus attendre d'en arriver là.
            </p>

            <div class="flex flex-col sm:flex-row gap-5">
              <a href={ctaHref} class="inline-flex items-center justify-center gap-3 bg-[#CC3DAA] text-[#F7F4EE] ui-text text-xs tracking-[0.18em] uppercase px-9 py-4 rounded-sm hover:bg-[#D4845A] transition-colors">
                <iconify-icon icon="solar:letter-linear" width="15" height="15"></iconify-icon>
                Oui. C'est le moment.
              </a>
              <a href="#experience" class="inline-flex items-center justify-center gap-3 border border-[#1E3A8A]/25 text-[#1E3A8A] ui-text text-xs tracking-[0.18em] uppercase px-9 py-4 rounded-sm hover:border-[#CC3DAA] hover:text-[#CC3DAA] transition-colors">
                Voir l'expérience
              </a>
            </div>
          </div>

          <aside class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10 shadow-xl shadow-[#1E3A8A]/5 relative overflow-hidden">
            <div class="absolute -top-20 -right-20 w-52 h-52 rounded-full bg-[#F1D9A7]/50 blur-2xl"></div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Signature</p>
            <p class="text-3xl md:text-4xl italic leading-tight text-[#1E3A8A] mb-8 relative z-10">
              Mon travail, c'est la remise en ordre intérieure.
            </p>
            <div class="h-px bg-[#1E3A8A]/15 my-8"></div>
            <p class="text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/78 relative z-10">
              Pour les femmes qui portent trop dans leur tête et n'arrivent plus à s'entendre malgré tout ce qu'elles ont déjà essayé.
            </p>
          </aside>
        </div>
      </header>

      <section class="px-6 py-28 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-5xl mx-auto text-center">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-8">Le point de départ</p>
          <h2 class="text-5xl md:text-7xl leading-tight font-normal mb-10">Tu as parfois du temps.</h2>
          <h2 class="text-5xl md:text-7xl leading-tight font-normal italic text-[#CC3DAA] mb-14">Mais tu n'es pas dedans.</h2>

          <div class="max-w-3xl mx-auto space-y-5 text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/78 text-left">
            <p>Tu ouvres ton agenda et ton corps se contracte.</p>
            <p>Tu as une heure libre, mais elle arrive quand tu es déjà trop vidée pour en faire quelque chose.</p>
            <p>Tu prends un café seule, et tu es déjà partie dans la suite.</p>
            <p>Tu t'allonges, mais ta tête continue.</p>
            <p>Tu écris une liste, elle te soulage dix minutes, puis tout revient.</p>
          </div>

          <div class="max-w-3xl mx-auto mt-16 bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10 text-left">
            <h3 class="text-3xl md:text-4xl font-normal mb-6">Ce n'est pas seulement ton agenda qui est plein.</h3>
            <p class="text-3xl md:text-5xl italic text-[#CC3DAA] leading-tight mb-8">C'est ton agenda invisible.</p>
            <div class="grid sm:grid-cols-2 gap-4">
              {agendaInvisible.map((item) => (
                <p class="text-xl leading-relaxed text-[#1E3A8A]/78 border-l-2 border-[#2AACCB] pl-4">{item}</p>
              ))}
            </div>
            <p class="text-2xl italic leading-tight text-[#1E3A8A] mt-8">Même ce qui n'est pas écrit prend de la place.</p>
          </div>
        </div>
      </section>

      <section class="px-6 py-28">
        <div class="max-w-5xl mx-auto grid lg:grid-cols-[0.9fr_1.1fr] gap-14 items-start">
          <div class="lg:sticky lg:top-28">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6">Le vrai problème</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Ce n'est pas seulement de la fatigue.</h2>
            <p class="text-2xl italic leading-tight text-[#CC3DAA] mb-8">C'est cette impression que rien, à l'intérieur, n'accepte enfin de se poser.</p>
          </div>

          <div class="space-y-6 text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/78">
            <p>Tu repousses ce qui compte vraiment à un futur moment imaginaire :</p>
            <div class="grid sm:grid-cols-2 gap-4">
              {['quand ce sera plus calme', "quand j'aurai fini ça", "quand j'aurai récupéré", "quand j'aurai une vraie journée devant moi"].map((item) => (
                <p class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-5 italic text-[#1E3A8A]">{item}</p>
              ))}
            </div>
            <p>Mais ce moment ne vient pas.</p>
            <p>Ou quand il vient, tu es trop épuisée pour l'habiter.</p>
            <p>Alors tu continues à tenir.</p>
            <p>Plus doucement qu'avant, peut-être.</p>
            <p>Mais encore depuis le même système.</p>
          </div>
        </div>
      </section>

      <section class="px-6 py-28 bg-[#1E3A8A] text-[#F7F4EE] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-10"></div>
        <div class="relative z-10 max-w-5xl mx-auto text-center">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#F1D9A7] mb-8">Le déplacement</p>
          <h2 class="text-4xl md:text-6xl leading-tight font-normal mb-10">Le vrai problème n'est pas que tu n'as pas de direction.</h2>
          <div class="max-w-3xl mx-auto space-y-6 text-xl md:text-2xl leading-relaxed text-white/85">
            <p>Le vrai problème, c'est que tout prend trop de place pour que tu puisses l'entendre.</p>
            <p>Tu peux chercher ta voie, lire, te faire accompagner, écrire, méditer, alléger ton agenda, changer d'organisation, prendre du temps pour toi.</p>
            <p>Mais si ta tête reste occupée par tout ce que tu portes, ta propre voix ne peut pas remonter clairement.</p>
            <p>Elle est là, peut-être.</p>
            <p>Mais elle est couverte par ce qui réclame ton attention.</p>
            <p class="text-3xl md:text-4xl italic leading-tight text-[#F1D9A7]">Zayin sert à faire assez de place pour que tu puisses à nouveau t'entendre.</p>
          </div>
        </div>
      </section>

      <section class="px-6 py-28 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.9fr_1.1fr] gap-14 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Caroline</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Mon travail, c'est la remise en ordre intérieure.</h2>
            <img src="/images/caro-2026.jpg" alt="Portrait de Caroline Verdier" class="w-full h-auto rounded-sm border border-[#1E3A8A]/10 shadow-xl shadow-[#1E3A8A]/10" loading="lazy" />
          </div>

          <div class="space-y-6 text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/78">
            <p>Depuis des années, j'accompagne des femmes qui pensent chercher une direction, une meilleure organisation ou une nouvelle étape de vie.</p>
            <p>Mais très souvent, sous la demande visible, il y a autre chose.</p>
            <p>Elles ne sont pas perdues parce qu'elles ne savent rien.</p>
            <p>Elles sont saturées parce qu'elles portent trop.</p>
            <div class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-7 space-y-4 text-[#1E3A8A]">
              <p>Trop de responsabilités.</p>
              <p>Trop d'anticipation.</p>
              <p>Trop de choses pas si graves qui restent dans leur tête.</p>
              <p>Trop de rôles pris par amour, par habitude, par loyauté ou par peur de décevoir.</p>
            </div>
            <div class="bg-[#CC3DAA] text-white rounded-sm p-7 space-y-5">
              <p class="ui-text text-xs tracking-[0.22em] uppercase text-white/70">Ce que les femmes me disent souvent</p>
              <p class="text-3xl italic leading-tight">Je suis arrivée avec une sensation de chaos.</p>
              <p class="text-3xl italic leading-tight">Tu as vu un fil que je ne voyais plus.</p>
            </div>
            <p>C'est exactement ça, mon travail.</p>
            <p>Entrer dans une matière confuse, dense, émotionnelle, pratique, symbolique, et faire apparaître ce qui était caché dans le désordre.</p>
            <p>La structure. La logique. La loyauté. Le poids. La peur. L'élan. La chose qui demande une autre place.</p>
            <p>J'ai dû apprendre ça dans ma propre vie aussi, après un divorce, une saturation, un licenciement, un burn-out, et plusieurs moments où mon ancien fonctionnement ne pouvait plus continuer.</p>
          </div>
        </div>
      </section>

      <section class="px-6 py-28">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6">Le territoire</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Ce que la remise en ordre intérieure remet à sa place.</h2>
          </div>

          <div class="grid lg:grid-cols-3 gap-6">
            {remiseOrdre.map((bloc) => (
              <article class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-7 shadow-lg shadow-[#1E3A8A]/5">
                <h3 class="text-3xl font-normal text-[#CC3DAA] mb-6">{bloc.title}</h3>
                <div class="space-y-3 mb-7">
                  {bloc.items.map((item) => (
                    <p class="text-lg leading-relaxed text-[#1E3A8A]/75">{item}</p>
                  ))}
                </div>
                <p class="text-xl leading-relaxed text-[#1E3A8A] border-t border-[#1E3A8A]/10 pt-6">{bloc.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="px-6 py-28 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-4xl mx-auto text-center">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-8">Pourquoi Zayin existe</p>
          <div class="space-y-8 text-3xl md:text-5xl leading-tight font-serif text-[#1E3A8A]">
            <p>Parce qu'un agenda ne peut pas porter une loyauté.</p>
            <p>Parce qu'une to-do list ne sait pas quoi faire d'une peur de décevoir.</p>
            <p>Parce qu'un week-end libre ne repose pas quand ton cerveau vit déjà trois semaines plus loin.</p>
          </div>
          <div class="h-px bg-[#1E3A8A]/15 my-12"></div>
          <p class="text-xl md:text-2xl leading-relaxed text-[#1E3A8A]/78 max-w-3xl mx-auto">
            Pour ne plus traiter ta surcharge intérieure comme un problème d'organisation. Et pour ne plus traiter ta quête de direction comme un problème de volonté.
          </p>
        </div>
      </section>

      <section class="px-6 py-28 relative overflow-hidden bg-[linear-gradient(rgba(247,244,238,0.72),rgba(247,244,238,0.72)),url('/images/max-fuchs-Nm6ojlDO-5c-unsplash.jpg')] bg-cover bg-center bg-no-repeat">
        <div class="relative z-10 max-w-6xl mx-auto grid lg:grid-cols-[0.85fr_1.15fr] gap-14 items-start">
          <div class="lg:sticky lg:top-28">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6">Projection</p>
            <h2 class="text-5xl md:text-7xl leading-tight font-normal italic text-[#CC3DAA]">Imagine.</h2>
          </div>
          <div class="space-y-4">
            {imagine.map((item) => (
              <div class="bg-[#FFFCF6]/88 backdrop-blur-[2px] border border-[#1E3A8A]/10 rounded-sm p-6">
                <p class="text-2xl leading-relaxed text-[#1E3A8A]/82">{item}</p>
              </div>
            ))}
            <div class="bg-[#CC3DAA] text-white rounded-sm p-8 md:p-10 mt-8">
              <p class="text-3xl md:text-5xl italic leading-tight">Et entendre à nouveau cette voix calme, simple, presque évidente :</p>
              <div class="mt-8 space-y-2 text-3xl md:text-4xl font-serif">
                <p>Là.</p>
                <p>C'est ça.</p>
                <p>C'est par là.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="px-6 py-28 bg-[#F7F4EE]">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.9fr_1.1fr] gap-14 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Après Zayin</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Tu ne repars pas avec une vie parfaite.</h2>
          </div>
          <div class="space-y-4">
            {apres.map((item) => (
              <div class="flex gap-4 bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-5">
                <span class="text-[#CC3DAA]">✧</span>
                <p class="text-xl leading-relaxed text-[#1E3A8A]/78">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="experience" class="px-6 py-28 bg-[#1E3A8A] text-[#F7F4EE] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-10"></div>
        <div class="relative z-10 max-w-6xl mx-auto grid lg:grid-cols-[0.9fr_1.1fr] gap-14 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#F1D9A7] mb-6">L'expérience Zayin</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Un espace où tout peut être posé sans être immédiatement résolu.</h2>
            <p class="text-xl md:text-2xl leading-relaxed text-white/82 mb-8">
              Je ne viens pas avec une méthode froide à appliquer. Je viens avec une capacité très particulière : faire dialoguer le concret et l'invisible.
            </p>
            <p class="text-xl md:text-2xl leading-relaxed text-white/82">
              On ne range pas seulement ta tête. On regarde pourquoi elle a dû porter autant.
            </p>
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            {experiences.map((item) => (
              <p class="bg-white/8 border border-white/10 rounded-sm p-5 text-xl leading-relaxed text-white/85">{item}</p>
            ))}
          </div>
        </div>
      </section>

      <section class="px-6 py-28 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6">Les 5 passages</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">Comment ça se passe.</h2>
          </div>
          <div class="space-y-5">
            {passages.map((passage) => (
              <article class="bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-7 md:p-8 grid lg:grid-cols-[0.55fr_1fr] gap-8">
                <h3 class="text-3xl font-normal text-[#CC3DAA]">{passage.title}</h3>
                <div class="space-y-5">
                  <p class="text-xl leading-relaxed text-[#1E3A8A]/80">{passage.text}</p>
                  <p class="text-xl leading-relaxed text-[#1E3A8A]/68">{passage.example}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="format" class="px-6 py-28">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[0.9fr_1.1fr] gap-14 items-start">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#CC3DAA] mb-6">Concrètement</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-8">Ce que comprend Zayin.</h2>
            <div class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-8 md:p-10 shadow-xl shadow-[#1E3A8A]/5">
              <p class="text-5xl font-serif text-[#CC3DAA] mb-2">500 CHF</p>
              <p class="ui-text text-xs tracking-[0.18em] uppercase text-[#1E3A8A]/65 mb-6">tarif de lancement · 5 places seulement</p>
              <p class="text-xl leading-relaxed text-[#1E3A8A]/75">
                Cette première cohorte est volontairement limitée à 5 femmes. Je veux accompagner chaque participante avec une présence fine et une vraie qualité d'ajustement. Le tarif de lancement est valable pour cette première ouverture avant évolution du programme.
              </p>
            </div>
            <a href={ctaHref} class="mt-8 inline-flex items-center justify-center gap-3 bg-[#CC3DAA] text-[#F7F4EE] ui-text text-xs tracking-[0.18em] uppercase px-9 py-4 rounded-sm hover:bg-[#D4845A] transition-colors">
              <iconify-icon icon="solar:letter-linear" width="15" height="15"></iconify-icon>
              Je veux retrouver de la place en moi
            </a>
          </div>

          <div class="space-y-4">
            {inclus.map((item) => (
              <div class="flex gap-4 bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-5">
                <span class="text-[#CC3DAA]">✓</span>
                <p class="text-xl leading-relaxed text-[#1E3A8A]/78">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="px-6 py-28 bg-[#FFFCF6] border-y border-[#1E3A8A]/10">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-14">
          <div>
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6">C'est pour toi si</p>
            <div class="space-y-4">
              {pourToi.map((item) => (
                <div class="flex gap-4 bg-[#F7F4EE] border border-[#1E3A8A]/10 rounded-sm p-5">
                  <span class="text-[#2AACCB]">✦</span>
                  <p class="text-xl leading-relaxed text-[#1E3A8A]/78">{item}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="bg-[#CC3DAA] text-white rounded-sm p-8 md:p-10 self-start">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-white/75 mb-6">Ce n'est pas pour toi si</p>
            <div class="space-y-5">
              {pasPourToi.map((item) => (
                <p class="text-xl leading-relaxed text-white/90">{item}</p>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="px-6 py-28 bg-[#F7F4EE]">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6">Elles en parlent</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal mb-6">Ce que mes clientes ont déjà vécu dans mes accompagnements.</h2>
            <p class="text-lg leading-relaxed text-[#1E3A8A]/60 max-w-2xl mx-auto">Extraits issus d'accompagnements précédents.</p>
          </div>

          <div class="grid md:grid-cols-2 gap-5">
            {temoignages.map((item) => (
              <blockquote class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-7 shadow-lg shadow-[#1E3A8A]/5">
                <span class="block text-[#CC3DAA] text-2xl mb-4">✦</span>
                <p class="text-2xl leading-relaxed italic text-[#1E3A8A]/82">“{item}”</p>
              </blockquote>
            ))}
          </div>
        </div>
      </section>

      <section class="px-6 py-28">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-14">
            <p class="ui-text text-xs tracking-[0.22em] uppercase text-[#2AACCB] mb-6">Questions fréquentes</p>
            <h2 class="text-4xl md:text-5xl leading-tight font-normal">Avant de rejoindre Zayin.</h2>
          </div>

          <div class="space-y-5">
            {faqs.map((faq) => (
              <details class="bg-[#FFFCF6] border border-[#1E3A8A]/10 rounded-sm p-6 group">
                <summary class="cursor-pointer text-xl font-serif text-[#1E3A8A] flex items-center justify-between gap-4">
                  {faq.q}
                  <span class="text-[#CC3DAA] group-open:rotate-45 transition-transform">+</span>
                </summary>
                <p class="text-xl leading-relaxed text-[#1E3A8A]/75 mt-5">{faq.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="py-28 px-6 bg-[#CC3DAA] relative overflow-hidden">
        <div class="absolute inset-0 bg-grain opacity-10"></div>
        <div class="relative z-10 max-w-3xl mx-auto text-center text-white">
          <p class="ui-text text-xs tracking-[0.22em] uppercase text-white/75 mb-6">5 places · offre de lancement</p>
          <h2 class="text-4xl md:text-6xl font-serif mb-8 leading-[1.1] tracking-tight">
            Si tu sens que ta tête est pleine, mais qu'une partie de toi sait qu'une autre suite est possible.
          </h2>
          <div class="space-y-4 text-xl md:text-2xl leading-relaxed text-white/85 mb-10">
            <p>Pas pour tout comprendre une fois de plus.</p>
            <p>Pas pour chercher une direction à tout prix.</p>
            <p>Pour faire de la place.</p>
            <p>Pour poser ce qui tourne. Alléger ce qui pèse. Entendre ce qui appelle.</p>
            <p>Et retrouver, enfin, assez de calme pour pouvoir t'entendre.</p>
          </div>
          <div class="mb-10 text-xl md:text-2xl leading-relaxed">
            <p><strong>Zayin</strong></p>
            <p>5 sessions individuelles</p>
            <p>Tarif de lancement : 500 CHF</p>
            <p>5 places disponibles</p>
          </div>
          <a href={ctaHref} class="inline-flex items-center gap-4 px-10 py-5 bg-[#1E3A8A] text-[#F7F4EE] font-semibold text-xs uppercase tracking-[0.2em] hover:bg-[#1E3A8A]/90 transition-all hover:-translate-y-1 shadow-2xl shadow-black/20 rounded-sm">
            <iconify-icon icon="solar:letter-linear" width="16" height="16"></iconify-icon>
            Oui. C'est le moment.
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
